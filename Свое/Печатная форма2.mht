<%
try {
	var oListElem = new Object();
	oListElem.Year = 0000;
	oListElem.sAssessmentAppraiseName = "ОШИБКА";
	oListElem.workflowStateName = "ОШИБКА";
	oListElem.personFullname = "ОШИБКА";
	oListElem.personPositionName = "ОШИБКА";
	oListElem.personPositionParentName = "ОШИБКА";
	oListElem.expertFullname = "ОШИБКА";
	oListElem.expertPositionName = "ОШИБКА";
	oListElem.expertDepartmentName = "ОШИБКА";
	oListElem.tasks = [];
	
	var docPA = tools.open_doc(curObjectID);
	var tePA = docPA.TopElem;
	var docAssessmentAppraise = tools.open_doc(tePA.assessment_appraise_id);
	if (docAssessmentAppraise != undefined)
	{
		oListElem.Year = Year(OptDate(docAssessmentAppraise.TopElem.start_date));
		oListElem.sAssessmentAppraiseName = String(docAssessmentAppraise.TopElem.name);
	}
	docAssessmentPlan = tools.open_doc(tePA.assessment_plan_id);
	if (docAssessmentPlan != undefined) {
		oListElem.workflowStateName = String(docAssessmentPlan.TopElem.workflow_state_name);
	}
	oListElem.personFullname = String(tePA.person_id.sd.fullname);
	var docCollaborator = tools.open_doc(tePA.person_id);
	if (docCollaborator != undefined) {
		oListElem.personPositionName = String(docCollaborator.TopElem.position_name);
		oListElem.personPositionParentName = String(docCollaborator.TopElem.position_parent_name);
	}
	oListElem.expertFullname = String(tePA.expert_person_id.sd.fullname);
	var docExpertCollaborator = tools.open_doc(tePA.expert_person_id);
	if (docExpertCollaborator != undefined) {
	    oListElem.expertPositionName = String(docExpertCollaborator.TopElem.position_name);
		oListElem.expertDepartmentName = String(docExpertCollaborator.TopElem.position_parent_name);
	}
	for (oTask in tePA.tasks) {
	  oTasks = new Object();
    docTask = tools.open_doc(oTask.task_id);
    if (docTask != undefined) {
      oTasks.taskName = String(docTask.TopElem.name);
      oTasks.weight = OptInt(oTask.weight);
      oTasks.plan = String(docTask.TopElem.plan);
      oTasks.fact = String(docTask.TopElem.fact);
      oListElem.tasks.push(oTasks);
    }
	var sFullComment = "";
	for (oComment in tePA.custom_comments) {
		docCommentCollaborator = tools.open_doc(oComment.person_id);
		if (docCommentCollaborator != undefined) {
			teCollaborator = docCommentCollaborator.TopElem;
			sFullname = String(teCollaborator.lastname) + " " + String(teCollaborator.firstname) + " " +  String(teCollaborator.middlename);
		}
		sComment = String(oComment.comment);
		sDate = StrDate(Date(oComment.comment_date), true, false);
		sFullComment += "(" + sDate + ") " + sFullname + ": " + sComment + "<br>";
	}
	}

}
catch (e) {
	alert(e);
}
%>

