<%

	try{


	var aCache = [];
	var aPerfomanceGroups = ArraySelectAll(XQuery("for $elem in groups where contains(code, 'performance') return $elem"));

	function fGetDocFromCache(iID, sCatalogName) {
		oDoc = undefined
		oCatalogCache = ArrayOptFindByKey(aCache, sCatalogName, 'catalog_name')
		if (oCatalogCache == undefined) {
			oCatalogCache = { "catalog_name": sCatalogName, "docs": [] }
			aCache.push(oCatalogCache)
		}
		oDocInCache = ArrayOptFindByKey(oCatalogCache.docs, OptInt(iID), 'id')
		if (oDocInCache == undefined) {
			oDoc = tools.open_doc(iID)
			oCatalogCache.docs.push({ "id": OptInt(iID), "doc": oDoc })
		}
		else {
			oDoc = oDocInCache.doc
		}
		return oDoc
	}

	function fGetManagerFromHyerarhy(iSubdivisionID, bGetNextManager) {
		iRes = undefined;
		if (IsEmptyValue(iSubdivisionID)) {
			return undefined;
		}
		docSubdivision = fGetDocFromCache(iSubdivisionID, 'subdivisions');
		if (docSubdivision != undefined) {
			oFirstManager = ArrayOptFirstElem(docSubdivision.TopElem.func_managers);
			if (oFirstManager != undefined) {
				if (bGetNextManager) {
					bGetNextManager = false;
					return fGetManagerFromHyerarhy(OptInt(docSubdivision.TopElem.parent_object_id), bGetNextManager);
				} else {
					return OptInt(oFirstManager.person_id);
				}
			} else {
				return fGetManagerFromHyerarhy(OptInt(docSubdivision.TopElem.parent_object_id), bGetNextManager);
			}
		}
		return iRes;
	}

	function fGetCollaboratorManager(iCollaboratorID, aGroups, bGetNextManager) {
		if (bGetNextManager == undefined) bGetNextManager = false;
		iManagerID = undefined;
		if (IsEmptyValue(iCollaboratorID)) {
			return undefined;
		}
		docCollaborator = tools.open_doc(iCollaboratorID);
		if (docCollaborator != undefined) {
			teCollaborator = docCollaborator.TopElem;
			oGroupFuncManager = undefined;
			//Ищем в группах
			for (oGroup in aGroups) {
				docGroup = tools.open_doc(oGroup.id);
				if (docGroup != undefined && ArrayOptFindByKey(docGroup.TopElem.collaborators, iCollaboratorID, "collaborator_id") != undefined) {
					oGroupFuncManager = ArrayOptFirstElem(docGroup.TopElem.func_managers);
				}
			}
			if (oGroupFuncManager != undefined) {
				iManagerID = OptInt(oGroupFuncManager.person_id);
				if (bGetNextManager) {
					bGetNextManager = false;
					iManagerID = undefined;
				}
			}
			if (iManagerID == undefined) {
				//Ищем в карточке сотрудника
				oCollaboratorFuncManager = ArrayOptFirstElem(teCollaborator.func_managers);
				if (oCollaboratorFuncManager != undefined) {
					iManagerID = OptInt(oCollaboratorFuncManager.person_id);
					if (bGetNextManager) {
						bGetNextManager = false;
						iManagerID = undefined;
					}
				}
				if (iManagerID == undefined) {
					//Ищем в подразделениях
					iManagerID = fGetManagerFromHyerarhy(OptInt(teCollaborator.position_parent_id), bGetNextManager);
				}
				//Ищем в организации
				if (iManagerID == undefined) {
					docOrg = tools.open_doc(teCollaborator.org_id);
					if (docOrg != undefined) {
						oOrgFuncManager = ArrayOptFirstElem(docOrg.TopElem.func_managers);
						if (oOrgFuncManager != undefined) {
							iManagerID = OptInt(oOrgFuncManager.person_id);
							if (bGetNextManager) {
								bGetNextManager = false;
								iManagerID = undefined;
							}
						}
					}
				}
			}
		}
		return iManagerID;
	}
		docPa = tools.open_doc(curObjectID);
		oMainInfo = new Object()
		oMainInfo.tasks = []
		oMainInfo.assessment_year = 2023
		oMainInfo.person_fullname = ''
		oMainInfo.position_name = ''
		oMainInfo.func_manager = ''
		oMainInfo.workflow_state_name = ''
		oMainInfo.tasks_weight = 0
		oMainInfo.tasks_comment_person = ''
		oMainInfo.tasks_rating_person = 0
		oMainInfo.tasks_comment_boss = ''
		oMainInfo.tasks_rating_boss = 0

		if(docPa!=undefined)
		{
			tePa = docPa.TopElem
			docAssessmentApprise = tools.open_doc(tePa.assessment_appraise_id)
			if(docAssessmentApprise!=undefined)
			{
				teAssessmentApprise = docAssessmentApprise.TopElem
				oMainInfo.assessment_name = String(teAssessmentApprise.name);
				if(OptDate(teAssessmentApprise.start_date)!=undefined)
					oMainInfo.assessment_year=Year(OptDate(teAssessmentApprise.start_date))
			}
			aPas = ArraySelectAll(tools.xquery("for $elem in pas where assessment_plan_id="+OptInt(tePa.assessment_plan_id)+"  return $elem"))
			oPaStaffrating = ArrayOptFindByKey(aPas,'staffrating','assessment_appraise_type')
			if(oPaStaffrating!=undefined)
			{
				docWorkflow = tools.open_doc(tePa.assessment_plan_id.OptForeignElem.workflow_id)
				if(docWorkflow!=undefined)
				{
					oState = docWorkflow.TopElem.states.GetOptChildByKey(tePa.assessment_plan_id.OptForeignElem.workflow_state)
					if(oState!=undefined)
						oMainInfo.workflow_state_name = String(oState.name)
					else
						oMainInfo.workflow_state_name = String(tePa.assessment_plan_id.OptForeignElem.workflow_state_name)
				}
				else
				{
					oMainInfo.workflow_state_name = String(tePa.assessment_plan_id.OptForeignElem.workflow_state_name)
				}
				docCollaborator = tools.open_doc(oPaStaffrating.person_id)
				if(docCollaborator!=undefined)
				{
					teCollaborator = docCollaborator.TopElem
					oMainInfo.person_fullname = String(teCollaborator.lastname+' '+teCollaborator.firstname+' '+teCollaborator.middlename)
					oMainInfo.position_name = String(teCollaborator.position_name)
					docFuncManager = tools.open_doc(fGetCollaboratorManager(teCollaborator.id, aPerfomanceGroups, false))
					if(docFuncManager!=undefined)
						oMainInfo.func_manager = String(docFuncManager.TopElem.lastname+' '+docFuncManager.TopElem.firstname+' '+docFuncManager.TopElem.middlename)
				}
				docPaStaffrating = tools.open_doc(oPaStaffrating.id)
				if(docPaStaffrating!=undefined)
				{
					i = 1
					oTaskCommentPerson = ArrayOptFind(docPaStaffrating.TopElem.custom_comments,"OptInt(This.person_id) == " + OptInt(docPaStaffrating.TopElem.person_id) + " && This.workflow_state == '3_person'")
					if(oTaskCommentPerson!=undefined)
					{
						oMainInfo.tasks_comment_person = String(oTaskCommentPerson.comment)
					}
					oTaskCommentBoss = ArrayOptFind(docPaStaffrating.TopElem.custom_comments,"OptInt(This.person_id) == " + OptInt(docPaStaffrating.TopElem.expert_person_id) + " && This.workflow_state == '3_boss'")
					if(oTaskCommentBoss!=undefined)
					{
						if(OptInt(docPaStaffrating.TopElem.expert_person_id) == curUser.id)
							oMainInfo.tasks_comment_boss = String(oTaskCommentBoss.comment)
					}
					for(oTaskInPa in ArraySort(docPaStaffrating.TopElem.tasks,"This.position",'+'))
					{
						oMainInfo.tasks_weight+=OptInt(oTaskInPa.weight,0)
						oTaskInfo = new Object()
						oTaskInfo.number = i;
						oTaskInfo.name = '';
						oTaskInfo.creteria = '';
						oTaskInfo.date_plan = '';
						oTaskInfo.weight = OptInt(oTaskInPa.weight,0);
						oTaskInfo.task_mrk_person = '';
						oTaskInfo.task_rating_person = '';
						oTaskInfo.task_mrk_boss = '';
						oTaskInfo.task_rating_boss = '';
						docTask =tools.open_doc(oTaskInPa.task_id)
						if(docTask!=undefined)
						{
							teTask = docTask.TopElem
							aTaskCustomFields = teTask.custom_fields

							oTaskInfo.name = String(teTask.name) + "\n" + String(teTask.desc);
							oTaskInfo.date_plan = OptDate(teTask.date_plan)!=undefined ? OptDate(teTask.date_plan) : ''
							oTaskInfo.creteria = aTaskCustomFields.GetOptChildByKey('creteria') != undefined ? String(aTaskCustomFields.GetOptChildByKey('creteria').value) : ''
							oTaskInfo.task_mrk_person = aTaskCustomFields.GetOptChildByKey('task_mrk_person') != undefined ? String(aTaskCustomFields.GetOptChildByKey('task_mrk_person').value) : ''
							if(OptInt(docPaStaffrating.TopElem.expert_person_id) == curUser.id)
								oTaskInfo.task_mrk_boss = aTaskCustomFields.GetOptChildByKey('task_mrk_boss') != undefined ? String(aTaskCustomFields.GetOptChildByKey('task_mrk_boss').value) : ''
							oTaskInfo.task_rating_person = aTaskCustomFields.GetOptChildByKey('rating_person') != undefined ? String(aTaskCustomFields.GetOptChildByKey('rating_person').value) : ''
							if(OptInt(docPaStaffrating.TopElem.expert_person_id) == curUser.id)
								oTaskInfo.task_rating_boss = aTaskCustomFields.GetOptChildByKey('rating_boss') != undefined ? String(aTaskCustomFields.GetOptChildByKey('rating_boss').value) : ''
							if(OptInt(oTaskInPa.weight) != undefined)
							{
								if(OptInt(oTaskInfo.task_rating_person) != undefined)
								{
									oMainInfo.tasks_rating_person += (OptReal(oTaskInfo.task_rating_person)*OptReal(oTaskInPa.weight))/(100.0)
								}
								if(OptInt(oTaskInfo.task_rating_boss) != undefined)
								{
									if(OptInt(docPaStaffrating.TopElem.expert_person_id) == curUser.id)
										oMainInfo.tasks_rating_boss += (OptReal(oTaskInfo.task_rating_boss)*OptReal(oTaskInPa.weight))/(100.0)
								}
							}
						}
						oMainInfo.tasks.push(oTaskInfo)
						i++;
					}

				}
			}
		}
	}
	catch(er)
	{
		alert(er)
	}
