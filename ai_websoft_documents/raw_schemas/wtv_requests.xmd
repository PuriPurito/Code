<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="request">

<USE FORM="//wtv/wtv_general.xmd"/>

<requests>
	<request MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=5uitfcok9y"/>
		<type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" INDEXED="1" TITLE="const=s5j056rnbt"/>
		<request_type_id TYPE="integer" FOREIGN-ARRAY="request_types" INDEXED="1" TITLE="const=5rrpn7n7gm"/>

		<status_id TYPE="string" NOT-NULL="1" DEFAULT="active" FOREIGN-ARRAY="common.request_status_types" TITLE="const=vppb_state"/>

		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=lhbyv18qkm"/>
		<person_org_name TYPE="string" INDEXED="1" TITLE="const=c_org"/>
		<person_subdivision_name TYPE="string" TITLE="Название подразделения сотрудника"/>

		<is_group TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=o9gfk5lenw"/>
		<person_num TYPE="integer" TITLE="const=vocwacfpan"/>

		<object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( type + 's' )" INDEXED="1" TITLE="const=c_object"/>
		<object_name TYPE="string" INDEXED="1" TITLE="const=c_object_name"/>

		<budget_period_id TYPE="integer" FOREIGN-ARRAY="budget_periods" TITLE="const=c_budget_period"/>

		<workflow_id TYPE="integer" FOREIGN-ARRAY="workflows" TITLE="const=vw_title"/>
		<workflow_state TYPE="string" INDEXED="1" TITLE="const=c136i4h31p"/>
		<workflow_state_name TYPE="string" INDEXED="1" TITLE="const=ld9m4gsmfn"/>

		<create_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>
		<close_date TYPE="date" INDEXED="1" TITLE="const=c_close_date"/>

		<tag_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="tags" INDEXED="1" TITLE="const=pe82k7en9s"/>

		<workflow_person_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<workflow_matching_type TYPE="string" TITLE="const=c136i4h31q"/>
		<workflow_main_person_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>

		<knowledge_parts TYPE="string" TITLE="const=vkpb_knowledge_parts_title"/>
		<tags TYPE="string" TITLE="##'ID тегов'##"/>
		<experts TYPE="string" TITLE="const=vkpb_experts"/>

		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem, true );

				for ( fldTagElem in SrcDoc.TopElem.tags )
					tag_id.Add().Value = fldTagElem.PrimaryKey;

				for ( fldWorkflowMatchingElem in SrcDoc.TopElem.workflow_matchings )
				{
					workflow_person_id.Add().Value = fldWorkflowMatchingElem.person_id;
					if( fldWorkflowMatchingElem.is_main )
						workflow_main_person_id.Add().Value = fldWorkflowMatchingElem.person_id;
				}

				knowledge_parts = ArrayMerge(SrcDoc.TopElem.knowledge_parts, 'This.PrimaryKey', ';');
				tags = ArrayMerge(SrcDoc.TopElem.tags, 'This.PrimaryKey', ';');
				experts = ArrayMerge(SrcDoc.TopElem.experts, 'This.PrimaryKey', ';');

				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</request>
</requests>

</SPXML-FORM>