<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<auth_type>
	<INHERIT TYPE="object_code_name_base"/>

	<INHERIT TYPE="exec_code_base"/>

	<INHERIT TYPE="web_variables_base"/>

	<is_std TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base"/>
</auth_type>


<DocDesc PROPERTY="1" EXPR="
		'Тип авторизации' + ': ' + auth_type.name
"/>

</SPXML-FORM>