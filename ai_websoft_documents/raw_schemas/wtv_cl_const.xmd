<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<cl_const>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	
	<localizations>
		<localization MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="integer" FOREIGN-ARRAY="cl_localizations"/>
			<text TYPE="string"/>
			<imprint TYPE="string"/>
		</localization>
	</localizations>
	
	<object_types>
		<object_type MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" FOREIGN-ARRAY="common.exchange_object_types"/>
			<objects>
				<object MULTIPLE="1" PRIMARY-KEY="id">
					<id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( Child(0).Parent.Parent.Parent.id + 's' )"/>
				</object>
			</objects>
		</object_type>
	</object_types>
	
	<flags>
		<flag MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string"/>
		</flag>
	</flags>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	
	<set_value PROPERTY="1" PARAM="LOC_ID" PARAM="VALUE" EXPR="
		var fldLoc = localizations.ObtainChildByKey(LOC_ID);
		
		if (VALUE == null || VALUE == undefined || (VALUE = Trim(VALUE)) == '')
		{
			fldLoc.text.Clear();
			fldLoc.imprint.Clear();
		}	
		else
		{
			fldLoc.text = VALUE;
			fldLoc.imprint = tools_cl.imprint(VALUE);
		}
		return true;
	"/>
	
</cl_const>


<DocDesc PROPERTY="1" EXPR="
		'Константа' + ' - ' + cl_const.code;
"/>

</SPXML-FORM>