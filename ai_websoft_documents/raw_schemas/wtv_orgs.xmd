<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="org">

<orgs>
	<org MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>

		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=2c7tfen6wm"/>
		<disp_name TYPE="string" INDEXED="1" TITLE="const=org_disp_name"/>

		<account_id TYPE="integer" FOREIGN-ARRAY="accounts" INDEXED="1" TITLE="const=dwym57yfvr"/>
		<kpi_profile_id TYPE="integer" FOREIGN-ARRAY="kpi_profiles" TITLE="const=ass_kpi_profile"/>
		<kpi_profiles_id TYPE="integer" FOREIGN-ARRAY="kpi_profiles" TITLE="const=ass_kpi_profiles" MULTIPLE="1"/>
		<bonus_profile_id TYPE="integer" FOREIGN-ARRAY="bonus_profiles" TITLE="const=629saq8h6f"/>

		<place_id TYPE="integer" FOREIGN-ARRAY="places" TITLE="const=c_place"/>
		<region_id TYPE="integer" FOREIGN-ARRAY="regions" TITLE="const=vrb_region"/>

		<tags TYPE="string" TITLE="##'ID тегов'##"/>
		<tag_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="tags" INDEXED="1" TITLE="const=pe82k7en9s"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" TITLE="const=4egocnh7uc"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				tags = ArrayMerge( SrcDoc.TopElem.tags, 'This.PrimaryKey', ';' );
				for ( fldTagElem in SrcDoc.TopElem.tags )
					tag_id.Add().Value = fldTagElem.PrimaryKey;
					
				for ( fldRecipientElem in SrcDoc.TopElem.kpi_profiles )
					kpi_profiles_id.ObtainByValue( fldRecipientElem.id );
		"/>
	</org>
</orgs>

</SPXML-FORM>