<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<section_instruction>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	<desc TYPE="string" TITLE="const=c_desc"/>	
	<parent_object_id TYPE="integer" FOREIGN-ARRAY="section_instructions" TITLE="const=mjmulmmhl9"/>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
		
	<view TEMP="1">
		<selector TYPE="string" NOT-NULL="1" DEFAULT="common" TEMP="1"/>	
	</view>
</section_instruction>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('c_section') + ': ' + section_instruction.name
"/>

</SPXML-FORM>