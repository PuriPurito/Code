<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="forum">

<USE FORM="//wtv/wtv_general.xmd"/>

<forums>
	<forum MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		
		<resource_id TYPE="integer" FOREIGN-ARRAY="resources" TITLE="const=c_resource"/>

		<permit_subscription TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=igih9gq2ts"/>

		<closed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=9twlu70n3d"/>
		<allow_anonymous_message TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=q3wfufdw8l"/>
		<allow_create_closed_theme TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=xt16i1oi6f"/>
		<allow_user_delete TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=vfeb_can_del_mess"/>
		<disp_user_status TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=la9hb7w3sn"/>

		<need_moder_approval TYPE="bool" INDEXED="1" NOT-NULL="1" EFAULT="false" TITLE="const=odb7pejwm8"/>

		<course_id TYPE="integer" FOREIGN-ARRAY="courses" INDEXED="1" TITLE="const=c_course"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" TITLE="const=lhbyv18qkm"/>

		<knowledge_parts TYPE="string" TITLE="const=vkpb_knowledge_parts_title"/>
		<tags TYPE="string" TITLE="##'ID тегов'##"/>
		<experts TYPE="string" TITLE="const=vkpb_experts"/>

		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				knowledge_parts = ArrayMerge(SrcDoc.TopElem.knowledge_parts, 'This.PrimaryKey', ';');
				tags = ArrayMerge(SrcDoc.TopElem.tags, 'This.PrimaryKey', ';');
				experts = ArrayMerge(SrcDoc.TopElem.experts, 'This.PrimaryKey', ';');

				person_fullname = SrcDoc.TopElem.person_id.sd.fullname;
		"/>
	</forum>
</forums>

</SPXML-FORM>