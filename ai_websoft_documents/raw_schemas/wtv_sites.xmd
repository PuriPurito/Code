<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="site">

<sites>
	<site MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>

		<web_design_id TYPE="integer" FOREIGN-ARRAY="web_designs" TITLE="const=k26170zag7"/>
		<lng_id TYPE="string" FOREIGN-ARRAY="lngs" TITLE="const=nvmn9k2ntx"/>

		<object_id TYPE="integer" INDEXED="1" TITLE="const=c_object"/>

		<is_std TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="const=6xdvzwb05x"/>
		<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<owner_object TYPE="integer" MULTIPLE="1" TITLE="const=dank_owners"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				for ( fldOwnerObjectElem in SrcDoc.TopElem.owner_objects )
					owner_object.Add().Value = fldOwnerObjectElem.PrimaryKey;
		"/>
	</site>
</sites>

</SPXML-FORM>