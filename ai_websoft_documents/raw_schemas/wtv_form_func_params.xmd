		<lector_id TYPE="integer" FOREIGN-ARRAY="lectors"/>

		<parent_object_id TYPE="integer" FOREIGN-ARRAY="subdivisions"/>
		<org_id TYPE="integer" FOREIGN-ARRAY="orgs"/>

