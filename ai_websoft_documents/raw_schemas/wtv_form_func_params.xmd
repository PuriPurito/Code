	<event_person_report>
		<event_id TYPE="integer" FOREIGN-ARRAY="events"/>
		<event_name TYPE="string"/>

		<hier_sub_select TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
		<disp_person_list_staff TYPE="bool" NOT-NULL="1" DEFAULT="false"/>

