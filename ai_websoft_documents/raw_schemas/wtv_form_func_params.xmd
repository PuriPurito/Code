		<education_program_id TYPE="integer" FOREIGN-ARRAY="education_program"/>
		<graph_type TYPE="string" NOT-NULL="1" DEFAULT="Line"/>
		<show_alert TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<is_web_client TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<columns>
			<column MULTIPLE="1" PRIMARY-KEY="name">
				<name TYPE="string"/>
				<title TYPE="string"/>
				<const TYPE="string"/>
			</column>
		</columns>
	</test_dynamics_report>
	
	<learning_statistics_report>
		<block_name TYPE="string"/>
		<course_id TYPE="integer" FOREIGN-ARRAY="courses"/>
		<assessment_id TYPE="integer" FOREIGN-ARRAY="assessments"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators"/>
		<group_id TYPE="integer" FOREIGN-ARRAY="groups"/>
		<parent_object_id TYPE="integer" FOREIGN-ARRAY="subdivisions"/>
		<org_id TYPE="integer" FOREIGN-ARRAY="orgs"/>
		<hier_sub_select TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
		<start_date TYPE="date"/>
		<finish_date TYPE="date"/>
		<disp_learning_prog TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<education_program_id TYPE="integer" FOREIGN-ARRAY="education_program"/>
		<show_alert TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<is_web_client TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<columns>
			<column MULTIPLE="1" PRIMARY-KEY="name">
				<name TYPE="string"/>
				<const TYPE="string"/>
			</column>
		</columns>
	</learning_statistics_report>
	
	<course_integral_efficiency_report>
		<courses>
			<course PRIMARY-KEY="id" MULTIPLE="1">
				<id TYPE="integer" FOREIGN-ARRAY="courses"/>
			</course>
		</courses>
		<response_type_id TYPE="integer" FOREIGN-ARRAY="response_types"/>
		<selected_fields>
			<selected_field MULTIPLE="1" PRIMARY-KEY="id">
				<id TYPE="string"/>
				<name TYPE="string"/>
				<type TYPE="string" FOREIGN-ARRAY="common.template_field_types" DEFAULT="string"/>
			</selected_field>
		</selected_fields>
		
		<formula_column_value TYPE="string"/>
		<formula_column_title TYPE="string"/>
		
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators"/>
		<group_id TYPE="integer" FOREIGN-ARRAY="groups"/>
		<parent_object_id TYPE="integer" FOREIGN-ARRAY="subdivisions"/>
		<org_id TYPE="integer" FOREIGN-ARRAY="orgs"/>
		<hier_sub_select TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
		<start_date TYPE="date"/>
		<finish_date TYPE="date"/>
		<disp_learning_prog TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<education_program_id TYPE="integer" FOREIGN-ARRAY="education_program"/>
		<show_alert TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<graph_type TYPE="string" NOT-NULL="1" DEFAULT="Column"/>
		<is_web_client TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<columns>
			<column MULTIPLE="1" PRIMARY-KEY="name">
				<name TYPE="string"/>
				<const TYPE="string"/>
			</column>
		</columns>
	</course_integral_efficiency_report>
	
	<questions_analytics_report>
		<assessments>
			<assessment PRIMARY-KEY="id" MULTIPLE="1">
				<id TYPE="integer" FOREIGN-ARRAY="assessments"/>
			</assessment>
		</assessments>
		
		<selected_items>
			<selected_item PRIMARY-KEY="id" MULTIPLE="1">
				<id TYPE="integer" FOREIGN-ARRAY="items"/>
			</selected_item>
		</selected_items>

		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators"/>
		<group_id TYPE="integer" FOREIGN-ARRAY="groups"/>
		<parent_object_id TYPE="integer" FOREIGN-ARRAY="subdivisions"/>
		<hier_sub_select TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
		<hier_role_select TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
		<org_id TYPE="integer" FOREIGN-ARRAY="orgs"/>
		
		<percent_difficult TYPE="real" NOT-NULL="1" DEFAULT="30"/>
		<percent_simple TYPE="real" NOT-NULL="1" DEFAULT="30"/>
		<elapsed_percent TYPE="real" NOT-NULL="1" DEFAULT="30"/>
		<correlation_coefficient TYPE="real" NOT-NULL="1" DEFAULT="0"/>
		<variance TYPE="real" NOT-NULL="1" DEFAULT="0"/>
		<show_alert TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<is_web_client TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		
		<start_date TYPE="date"/>
		<finish_date TYPE="date"/>
	
		<sort_type_id TYPE="string" NOT-NULL="1" DEFAULT="text"/>
		
		<columns>
			<column MULTIPLE="1" PRIMARY-KEY="name">
				<name TYPE="string"/>
				<const TYPE="string"/>
				<sort_field TYPE="string" DEFAULT="t"/>
			</column>
		</columns>
				
	</questions_analytics_report>
	
	<statistic_report>
		<statistic_recs>
			<statistic_rec MULTIPLE="1" PRIMARY-KEY="statistic_rec_id">
				<statistic_rec_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( 'statistic_recs' )"/>
			</statistic_rec>
		</statistic_recs>
		
		<period_type TYPE="string" FOREIGN-ARRAY="common.perioditys"/>
		<start_date TYPE="date"/>
		<finish_date TYPE="date"/>
		<show_alert TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<graph_type TYPE="string" NOT-NULL="1" DEFAULT="Line"/>
		<is_web_client TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<columns>
			<column MULTIPLE="1" PRIMARY-KEY="name">
				<name TYPE="string"/>
				<const TYPE="string"/>
			</column>
		</columns>
	</statistic_report>
	
	<course_comment_report>
		<course_id TYPE="integer" FOREIGN-ARRAY="courses"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators"/>
