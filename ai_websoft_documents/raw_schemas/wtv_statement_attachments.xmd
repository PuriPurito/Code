<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="statement_attachment">

<USE FORM="//wtv/wtv_general.xmd"/>

<statement_attachments>
	<statement_attachment MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" TITLE="ID"/>
		<path TYPE="string" TITLE="##'Путь'##"/>
		<usage_type TYPE="string" TITLE="##'ID использования'##"/>
		<content_type TYPE="string" TITLE="##'Тип содержимого'##"/>
		<length TYPE="string" TITLE="##'Длина данных'##"/>
		<file_hash TYPE="string" TITLE="##'Хэш данных'##"/>
		<file_url TYPE="string" TITLE="##'Адрес данных'##"/>
		
		<statement_id TYPE="integer" FOREIGN-ARRAY="statements" INDEXED="1" TITLE="##'Сообщение учебной активности'##"/>
		
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
			id.Parent.AssignElem( SrcDoc.TopElem );
			modification_date = SrcDoc.TopElem.doc_info.modification.date;
			app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</statement_attachment>
</statement_attachments>

</SPXML-FORM>