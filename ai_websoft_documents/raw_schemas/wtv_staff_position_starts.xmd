<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="staff_position_start">

<USE FORM="//wtv/ms_general.xmd"/>

<staff_position_starts>
	<staff_position_start MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>

		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" TITLE="const=lhbyv18qkm"/>

		<subdivision_id TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE="const=c_subd"/>
		<subdivision_name TYPE="string" TITLE="const=uf_depart_name"/>

		<position_id TYPE="integer" FOREIGN-ARRAY="positions" TITLE="const=c_position"/>
		<position_name TYPE="string" TITLE="const=g89skt4yui"/>

		<position_date TYPE="date" TITLE="const=datavstupleniya"/>

		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</staff_position_start>
</staff_position_starts>

</SPXML-FORM>