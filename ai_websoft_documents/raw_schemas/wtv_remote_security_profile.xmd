<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<remote_security_profile>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<source TYPE="integer" NOT-NULL="1" DEFAULT="0"/>

	<method_access_list>
		<method_access MULTIPLE="1" PRIMARY-KEY="access_block_id">
			<access_block_id TYPE="string" FOREIGN-ARRAY="access_blocks"/>
			<library_profile TYPE="string"/>
		</method_access>
	</method_access_list>

	<lib_access_list>
		<lib_access MULTIPLE="1" PRIMARY-KEY="library_id">
			<library_id TYPE="integer" FOREIGN-ARRAY="code_librarys"/>
			<library_code TYPE="string"/>
			<filter TYPE="string"/>
		</lib_access>
	</lib_access_list>


	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
		
	<view TEMP="1">
		<selector TYPE="string" NOT-NULL="1" DEFAULT="common" TEMP="1"/>	
	</view>
</remote_security_profile>


<DocDesc PROPERTY="1" EXPR="
		'Профиль безопасности' + ': ' + remote_security_profile.name
"/>

</SPXML-FORM>