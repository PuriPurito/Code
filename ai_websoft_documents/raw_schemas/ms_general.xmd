<change_hash_base SAMPLE="1">
	<current_hash PROPERTY="1" EXPR="
		var TopElem = Child(0).Parent;
		var sHashedText = tools.get_hashable_object_text(TopElem);
		return (IsEmptyValue(sHashedText) ? null : Md5Hex(sHashedText));
	"/>
	<processed_embedding_hash TYPE="string" />
</change_hash_base>

