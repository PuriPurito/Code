<ms_week_schedule_base>
	<type TYPE="string" NOT-NULL="1" DEFAULT="always"/><!-- always, weekly -->
	<week_days TITLE="const=svdzjn4sew">
		<week_day MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" FOREIGN-ARRAY="common.week_day_types"/>
			<start_time TYPE="string" TITLE="const=c_start_time"/>
			<finish_time TYPE="string" TITLE="const=rxvbavpep1"/>
		</week_day>
	</week_days>
	<check_week_schedule PROPERTY="1" PARAM="curUserID" PARAM="curUser" PARAM="Session" EXPR="
			TopElem = Child(0).Parent;
			if ( TopElem.type != 'always' )
			{
				try
				{
					curUserID = Int( curUserID )
					try
					{
						curUser.Name
					}
					catch(exex)
					{
						curUser = OpenDoc( UrlFromDocID( curUserID ) ).TopElem;
					}
				}
				catch( ex )
				{
					curUserID = null;
				}
				try
				{
					Session.GetOptChildByKey( 'user_timezone_id', '' )
				}
				catch( ex )
				{
					Session = null;
				}
				if( curUserID != null &amp;&amp; global_settings.settings.timezone_id.HasValue )
				{
					catDefaultTimezone = global_settings.settings.timezone_id.ForeignElem;
					if( Session != null &amp;&amp; Session.GetOptChildByKey( 'user_timezone_id', '' ) != '' )
					{
						sTimeZoneId = Session.GetOptChildByKey( 'user_timezone_id', '' );
						catUserTimezone = common.timezones.GetOptChildByKey( sTimeZoneId );
					}
					else
					{
						catUserTimezone = tools_web.get_timezone( curUserID, curUser );
						catUserTimezone = catUserTimezone.HasValue ? catUserTimezone.ForeignElem : null;
						if( Session != null &amp;&amp; catUserTimezone != null )
						{
							Session.SetProperty( 'user_timezone_id', catUserTimezone.id.Value )
						}
					}
					if( catUserTimezone != null )
					{
						tmpCurDate = tools_web.get_timezone_date( CurDate, catDefaultTimezone, catUserTimezone )
					}
					else
					{
						tmpCurDate = CurDate;
					}
				}
				else
				{
					tmpCurDate = CurDate;
				}

				scheduleWeekDay = ArrayOptFind( TopElem.week_days, 'PrimaryKey.ForeignElem.index==' + WeekDay( tmpCurDate ) );
				if ( scheduleWeekDay == undefined )
					return false;
				dateNewTime = DateNewTime( tmpCurDate );
				if ( Date( dateNewTime + ' ' + scheduleWeekDay.start_time ) &gt; tmpCurDate || Date( dateNewTime + ' ' + scheduleWeekDay.finish_time ) &lt; tmpCurDate )
					return false;
			}
			return true;
		"/>
</ms_week_schedule_base>




