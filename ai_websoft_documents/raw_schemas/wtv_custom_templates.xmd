<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>


<custom_fields SAMPLE="1">
	<fields>
		<field MULTIPLE="1" PRIMARY-KEY="name">
			<name TYPE="string" TITLE="const=c_name"/>
			<type TYPE="string" FOREIGN-ARRAY="common.template_field_types" DEFAULT="string"/>
			<title TYPE="string"/>

			<catalog TYPE="string" FOREIGN-ARRAY="common.exchange_object_types"/>
			<xquery_qual TYPE="string"/>

			<entries TITLE="const=ibc3nu8xkw">
				<entry MULTIPLE="1">
					<value TYPE="string" TITLE="const=c_value"/>
				</entry>
			</entries>

			<sheet_id TYPE="string" FOREIGN-ARRAY="Parent.Parent.sheets"/>

			<disp_web TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
			<is_required TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
			<condition_eval TYPE="string" TITLE="const=uslovievernosti"/>
			<comment TYPE="string" TITLE="const=c_comment"/>
			
			<default_value_eval TYPE="string" TITLE="##'Формула дефолтного значения поля (переменная GEnv = { curUser, curObject })'##"/>

			<width TYPE="string" TITLE="const=l2wp2bi6xp"/>
			<height TYPE="string" TITLE="const=veb_mat_h"/>
			<class TYPE="string" TITLE="const=vizualnyyklass"/>
			<max_chars TYPE="string" TITLE="const=kolichestvosimv"/>

			<view>
				<INHERIT TYPE="view_conditions_base"/>
			</view>
		</field>
	</fields>
</custom_fields>


<custom_template_base SAMPLE="1">
	<sheets>
		<sheet MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" EXPR-INIT="tools.random_string( 4 )"/>
			<title TYPE="string"/>
			<INHERIT TYPE="admin_access_base"/>
		</sheet>
	</sheets>

	<INHERIT TYPE="custom_fields"/>

	<unique_field_name PROPERTY="1" EXPR="
			for ( i = 1; ; i++ )
			{
				fieldName = 'f_' + tools.random_string( 4 );

				if ( ! fields.ChildByKeyExists( fieldName ) )
					return fieldName;
			}
	"/>
</custom_template_base>



