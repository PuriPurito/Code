<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<library_material_source_type>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	
	<is_active TYPE="bool" NOT-NULL="1" DEFAULT="true" TITLE="const=zeta4i89wg"/>
	
	<type TYPE="string" FOREIGN-ARRAY="common.resource_types" TITLE="const=x91r5l546f"/>
	
	<library_player_id TYPE="integer" FOREIGN-ARRAY="library_players" TITLE="Проигрыватель файлов"/>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	
	<filenamemask TYPE="string" TITLE="const=filtrimenfaylo"/>
	
	<script TYPE="string"/>
	<url TYPE="string" TITLE="const=gwdslrn9x8"/>
	
	<INHERIT TYPE="web_variables_base"/>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	
	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	
	<evaluate PROPERTY="1" PARAM="sFileUrlPARAM" PARAM="oOptionalPARAM" EXPR="
			var FILEURL = sFileUrlPARAM;
			var RESULT = null;
			var TopElem = Child(0).Parent;
			
			var PARAMETERS;
			try
			{
				oOptionalPARAM.GetOptProperty('a');
				PARAMETERS = oOptionalPARAM;
			}
			catch(_X_)
			{
				PARAMETERS = new Object;
			}
			
			
			var s_anti_str = tools.wvars_to_script(TopElem.wvars, false);
			try
			{
				if (TopElem.url.HasValue)
				{
					var sRenderUrl = TopElem.url.Value;
					if (!IsAbsoluteUrlStr(sRenderUrl))
						sRenderUrl = UrlAppendPath('x-local://wt/web', sRenderUrl);
					RESULT = eval(s_anti_str + LoadUrlText(sRenderUrl));
				}
				else
					RESULT = eval(s_anti_str + TopElem.script.Value);
			}
			catch(_X_)
			{
				if (!IsCancelError(_X_))
				{
					alert('Error evaluating library material source type ' + TopElem.name.XQueryLiteral + ' of file ' + XQueryLiteral(FILEURL) +  '\n' + _X_);
				}
			}
			
			return RESULT;
	"/>
	
	
	
	<view TEMP="1">
		<selector TYPE="string" NOT-NULL="1" DEFAULT="common" TEMP="1"/>	
	</view>
</library_material_source_type>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('tipvhodnyhdann') + ': ' + library_material_source_type.name
"/>

</SPXML-FORM>