<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="career_plan">

<USE FORM="//wtv/wtv_general.xmd"/>

<career_plans>
	<career_plan MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<resource_id TYPE="integer" FOREIGN-ARRAY="resources" TITLE="const=c_resource"/>
		<start_date TYPE="date" TITLE="const=qpltbj1sg1"/>
		<status TYPE="string" NOT-NULL="1" DEFAULT="plan" FOREIGN-ARRAY="common.career_reserve_status_types"/>	
		<budget_period_id TYPE="integer" FOREIGN-ARRAY="budget_periods"/>
		<typical_career_plan_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="career_plans" TITLE="##'Типовой карьерный план'##"/>
		<object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" DEFAULT="collaborator"/><!-- collaborator, position_common, position_family, group -->
		<object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( object_type + 's' )"/>
		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" TITLE="const=4egocnh7uc"/>
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>
		<OnBuild PROPERTY="1" EXPR="
			id.Parent.AssignElem( SrcDoc.TopElem );
			modification_date = SrcDoc.TopElem.doc_info.modification.date;
			app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</career_plan>
</career_plans>

</SPXML-FORM>