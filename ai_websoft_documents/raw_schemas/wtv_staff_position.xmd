<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<staff_position>
	<id TYPE="integer" INDEXED="1" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<status TYPE="string" FOREIGN-ARRAY="common.project_status_types" TITLE="const=c_status"/>
	<start_date TYPE="date" TITLE="Дата утверждения"/>
	<finish_date TYPE="date" TITLE="const=c_close_date"/>

	<org_name TYPE="string" TITLE="const=c_org"/>
	<org_id TYPE="integer" FOREIGN-ARRAY="orgs" TITLE="const=c_org"/>
	<subdivision_id TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE="const=c_subd"/>
	<subdivision_name TYPE="string" TITLE="const=uf_depart_name"/>
	<position_common_id TYPE="integer" FOREIGN-ARRAY="position_commons" TITLE="const=c_position_common"/>
	<profession_id TYPE="integer" FOREIGN-ARRAY="professions" TITLE="Профессия"/>
	<profession_category_id TYPE="integer" FOREIGN-ARRAY="profession_categorys" TITLE="Разряд профессии"/>
	<bonus_profile_id TYPE="integer" FOREIGN-ARRAY="bonus_profiles" TITLE="const=629saq8h6f"/>

	<staff_num TYPE="real" TITLE="Количество штатных единиц"/>
	
	<kpi_profile_id TYPE="integer" FOREIGN-ARRAY="kpi_profiles" TITLE="const=ass_kpi_profile"/>
	<kpi_profiles>
		<kpi_profile MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="integer" FOREIGN-ARRAY="kpi_profiles" TITLE="const=ass_kpi_profile"/>
			<period_type_id TYPE="string" FOREIGN-ARRAY="common.perioditys"/>
			<obligatory TYPE="bool" TITLE="const=7df3q17dhk" NOT-NULL="1" DEFAULT="false"/>
		</kpi_profile>
	</kpi_profiles>
	<knowledge_profile_id TYPE="integer" FOREIGN-ARRAY="knowledge_profiles" TITLE="const=syqx4l4uo1"/>
	
	<competence_profile_id TYPE="integer" FOREIGN-ARRAY="competence_profiles" TITLE="const=ass_competence_profile"/>
	<competence_profiles TITLE="const=ass_competence_profiles">
		<competence_profile MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="integer" FOREIGN-ARRAY="competence_profiles" TITLE="const=ass_competence_profile"/>
		</competence_profile>
	</competence_profiles>

	<INHERIT TYPE="requirements_base"/>
	<INHERIT TYPE="file_list_base"/>
	
	<INHERIT TYPE="knowledge_parts_base"/>

	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base"/>
	<INHERIT TYPE="admin_access_base"/>

	<INHERIT TYPE="custom_elems_base"/>

</staff_position>

<DocDesc PROPERTY="1" EXPR="
		'Позиция штатного расписания' + ': ' + staff_position.name
"/>

</SPXML-FORM>