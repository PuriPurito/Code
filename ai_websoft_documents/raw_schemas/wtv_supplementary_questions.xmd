<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="supplementary_question">

<USE FORM="//wtv/wtv_general.xmd"/>

<supplementary_questions>
	<supplementary_question MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<section TYPE="string" TITLE="const=c_section"/>
		<type TYPE="string" DEFAULT="1" NOT-NULL="1" TITLE="const=c_type" FOREIGN-ARRAY="common.supplementary_question_types"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>
		
		<INHERIT TYPE="admin_access_base"/>
		
		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</supplementary_question>
</supplementary_questions>

</SPXML-FORM>