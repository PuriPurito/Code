<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM x-ft-index="0" x-xml-index="0">

<USE FORM="//wtv/ms_general.xmd"/>

<library_material_viewing>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<material_id TYPE="integer" FOREIGN-ARRAY="library_materials" TITLE="const=materialbiblio"/>
	<material_name TYPE="string" TITLE="const=nazvaniemateri"/>	
	<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
<!--	<person_fullname TYPE="string" INDEXED="1" TITLE="const=lhbyv18qkm"/>-->
	<INHERIT TYPE="person_filling_base"/>
	
	<duration TYPE="integer" TITLE="const=prodolzhitelnos_4" DEFAULT="0"/>	
	
	<location TYPE="integer" DEFAULT="0"/>
	
	<pages>
		<page MULTIPLE="1" PRIMARY-KEY="page_id">
			<page_id TYPE="string"/>
			<viewed TYPE="bool" DEFAULT="false"/>
		</page>
	</pages>
	
	<state_id TYPE="string" FOREIGN-ARRAY="common.viewing_states" TITLE="const=vppb_state" DEFAULT="plan"/>
	<current_page_id TYPE="string" TITLE="const=tekushayastranica"/>
	<education_plan_id TYPE="integer" FOREIGN-ARRAY="education_plans" TITLE="const=je8frfv2u9"/>
	<INHERIT TYPE="custom_elems_base"/>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	
	<INHERIT TYPE="admin_access_base"/>
	<start_viewing_date TYPE="date" TITLE="const=nachaloprosmotra"/>
	<last_viewing_date TYPE="date" TITLE="const=vremyaposledneg"/>	
	<finish_viewing_date TYPE="date" TITLE="const=vremyapolnogopr"/>
</library_material_viewing>
<!--
<DocDesc PROPERTY="1" EXPR="
		curCourse = learning.course_id.OptForeignElem;
		return ms_tools.get_const('y4rl42np7n') + ': ' + learning.start_usage_date + ' ' + learning.person_fullname + ' ' + ( curCourse == undefined ? 'course ID ' + learning.course_id : curCourse.name );
"/>
-->
</SPXML-FORM>