<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>
<USE FORM="//wtv/ms_general.xmd"/>

<webinar_system>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<library_url TYPE="string"/>
	<library_code TYPE="string"/>
	
	<admin_code_url TYPE="string"/>
	<admin_code TYPE="string"/>
	
	<web_code_url TYPE="string"/>
	<web_code TYPE="string"/>
	
	<web_edit_code_url TYPE="string"/>
	<web_edit_code TYPE="string"/>
	
	<web_save_code_url TYPE="string"/>
	<web_save_code TYPE="string"/>
	
	<INHERIT TYPE="ms_parameters_base"/>
	
	<webinar_system_fields>
		<webinar_system_field MULTIPLE="1" PRIMARY-KEY="name">
			<name TYPE="string" EXPR-INIT="'f' + tools.random_string( 5 )"/>
			<type TYPE="string" DEFAULT="string" FOREIGN-ARRAY="common.template_field_types"/>
			<catalog TYPE="string" FOREIGN-ARRAY="common.exchange_object_types"/>
			<title TYPE="string"/>
			<tooltip TYPE="string"/>
			<remote_collection_id TYPE="integer" FOREIGN-ARRAY="remote_collections" TITLE="Выборка"/>
			<xquery_qual TYPE="string"/>

			<entries TITLE="const=ibc3nu8xkw">
				<entry MULTIPLE="1">
					<value TYPE="string" TITLE="const=c_value"/>
				</entry>
			</entries>
		</webinar_system_field>
	</webinar_system_fields>

	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>

	<INHERIT TYPE="admin_access_base"/>

	<INHERIT TYPE="web_variables_base"/>

	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	
	<doc_info TYPE="doc_info_base"/>

	<view TEMP="1">
		<INHERIT TYPE="desc_base"/>
	</view>
	
	<get_setting PROPERTY="1" PARAM="sSettingNameParam"  EXPR="		
		teSystem = Child(0).Parent;
		return teSystem.wvars.GetChildByKey(teSystem.code + '.settings.' + sSettingNameParam);		
	"/>
	
	<get_settings PROPERTY="1" EXPR="		
		teSystem = Child(0).Parent;
		oSettings = new Object();
		sSettingsPrefix = teSystem.code + '.settings.';
		//arrSettingsVars = ArraySelect(teWebinarSystem.wvars,'StrBegins(This.name,\'' + sFieldsNameParamRoot +'\')');
		for(fldVar in teSystem.wvars)
		{
			if(StrBegins(fldVar.name,sSettingsPrefix))
			{
				sVarName = StrReplaceOne(fldVar.name,sSettingsPrefix,'');
				oSettings.SetProperty(sVarName,fldVar.value.Value);
			}
		}
		return oSettings;
	"/>
	
</webinar_system>
<OnSave PROPERTY="1" EXPR="
	tools.update_webinar_conversation_participants(TopElem.id);
"/>
<DocDesc PROPERTY="1" EXPR="
	ms_tools.get_const('sistemavebinar_1') + ': ' + webinar_system.name
"/>

</SPXML-FORM>