<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<payment_type>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base"/>

	<view TEMP="1">
		<INHERIT TYPE="desc_base"/>
	</view>
</payment_type>


<DocDesc PROPERTY="1" EXPR="
		'Тип выплат' + ': ' + payment_type.name;
"/>

</SPXML-FORM>