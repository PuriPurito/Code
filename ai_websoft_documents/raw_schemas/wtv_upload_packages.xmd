<?xml version="1.0" encoding="windows-1251"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="upload_package">

<upload_packages>
	<upload_package MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" TITLE="ID"/>
		<code TYPE="string" TITLE="const=szmhfhk4uj"/>
		<type TYPE="string" FOREIGN-ARRAY="common.package_types" TITLE="const=7d3pqwjvgf"/>
		<file_url TYPE="string" TITLE="const=mzyvt9pwvg"/>
		<package_date TYPE="date" TITLE="const=fci8vgidy2"/>

		<comment TYPE="string" TITLE="const=vkpb_comment"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</upload_package>
</upload_packages>

</SPXML-FORM>