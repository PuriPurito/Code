<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="expert">

<USE FORM="//wtv/wtv_general.xmd"/>

<experts>
	<expert MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" TITLE="ID"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<type TYPE="string" NOT-NULL="1" DEFAULT="invitee" FOREIGN-ARRAY="common.lector_types" TITLE="const=c_type"/><!-- invitee, collaborator -->
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=vkpb_expert"/>
		<person_fullname TYPE="string" TITLE="const=n46vuszh6c"/>
		<sub_expert_id TYPE="integer" FOREIGN-ARRAY="experts" TITLE="const=zameshayushiyeksp"/>

		<rating TYPE="real" TITLE="const=sa1ibhf93r"/>
		<answer_expire_time TYPE="integer" TITLE="const=751k95s5cc"/>

		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );	
				name = ( SrcDoc.TopElem.type == 'invitee' ? SrcDoc.TopElem.fullname : SrcDoc.TopElem.person_fullname )
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</expert>
</experts>

</SPXML-FORM>