<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="dn_schedule">

<USE FORM="//wtv/wtv_general.xmd"/>

<dn_schedules>
	<dn_schedule MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<faculty TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE="const=shy9bk42vy"/>	
	    <chair TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE="ms_tools.get_const('kafedra')"/>
	    <academ_year_id TYPE="integer" FOREIGN-ARRAY="dn_academ_years" TITLE=""/>
	    <term_id TYPE="integer" FOREIGN-ARRAY="dn_terms" TITLE="ms_tools.get_const('semestr')"/>
				
	    <modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<INHERIT TYPE="admin_access_base"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
		
	</dn_schedule>	
</dn_schedules>

</SPXML-FORM>					