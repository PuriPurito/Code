<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="interval_schedule">

<USE FORM="//wtv/wtv_general.xmd"/>

<interval_schedules>
	<interval_schedule MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
		<INHERIT TYPE="person_filling_base"/>

		<start_date TYPE="date" TITLE="const=c_start_date"/>
		<finish_date TYPE="date" TITLE="const=c_finish_date"/>

		<presence_state_id TYPE="integer" FOREIGN-ARRAY="presence_states" TITLE="##'Тип присутствия/отсутствия'##"/>
		<status_id TYPE="string" FOREIGN-ARRAY="common.agreement_status_types" TITLE="const=vppb_state"/>
		<create_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>
		
		<workflow_id TYPE="integer" FOREIGN-ARRAY="workflows" TITLE="const=vw_title"/>
		<workflow_state TYPE="string" INDEXED="1" TITLE="const=c136i4h31p"/>
		<workflow_state_name TYPE="string" INDEXED="1" TITLE="const=ld9m4gsmfn"/>
		<workflow_type TYPE="string" TITLE="##'Тип документооборота на согласовании'##"/>
		
		<change_start_date TYPE="date" TITLE="##'Новая дата начала'##"/>
		<change_finish_date TYPE="date" TITLE="##'Новая дата завершения'##"/>
		
		<workflow_person_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<workflow_matching_type TYPE="string" TITLE="const=c136i4h31q"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				create_date = SrcDoc.TopElem.doc_info.creation.date;
				change_start_date = SrcDoc.TopElem.change.start_date;
				change_finish_date = SrcDoc.TopElem.change.finish_date;
				
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</interval_schedule>
</interval_schedules>

</SPXML-FORM>