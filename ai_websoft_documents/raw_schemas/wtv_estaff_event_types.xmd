<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="estaff_event_type">

<USE FORM="//wtv/wtv_general.xmd"/>

<estaff_event_types>
	<estaff_event_type MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		<status TYPE="string" TITLE="const=c_status"/>

		<event_type_estaff_id TYPE="string" FOREIGN-ARRAY="Doc.TopElem.event_types" TITLE="const=tipsobytiyaesta"/>
		<org_id TYPE="integer" FOREIGN-ARRAY="orgs" TITLE="const=c_org"/>
		<recruitment_system_id TYPE="integer" FOREIGN-ARRAY="recruitment_systems" TITLE="Система подбора персонала"/>

		<position_commons TYPE="string" TITLE="const=q9lwz1kebb"/>
		
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>
		
		<INHERIT TYPE="admin_access_base"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				
				position_commons = ArrayMerge(SrcDoc.TopElem.position_commons, 'This.PrimaryKey', ';');
		"/>
	
	
	</estaff_event_type>
</estaff_event_types>

</SPXML-FORM>