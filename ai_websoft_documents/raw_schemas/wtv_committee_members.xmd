<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1"  OBJECT-NAME="committee_member">

<USE FORM="//wtv/wtv_general.xmd"/>
<committee_members>
	<committee_member MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
			
		<catalog TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" INDEXED="1" TITLE="const=c_object_type"/>
		<object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( catalog + 's' )" INDEXED="1" TITLE="const=c_object"/>
		<object_name TYPE="string" INDEXED="1" TITLE="const=c_object_name"/>

		<boss_type_id TYPE="integer" FOREIGN-ARRAY="boss_types" INDEXED="1" TITLE="const=tipuchastnikapr"/>
		<personnel_committee_id TYPE="integer" FOREIGN-ARRAY="personnel_committees" INDEXED="1" TITLE="Кадровый комитет"/>
		<status TYPE="string" NOT-NULL="1" DEFAULT="not_confirmed" FOREIGN-ARRAY="common.committee_member_status_types" TITLE="const=c_status"/>
		<committee_member_type TYPE="string" NOT-NULL="1" DEFAULT="participant" FOREIGN-ARRAY="common.committee_member_types" TITLE="const=tipuchastnikapr"/>
	
		
		<INHERIT TYPE="admin_access_base"/>
		
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem )				
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</committee_member>
</committee_members>

</SPXML-FORM>