<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="assessment_plan">

<USE FORM="//wtv/wtv_general.xmd"/>

<assessment_plans>
	<assessment_plan MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
					
		<assessment_appraise_id TYPE="integer" FOREIGN-ARRAY="assessment_appraises" TITLE="const=c_ass_appraise" INDEXED="1"/>
		
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=ass_estimated_person" INDEXED="1"/>
		<person_fullname TYPE="string" TITLE="const=cktioenppl" INDEXED="1"/>
		<person_position_name TYPE="string" TITLE="const=gt1vsgiqrc"/>
		<person_position_id TYPE="integer" TITLE="const=gt1vsgiqrc" FOREIGN-ARRAY="positions"/>
		<person_position_parent_id TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE="const=c_subd"/>
		
		<expert_person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=mkwzmalbrv" INDEXED="1"/>
		<expert_person_fullname TYPE="string" TITLE="const=c3gsppu8ck" INDEXED="1"/>
		<expert_person_position_name TYPE="string" TITLE="const=c17myt0ete"/>
		<expert_person_position_id TYPE="integer" FOREIGN-ARRAY="positions" TITLE="const=c_position"/>
		<expert_person_position_parent_id TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE="const=c_subd"/>
		
		<custom_experts TYPE="string" TITLE="const=ass_custom_experts"/>
		<custom_experts_array TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="collaborators" TITLE="const=ass_custom_experts" INDEXED="1"/>
		<is_custom_experts TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=ass_custom_experts" INDEXED="1"/>
		
		<department_id TYPE="integer" TITLE="const=c_subd"/>	
		<department_name TYPE="string" TITLE="const=uf_depart_name"/>
		<flag_appraise_department TYPE="bool" TITLE="const=nr7j4zxnrm"/>
		
		<is_done TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=xvgwmop0bf"/>
		<assessment_appraise_type TYPE="string" FOREIGN-ARRAY="common.assessment_appraise_types" TITLE="const=ass_type"/>
		
		<status TYPE="string" FOREIGN-ARRAY="common.assessment_appraise_participants" TITLE="const=c_status"/>
		
		<boss_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=c_boss" INDEXED="1"/>
		
		<integral_mark TYPE="real" TITLE="const=vx314disrh"/>
		
		<workflow_id TYPE="integer" FOREIGN-ARRAY="workflows" TITLE="const=vw_title"/>
		<workflow_state TYPE="string" TITLE="const=hzte1f3376"/>
		<workflow_state_name TYPE="string" TITLE="const=ld9m4gsmfn"/>
		<workflow_state_last_date TYPE="date" TITLE="const=c_finish_date"/>
		<is_workflow_init TYPE="bool" TITLE="const=doinicializiro"/>
		<flag_is_processed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=y7vmgz1wnd"/>

		<workflow_person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<workflow_end_date TYPE="date" TITLE="const=7vupl5i3sj"/>
		
		<index TYPE="integer" TITLE="const=c_index"/>
		<start_date TYPE="date" TIME="0" TITLE="const=c_start_date"/>
		<end_date TYPE="date" TIME="0" TITLE="const=c_finish_date"/>
		
		<budget_period_id TYPE="integer" FOREIGN-ARRAY="budget_periods" TITLE="const=c_budget_period"/>
		<period_start TYPE="date" TITLE="const=vppb_from"/>
		<period_end TYPE="date" TITLE="const=mkly6lmeds"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>
		
		<INHERIT TYPE="admin_access_base"/>
		
		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				custom_experts = ArrayMerge(SrcDoc.TopElem.custom_experts, 'This.PrimaryKey', ';');
				for ( fldRecipientElem in SrcDoc.TopElem.custom_experts )
					if ( fldRecipientElem.person_id.HasValue )
						custom_experts_array.ObtainByValue( fldRecipientElem.person_id );
				is_custom_experts = ( ArrayCount( SrcDoc.TopElem.custom_experts ) > 0 );
				
				person_fullname = SrcDoc.TopElem.person_id.sd.fullname;
				person_position_name = SrcDoc.TopElem.person_id.sd.position_name;
				person_position_id = SrcDoc.TopElem.person_id.sd.position_id;
				person_position_parent_id = SrcDoc.TopElem.person_id.sd.position_parent_id;
				
				expert_person_fullname = SrcDoc.TopElem.expert_person_id.sd.fullname;
				expert_person_position_name = SrcDoc.TopElem.expert_person_id.sd.position_name;
				expert_person_position_id = SrcDoc.TopElem.expert_person_id.sd.position_id;
				expert_person_position_parent_id = SrcDoc.TopElem.expert_person_id.sd.position_parent_id;
		"/>
	</assessment_plan>
</assessment_plans>

</SPXML-FORM>