<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

	<scale>
		<id TYPE="integer"  TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		
		<max_limit TYPE="real" TITLE="const=ogranichenie" />
		<min_limit TYPE="real" TITLE="const=ogranichenie" />
		<status TYPE="string" FOREIGN-ARRAY="common.kpi_states" TITLE="const=c_status" DEFAULT="active"/><!-- active|archiv|project -->

		<scale_elements>
			<scale_element  MULTIPLE="1" PRIMARY-KEY="id">
				<id TYPE="string" EXPR-INIT="tools.random_string(5)"/>
				<name TYPE="string" NOT-NULL="1" DEFAULT=""/>
				<type TYPE="string" NOT-NULL="1" DEFAULT="linear"/> <!--linear|nonlinear|calculated-->
				<min TYPE="real" NOT-NULL="1" DEFAULT="0"/>
				<max TYPE="real" NOT-NULL="1" DEFAULT="0"/>
				<result TYPE="real" DEFAULT=""/> <!-- В случаи если выбран тип  calculated храним занчение коффициента-->
				<desc TYPE="string" DEFAULT="" />
				<desc_required TYPE="bool" DEFAULT="false"/>
			</scale_element>
		</scale_elements>

		<comment TYPE="string" TITLE="const=vkpb_comment"/>	
		<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>

		<INHERIT TYPE="custom_elems_base"/>

		<checked PROPERTY="1" PARAM="iValue" EXPR="
			TopElem = Child(0).Parent;
			return tools.call_code_library_method( 'libAssessment', 'CheckScale', [iValue, id, TopElem] ); 
		"/>
	</scale>
</SPXML-FORM>