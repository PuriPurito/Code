<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="transaction">

<USE FORM="//wtv/wtv_general.xmd"/>

<transactions>
	<transaction MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>

		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<date TYPE="date" INDEXED="1" TITLE="const=vdb_aim_date"/>
		<direction TYPE="integer" NOT-NULL="1" DEFAULT="2" TITLE="const=jhu9s1k1cc"/>
		<account_id TYPE="integer" FOREIGN-ARRAY="accounts" INDEXED="1" TITLE="const=dwym57yfvr"/>

		<org_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="orgs" TITLE="const=c_org"/>

		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=lhbyv18qkm"/>

		<amount TYPE="real" PRECISION="2" TITLE="const=c_sum"/>

		<INHERIT TYPE="object_type_base"/>
		
		<objects TYPE="integer" MULTIPLE="1" TITLE="const=4egocnh7uc"/>

		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</transaction>
</transactions>

</SPXML-FORM>
