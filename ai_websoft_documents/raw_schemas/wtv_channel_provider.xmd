<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>
<USE FORM="//wtv/ms_general.xmd"/>

<channel_provider>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<code_library_id TYPE="integer" FOREIGN-ARRAY="code_library" TITLE="##'Библиотека программного кода'##"/>
	<root_function_name TYPE="string" NOT-NULL="1" TITLE="##'Имя функции получения ленты'##"/>
	
	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>

	<INHERIT TYPE="admin_access_base"/>

	<INHERIT TYPE="web_variables_base"/>

	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>

	<provider_do PROPERTY="1" PARAM="channelWVars" EXPR="
		teSystem = Child(0).Parent;
		tools_web.set_web_params(teSystem.wvars, channelWVars, true);
		arrTupleParam = ArrayExtract(ArraySort(teSystem.wvars, 'This.position', '+'), 'This.value.HasValue ? This.value.Value : null')
		return tools.call_code_library_method(teSystem.code_library_id.Value, teSystem.root_function_name.Value, arrTupleParam);
	"/>	
</channel_provider>

<DocDesc PROPERTY="1" EXPR="
		'Провайдер канала ' + ': ' + channel_provider.name
"/>

</SPXML-FORM>