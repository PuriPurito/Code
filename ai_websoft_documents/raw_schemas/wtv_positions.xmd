<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="position">

<positions>
	<position MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		<status TYPE="string" NOT-NULL="1" DEFAULT="active" FOREIGN-ARRAY="common.position_statuses" TITLE="const=c_status"/>
		
		<org_id TYPE="integer" FOREIGN-ARRAY="orgs" INDEXED="1" TITLE="const=c_org"/>
		<parent_object_id TYPE="integer" FOREIGN-ARRAY="subdivisions" INDEXED="1" TITLE="const=c_subd"/>

		<basic_collaborator_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<basic_collaborator_fullname TYPE="string" INDEXED="1" TITLE="const=lhbyv18qkm"/>
		<basic_rate TYPE="integer" TITLE="const=p7kssz5oz1"/>
		<is_boss TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=bi5usg4iby"/>
		<position_date TYPE="date" TIME="0" TITLE="const=datavstupleniya"/>
		<position_finish_date TYPE="date" TITLE="const=datazaversheniya_1"/>
		<is_position_finished TYPE="bool" DEFAULT="false" TITLE="const=deystvienaznach"/>
		<position_assignment_type TYPE="string" FOREIGN-ARRAY="common.position_assignment_types" TITLE="const=tipnaznacheniya"/>
		<position_appointment_type_id TYPE="integer" FOREIGN-ARRAY="appointment_types" TITLE="const=tipnaznacheniya"/>

		<competence_profile_id TYPE="integer" FOREIGN-ARRAY="competence_profiles" TITLE="const=ass_competence_profile"/>
		<kpi_profile_id TYPE="integer" FOREIGN-ARRAY="kpi_profiles" TITLE="const=ass_kpi_profile"/>
		<kpi_profiles_id TYPE="integer" FOREIGN-ARRAY="kpi_profiles" TITLE="const=ass_kpi_profiles" MULTIPLE="1"/>
		<bonus_profile_id TYPE="integer" FOREIGN-ARRAY="bonus_profiles" TITLE="const=629saq8h6f"/>
		<knowledge_profile_id TYPE="integer" FOREIGN-ARRAY="knowledge_profiles" TITLE="const=syqx4l4uo1"/>
		<position_common_id TYPE="integer" FOREIGN-ARRAY="position_commons" TITLE="const=c_position_common"/>
		<position_family_id TYPE="integer" FOREIGN-ARRAY="position_familys" TITLE="const=re7n9mti11"/>

		<staff_position_id TYPE="integer" FOREIGN-ARRAY="staff_positions" INDEXED="1" TITLE="Позиция штатного рассписания"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				basic_collaborator_fullname = SrcDoc.TopElem.basic_collaborator_id.sd.fullname;
				for ( fldRecipientElem in SrcDoc.TopElem.kpi_profiles )
					kpi_profiles_id.ObtainByValue( fldRecipientElem.id );
		"/>
	</position>
</positions>

</SPXML-FORM>