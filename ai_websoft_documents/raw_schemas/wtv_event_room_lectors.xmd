<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" x-linked-catalogs="events;event_rooms">

<USE FORM="//wtv/wtv_general.xmd"/>

<event_room_lectors>
	<event_room_lector MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>

		<event_id TYPE="integer" FOREIGN-ARRAY="events" INDEXED="1" TITLE="const=c_events"/>
		<INHERIT TYPE="event_catalog_base"/>
		<is_model TYPE="bool" NOT-NULL="1" DEFAULT="false"/>		
		<place_id TYPE="integer" FOREIGN-ARRAY="places" INDEXED="1" TITLE="const=c_place"/>
		<lector_id TYPE="integer" FOREIGN-ARRAY="lectors" INDEXED="1" TITLE="const=c_lector"/>
		<type TYPE="string" NOT-NULL="1" DEFAULT="invitee" FOREIGN-ARRAY="common.lector_types" TITLE="const=c_type"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" TITLE="const=bgjgk81nh4"/>
		<lector_fullname TYPE="string" TITLE="const=bgjgk81nh4"/>
		<hours TYPE="integer" TITLE="const=bos75mgjh5"/>
		<is_tutor TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="const=veb_is_lector"/>
		<is_collaborator TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="const=r0pdnwxus9"/>
		<is_preparation TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="const=n8wp47yzv5"/>
	</event_room_lector>
</event_room_lectors>

<MatchDocTypeExt PROPERTY="1" EXPR="
		SrcDoc.FormUrl == 'x-local://wtv/wtv_event.xmd'
"/>

<OnBuildExt PROPERTY="1" EXPR="
		teSrcDoc = SrcDoc.TopElem;
		iSrcDocID = SrcDoc.DocID;
		iPersonNum = teSrcDoc.person_num;
		DeleteCatalogEntries( iSrcDocID, 'event_id' );
		if( teSrcDoc.is_room )
		{
			xarrLectors = ArraySelectAll( XQuery( 'for $elem_qc in lectors where MatchSome( $elem_qc/id, (' + ArrayMerge( teSrcDoc.lectors, 'PrimaryKey', ',' ) + ') ) order by $elem_qc/id return $elem_qc/Fields(\'id\',\'lector_fullname\',\'type\',\'person_id\',\'person_fullname\')' ) );
			
			for ( srcSpot in teSrcDoc.lectors )
			{
				newSpot = AddCatalogEntry();
				iTempID = newSpot.id.Value;

				newSpot.event_id = iSrcDocID;
				newSpot.AssignElem( teSrcDoc );
				newSpot.person_num = iPersonNum;
				newSpot.AssignElem( srcSpot );
				
				catLector = catLector = ArrayOptFindBySortedKey( xarrLectors, srcSpot.PrimaryKey, 'id' );
				if( catLector != undefined )
				{
					newSpot.person_fullname = catLector.person_fullname;
					newSpot.lector_fullname = catLector.lector_fullname;
					newSpot.type = catLector.type;
					if(newSpot.type == 'collaborator')
						newSpot.person_id = catLector.person_id;
				}

				newSpot.id = iTempID;
				StoreCatalogEntry( newSpot );
			}
		}
"/>

<OnDeleteExt PROPERTY="1" EXPR="
		DeleteCatalogEntries( SrcDocID, 'event_id' );
"/>

</SPXML-FORM>