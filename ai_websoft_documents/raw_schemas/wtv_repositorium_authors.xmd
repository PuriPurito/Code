<?xml version="1.0" encoding="windows-1251"?>
<SPXML-FORM CATALOG="1" x-linked-catalogs="repositoriums">

<repositorium_authors>
	<repositorium_author MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<repositorium_id TYPE="integer" FOREIGN-ARRAY="repositoriums" INDEXED="1"/>
		<repositorium_name TYPE="string"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1"/>
		<person_fullname TYPE="string"/>
	</repositorium_author>
</repositorium_authors>

<MatchDocTypeExt PROPERTY="1" EXPR="
		return (SrcDoc.FormUrl == 'x-local://wtv/wtv_repositorium.xmd');
"/>

<OnBuildExt PROPERTY="1" EXPR="
		DeleteCatalogEntries( SrcDoc.DocID, 'repositorium_id' );

		for ( srcSpot in SrcDoc.TopElem.authors )
		{
			newSpot = AddCatalogEntry();
			newSpot.repositorium_id = SrcDoc.DocID;
			newSpot.repositorium_name = SrcDoc.TopElem.name;
			newSpot.person_id = srcSpot.PrimaryKey;
			newSpot.person_fullname = srcSpot.person_fullname;
			StoreCatalogEntry( newSpot );
		}
"/>

<OnDeleteExt PROPERTY="1" EXPR="
		DeleteCatalogEntries( SrcDocID, 'repositorium_id' );
"/>

</SPXML-FORM>