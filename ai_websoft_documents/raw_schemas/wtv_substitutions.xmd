<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="substitution">

<USE FORM="//wtv/wtv_general.xmd"/>

<substitutions>
	<substitution MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<status TYPE="string" FOREIGN-ARRAY="common.substitution_status_types" NOT-NULL="1" DEFAULT="active" TITLE="const=c_status"/>
		<substitution_type_id TYPE="integer" FOREIGN-ARRAY="substitution_types" TITLE="Тип замещения"/>
		<target_object_type TYPE="string" INDEXED="1" TITLE="Тип целевого объекта"/>
		<target_object_selector TYPE="string" TITLE="Список целевых объектов"/>
		<target_object_id TYPE="integer" INDEXED="1" MULTIPLE="1"/>
		<data_str TYPE="string" TITLE="##'Нестандартные права (строка или JSON с информацией о правах)'##"/>
		
		<person_selector TYPE="string" TITLE="Выбор сотрудников" DEFAULT="person"/>

		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=lhbyv18qkm"/>
		<person_org_name TYPE="string" TITLE="const=kyvtanhi3r"/>

		<INHERIT TYPE="object_type_base"/>

		<create_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>
		<start_date TYPE="date" TITLE="const=c_start_date"/>
		<finish_date TYPE="date" TITLE="const=c_finish_date"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				
				for (fldOTElem in SrcDoc.TopElem.target_objects)
					target_object_id.Add().Value = fldOTElem.PrimaryKey;
				
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</substitution>
</substitutions>

</SPXML-FORM>