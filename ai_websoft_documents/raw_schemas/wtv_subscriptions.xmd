<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="subscription">

<USE FORM="//wtv/wtv_general.xmd"/>

<subscriptions>
	<subscription MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<type TYPE="string" NOT-NULL="1" DEFAULT="document" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=c_object_type"/>

		<create_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>
		<date_to TYPE="date" TITLE="##'Действует до'##"/>

		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=lhbyv18qkm"/>
		<person_org_name TYPE="string" TITLE="const=rne3a8laso"/>

		<document_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( type + 's' )" INDEXED="1" TITLE="const=c_object"/>

		<include_subdocs TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=taf046flri"/>

		<date_last_action TYPE="date" TITLE="const=dataposlednego_5"/>

		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				person_fullname = SrcDoc.TopElem.person_id.sd.fullname;
				person_org_name = SrcDoc.TopElem.person_id.sd.org_name;
		"/>
	</subscription>
</subscriptions>

</SPXML-FORM>