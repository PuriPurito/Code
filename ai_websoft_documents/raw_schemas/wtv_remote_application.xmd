<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<remote_application>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<app_id TYPE="string" TITLE="APP ID"/>
	
	<credentials>
		<credential MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="integer" FOREIGN-ARRAY="credentials"/>
		</credential>
	</credentials>
	
	<access>
		<INHERIT TYPE="access_base"/>
	</access>
	<category_id TYPE="string" MULTIPLE="1" FOREIGN-ARRAY="categorys" TITLE="const=4egocnh7uc"/>
	
	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
</remote_application>


<DocDesc PROPERTY="1" EXPR="
		'Внешнее приложение API' + ' - ' + remote_application.name;
"/>

</SPXML-FORM>