<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM x-ft-index="0" x-xml-index="0">

<USE FORM="//wtv/ms_general.xmd"/>

<script_queue_elem>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<start_date TYPE="date" TITLE="##'Дата для запуска скрипта'##"/>
	<start_time TYPE="date" TITLE="const=vremyazapuska"/>
	<finish_time TYPE="date" TITLE="const=c_finish_time"/>
	<delay TYPE="integer" TITLE="const=zaderzhkamezhduz"/>
	<completed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=mndn3f98h2"/>
	<error TYPE="string" TITLE="const=tekstoshibki"/>
	<result TYPE="string" TITLE="const=c_result"/>
	<delete_automatically TYPE="bool" NOT-NULL="1" DEFAULT="true" TITLE="const=udalyatposlevyp"/>

	<obj TYPE="variant" TITLE="const=c_object"/>

	<run_code TYPE="string" STORE-SECTION="cdata" TITLE="const=hcei2rcaye"/>

	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>

	<view TEMP="1">
		<selector TYPE="string" NOT-NULL="1" DEFAULT="common" TEMP="1"/>
	</view>
</script_queue_elem>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('bjz1uz8sf5') + ': ' + script_queue_elem.name
"/>

</SPXML-FORM>