<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="script_queue_elem">

<script_queue_elems>
	<script_queue_elem MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" TITLE="ID"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<start_date TYPE="date" TITLE="##'Дата для запуска скрипта'##"/>
		<start_time TYPE="date" TITLE="const=vremyazapuska"/>
		<finish_time TYPE="date" TITLE="const=c_finish_time"/>
		<delay TYPE="integer" DEFAULT="0" TITLE="const=zaderzhkamezhduz"/>
		<completed TYPE="bool" NOT-NULL="1" INDEXED="1" DEFAULT="false" TITLE="const=mndn3f98h2"/>
		<delete_automatically TYPE="bool" INDEXED="1" NOT-NULL="1" DEFAULT="true" TITLE="const=udalyatposlevyp"/>

		<block TYPE="string" FOREIGN-ARRAY="access_blocks" TITLE="const=t0uzpnfv2b"/>

		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>

		<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
		<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

		<create_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>
		<modification_date INDEXED="1" TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				create_date = SrcDoc.TopElem.doc_info.creation.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</script_queue_elem>
</script_queue_elems>

</SPXML-FORM>