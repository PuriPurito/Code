<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" HIER="1" PARENT-ID-ELEM="parent_task_id" OBJECT-NAME="task">

<USE FORM="//wtv/wtv_general.xmd"/>

<tasks>
	<task MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		
		<task_type_id TYPE="integer" FOREIGN-ARRAY="task_types" TITLE="const=c_type"/>
		
		<parent_task_id TYPE="integer" FOREIGN-ARRAY="tasks" TITLE="const=roditelskayazad"/>
		<translated_task_id TYPE="integer" FOREIGN-ARRAY="tasks" TITLE="const=istochniktransl"/>
		
		<translated_target_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=tippoluchatelyat"/>
		<translated_target_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog(translated_target_type + 's')" TITLE="const=poluchateltrans"/>
		
		<assigner_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=naznachivshiyzad"/>
		<executor_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=tipotvetstvenn"/>
		<executor_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog(executor_type + 's')" TITLE="const=otvetstvennyyz_2"/>
		
		<status TYPE="string" FOREIGN-ARRAY="common.task_statuses" TITLE="const=c_status"/>
		<custom_state_id TYPE="string" TITLE="##'Настраиваемый статус'##"/>
		<plan TYPE="string" TITLE="const=vkb_plan_value"/>
		<fact TYPE="string" TITLE="const=vkb_fact"/>
		<plan_value TYPE="real" TITLE="const=vkb_plan_value_real"/>
		<fact_value TYPE="real" TITLE="const=vkb_factreal"/>
		<value TYPE="real" TITLE="const=ass_mark"/>
		<readiness_percent TYPE="real" TITLE="const=c_readiness_percent"/>
		<priority TYPE="integer" TITLE="Приоритет"/>
		
		<source_object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=tipobektaistoch"/>
		<source_object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog(source_object_type + 's')" TITLE="const=obektistochnik"/>
		
		<pay_stage_id TYPE="integer" FOREIGN-ARRAY="pay_stages" TITLE="##'Этап договора'##"/>

		<target_object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=tipobektaceli"/>
		<target_object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog(target_object_type + 's')" TITLE="const=obektceli"/>
		
		<fact_object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=tipfakticheskog"/>
		<fact_object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog(fact_object_type + 's')" TITLE="const=fakticheskiyobe"/>
		
		<expert_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="collaborators" TITLE="const=vkpb_experts"/>
		<date_plan TYPE="date" TITLE="const=fakticheskayadat_1"/>
		<date_fact TYPE="date" TITLE="const=fakticheskayadat"/>
		<start_date_plan TYPE="date" TITLE="const=planiruemayadat_4"/>
		<end_date_plan TYPE="date" TITLE="const=planiruemayadat_1"/>
		<plan_budget_period_id TYPE="integer" FOREIGN-ARRAY="budget_periods" TITLE="const=c_budget_period"/>
		<fact_budget_period_id TYPE="integer" FOREIGN-ARRAY="budget_periods" TITLE="const=c_budget_period"/>
		
		<plan_labor_costs TYPE="integer" TITLE="##'Плановые трудозатраты'##"/>
		<fact_labor_costs TYPE="integer" TITLE="##'Фактические трудозатраты'##"/>
		
		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>
		
		<desc TYPE="string" TITLE="const=c_desc"/>
		<comment TYPE="string" TITLE="const=vkpb_comment"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>
		
		<workflow_id TYPE="integer" FOREIGN-ARRAY="workflows" TITLE="const=vw_title"/>
		<workflow_state TYPE="string" INDEXED="1" TITLE="const=c136i4h31p"/>
		<workflow_state_name TYPE="string" INDEXED="1" TITLE="const=ld9m4gsmfn"/>

		<workflow_person_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<workflow_matching_type TYPE="string" TITLE="const=c136i4h31q"/>
		
		<conversation_id TYPE="integer" FOREIGN-ARRAY="conversations" TITLE="##'Разговор'##"/>
		
		<preparation_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<has_files TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="##'К задаче прикреплены файлы'##"/>
		<read_by_users TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<INHERIT TYPE="admin_access_base"/>
		
		<tags TYPE="string" TITLE="##'ID тегов'##"/>
		<knowledge_parts TYPE="string" TITLE="const=vkpb_knowledge_parts_title"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				
				for ( fldElem in SrcDoc.TopElem.experts )
					expert_id.Add().Value = fldElem.PrimaryKey;
				
				for ( fldWorkflowMatchingElem in SrcDoc.TopElem.workflow_matchings )
				{
					workflow_person_id.Add().Value = fldWorkflowMatchingElem.person_id;
				}
				for ( fldElem in SrcDoc.TopElem.preparations )
				{
					preparation_id.Add().Value = fldElem.person_id;
				}
				for ( fldElem in SrcDoc.TopElem.edit_block.read_by_users )
				{
					read_by_users.Add().Value = fldElem.user_id;
				}
				
				desc = StrLeftCharRange( UnifySpaces( HtmlToPlainText( SrcDoc.TopElem.desc ) ), 250 );
				comment = StrLeftCharRange( UnifySpaces( HtmlToPlainText( SrcDoc.TopElem.comment ) ), 250 );
				plan = StrLeftCharRange( UnifySpaces( HtmlToPlainText( SrcDoc.TopElem.plan ) ), 250 );
				fact = StrLeftCharRange( UnifySpaces( HtmlToPlainText( SrcDoc.TopElem.fact ) ), 250 );
				has_files = ArrayOptFirstElem( SrcDoc.TopElem.files ) != undefined;
				
				tags = ArrayMerge(SrcDoc.TopElem.tags, 'This.PrimaryKey', ';');
				knowledge_parts = ArrayMerge(SrcDoc.TopElem.knowledge_parts, 'This.PrimaryKey', ';');
		"/>
	</task>
</tasks>

</SPXML-FORM>