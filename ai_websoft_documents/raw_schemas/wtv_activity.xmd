<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM x-ft-index="0" x-xml-index="0">

<USE FORM="//wtv/wtv_general.xmd"/>

<activity>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<is_eval TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=vychislyatmassiv"/>
	<statements_eval TYPE="string" TITLE="const=hqyb5zxwgv"/>
	<statements_eval_url TYPE="string" TITLE="const=ssylkanafaylvy"/>

	<request>
		<json_str TYPE="string"/>
	</request>

	<INHERIT TYPE="web_variables_base"/>

	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
</activity>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('uchebnayaaktivno') + ': ' + activity.name
"/>

</SPXML-FORM>