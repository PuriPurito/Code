			return iLearning;
	"/>

	<get_info PROPERTY="1" EXPR="
			return tools.extract_bfields_by_list(Child(0).Parent, 'id;code;lastname;firstname;middlename;fullname;sex;birth_date;address;phone;email;login;position_id;position_name;position_parent_id;position_parent_name;org_id;org_name', false);
	"/>

	<get_events PROPERTY="1" PARAM="sTypeParam" PARAM="sStatusParam" PARAM="sRoleCollabParam" EXPR="
		try
		{
			sTypeParam = (sTypeParam == '' || sTypeParam == '?' ? 'all' : sTypeParam);
		}
		catch(_x_)
		{
			sTypeParam = 'all';
		}

		try
		{
			sStatusParam = (sStatusParam == '' || sStatusParam == '?' ? 'all' : sStatusParam);
		}
		catch(_x_)
		{
			sStatusParam = 'all';
		}

		try
		{
			sRoleCollabParam = (sRoleCollabParam == '' || sRoleCollabParam == '?' ? 'all' : sRoleCollabParam);
		}
		catch(_x_)
		{
			sRoleCollabParam = 'all';
		}

		var iCurUserID = Child(0).Parent.id.Value;

		sQueryParam1 = (sTypeParam != 'all' ? ' and $elem/type_id=' + XQueryLiteral(sTypeParam) : '');

		sQueryParam2 = (sStatusParam != 'all' ? ' and $elem/status_id=' + XQueryLiteral(sStatusParam) : '');

		sQueryParam3 = (sRoleCollabParam != 'all' ? ' and $elem/is_' + sRoleCollabParam + '=true()' : '');
		alert('for $elem in event_collaborators where $elem/collaborator_id= ' + iCurUserID + sQueryParam1 + sQueryParam2 + sQueryParam3 + ' return $elem');
		arrEvents = XQuery('for $elem in event_collaborators where $elem/collaborator_id= ' + iCurUserID + sQueryParam1 + sQueryParam2 + sQueryParam3 + ' return $elem');

		return arrEvents;
	"/>

	<get_groups PROPERTY="1" EXPR="
		var iCurUserID = Child(0).Parent.id.Value;

		arrGroups = XQuery('for $elem in group_collaborators where $elem/collaborator_id=' + iCurUserID + ' return $elem');

		return arrGroups;
	"/>

	<get_event_results PROPERTY="1" EXPR="
		var iCurUserID = Child(0).Parent.id.Value;

		arrEventResults = XQuery('for $elem in event_results where $elem/person_id=' + iCurUserID + ' return $elem');

		return arrEventResults;
	"/>

	<update_info PROPERTY="1" PARAM="sLastnameParam" PARAM="sFirstnameParam" PARAM="sMiddlenameParam" PARAM="sAddressParam" PARAM="sPhoneParam" PARAM="sEmailParam" PARAM="sLoginParam" PARAM="sPasswordParam" EXPR="
		try
		{
			if (sLastnameParam != '' &amp;&amp; sLastnameParam != '?')
			{
				Child(0).Parent.lastname = Trim(sLastnameParam);
			}

			if (sFirstnameParam != '' &amp;&amp; sFirstnameParam != '?')
			{
				Child(0).Parent.firstname = Trim(sFirstnameParam);
			}

			if (sMiddlenameParam != '' &amp;&amp; sMiddlenameParam != '?')
			{
				Child(0).Parent.middlename = Trim(sMiddlenameParam);
			}

			if (sAddressParam != '' &amp;&amp; sAddressParam != '?')
			{
				Child(0).Parent.address = Trim(sAddressParam);
			}

			if (sPhoneParam != '' &amp;&amp; sPhoneParam != '?')
			{
				Child(0).Parent.phone = Trim(sPhoneParam);
			}

			if (sEmailParam != '' &amp;&amp; sEmailParam != '?')
			{
				Child(0).Parent.email = Trim(sEmailParam);
			}

			if (sLoginParam != '' &amp;&amp; sLoginParam != '?')
			{
				Child(0).Parent.login = Trim(sLoginParam);
			}

			if (sPasswordParam != '' &amp;&amp; sPasswordParam != '?')
			{
				Child(0).Parent.password = Trim(sPasswordParam);
			}

			Child(0).Parent.Doc.Save();
			return tools.extract_bfields_by_list(Child(0).Parent, 'code;lastname;firstname;middlename;address;phone;email;login;password', false);
		}
		catch(er)
		{
			alert(er);
		}

	"/>

	<clear_subs_fields PROPERTY="1" EXPR="
			TopElem = Child(0).Parent;
			TopElem.org_id.Clear();
			TopElem.org_name.Clear();
			TopElem.position_id.Clear();
			TopElem.position_name.Clear();
			TopElem.position_parent_id.Clear();
			TopElem.position_parent_name.Clear();
	"/>

</collaborator>


<OnCreate PROPERTY="1" EXPR="
		TopElem.view.never_saved = true;
"/>

<!-- /*PERSON_HIERARHY*/ -->
<OnSave PROPERTY="1" EXPR="
	/*PERSON_HIERARHY*/
		if (TopElem.view.drop_pers_hier_entry.Value)
		{
			/*
			var DestCatalog = person_hierarchys;

			DeleteCatalogEntries( TopElem.Doc.DocID, 'collaborator_id' );

			if (TopElem.position_id.HasValue)
			{
				var newSpot = AddCatalogEntry();
				newSpot.collaborator_id = TopElem.id;
				newSpot.position_id = TopElem.position_id;
				StoreCatalogEntry( newSpot );
			}
			*/
			var teCommand = 'c:' + TopElem.Doc.DocID + '|'

			if (TopElem.position_id.HasValue)
			{
				 teCommand += TopElem.id + ':' + TopElem.position_id + ':' + TopElem.position_parent_id;
			}
			tools.spxml_unibridge.Object.provider.PutMessageInQueue( 'person-hierarchy-update-queue', teCommand );

			TopElem.view.drop_pers_hier_entry = false;
		}
"/>

<OnBeforeSave PROPERTY="1" EXPR="

		/*PERSON_HIERARHY*/
		if (TopElem.Doc.NeverSaved &amp;&amp; TopElem.position_id.HasValue)
		{
			TopElem.view.drop_pers_hier_entry = true;
		}
		else
		{
			var old = ArrayOptFirstElem(XQuery('for $elem in collaborators where $elem/id = ' + TopElem.Doc.DocID + ' return $elem/Fields(\'position_id\')'));
			if (old == undefined || old.position_id.Value != TopElem.position_id.Value)
			{
				TopElem.view.drop_pers_hier_entry = true;

			}
			else
				TopElem.view.drop_pers_hier_entry = false;
		}



		if ( TopElem.position_id.HasValue )
		{
			try
			{
				if ( TopElem.view.position_doc_ref.HasValue )
					positionDoc = TopElem.view.position_doc_ref.Object;
				else
					positionDoc = OpenDoc( UrlFromDocID( TopElem.position_id ) ).TopElem;
				TopElem.position_name = positionDoc.name;
				TopElem.position_parent_id = positionDoc.parent_object_id;
				TopElem.org_id = positionDoc.org_id;
			}
			catch ( err )
			{
				if ( ! StrBegins( TopElem.position_name, global_settings.object_deleted_str ) )
					TopElem.position_name = global_settings.object_deleted_str + ' ' + StrHexInt( TopElem.position_id, 16 ) + ' ' + TopElem.position_name;
			}
		}
		else
		{
			TopElem.position_name.Clear();
			TopElem.position_parent_id.Clear();
			TopElem.position_parent_name.Clear();
		}

		if ( TopElem.org_id.HasValue )
		{
			try
			{
				orgDoc = OpenDoc( UrlFromDocID( TopElem.org_id ) ).TopElem;
				TopElem.org_name = orgDoc.disp_name;
			}
			catch ( err )
			{
				if ( ! StrBegins( TopElem.org_name, global_settings.object_deleted_str ) )
					TopElem.org_name = global_settings.object_deleted_str + ' ' + StrHexInt( TopElem.org_id, 16 ) + ' ' + TopElem.org_name;
			}
		}
		else
		{
			TopElem.org_name.Clear();
		}
		if ( TopElem.position_parent_id.HasValue )
		{
			try
			{
				subdivisionDoc = OpenDoc( UrlFromDocID( TopElem.position_parent_id ) ).TopElem;
				TopElem.position_parent_name = subdivisionDoc.name;
			}
			catch( err )
			{
				if ( ! StrBegins( TopElem.position_parent_name, global_settings.object_deleted_str ) )
					TopElem.position_parent_name = global_settings.object_deleted_str + ' ' + StrHexInt( TopElem.position_parent_id, 16 ) + ' ' + TopElem.position_parent_name;
			}
		}
		else
		{
			TopElem.position_parent_name.Clear();
		}

		try
		{
			if ( global_settings.settings.password_auto_rebuild )
				TopElem.password = tools.make_password( TopElem.password, true );
		}
		catch ( dd )
		{
			alert( dd );
		}

		if ( global_settings.settings.fill_path_subs )
			TopElem.filling_path_subs();

		if ( global_settings.settings.save_person_change_log )
		{
			logCount = ArrayCount( TopElem.change_logs );
			if ( logCount == 0 )
			{
				if ( TopElem.position_id.HasValue || TopElem.position_parent_id.HasValue || TopElem.org_id.HasValue )
				{
					_child = TopElem.change_logs.AddChild();
					tools.assign_elems_exclude( _child, TopElem, ['custom_elems'] );
				}
			}
			else
			{
				lastLog = TopElem.change_logs[ logCount - 1 ];
				if ( TopElem.position_id != lastLog.position_id || TopElem.position_parent_id != lastLog.position_parent_id || TopElem.org_id != lastLog.org_id )
				{
					lastLog = TopElem.change_logs.AddChild();
				}
				tools.assign_elems_exclude( lastLog, TopElem, ['comment','custom_elems'] );
			}
		}

		if ( TopElem.is_dismiss )
		{
			TopElem.current_state = ms_tools.get_const('c_dismiss');
		}
		else
		{
			TopElem.current_state.Clear();
			for ( _elem_state in TopElem.history_states )
			{
				if ( ( _elem_state.start_date.HasValue &amp;&amp; _elem_state.finish_date.HasValue &amp;&amp; CurDate &lt; _elem_state.finish_date &amp;&amp; CurDate &gt; _elem_state.start_date )
					|| ( _elem_state.start_date.HasValue &amp;&amp; ! _elem_state.finish_date.HasValue &amp;&amp; CurDate &gt; _elem_state.start_date )
					|| ( ! _elem_state.start_date.HasValue &amp;&amp; _elem_state.finish_date.HasValue &amp;&amp; CurDate &lt; _elem_state.finish_date ) )
				{
					_cur_elem_state = _elem_state.state_id.OptForeignElem;
					TopElem.current_state = _cur_elem_state != undefined ? _cur_elem_state.name : _elem_state.state_id;
					break;
				}
			}
		}

		if ( TopElem.pict_url != TopElem.last_data.pict_url || TopElem.personal_config.avatar_filename != TopElem.last_data.avatar_filename )
			tools_web.clear_person_pict_cache( TopElem.id );

		try
		{
			TopElem.snils = tools.call_code_library_method( 'libMain', 'get_snils_str', [ TopElem.snils ] ).snils_str;
		}
		catch ( err )
		{
			alert( err );
		}

		personDoc = TopElem;
		ms_tools.raise_system_event( 'common_save_collaborator', null, TopElem.Doc.DocID, TopElem.Doc );

		TopElem.last_data.AssignElem( TopElem );
		TopElem.last_data.AssignElem( TopElem.access );
		TopElem.last_data.AssignElem( TopElem.personal_config );
"/>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('c_coll') + ': ' + TopElem.fullname
"/>

</SPXML-FORM>