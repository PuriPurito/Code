	<is_time_access PROPERTY="1" EXPR="
			if ( access_time_start.HasValue || access_time_end.HasValue )
				try
				{
					_cur_date = Date();
					if ( access_time_start.HasValue )
					{
						_access_date_start = Date( StrDate( _cur_date, false ) + ' ' + access_time_start );
						if ( _cur_date &lt; _access_date_start )
							return false;

						if ( access_time_end.HasValue )
						{
							_access_date_end = Date( StrDate( _cur_date, false ) + ' ' + access_time_end );
							if ( _access_date_start &gt; _access_date_end )
								_access_date_end = DateOffset( _access_date_end, 86400 );

							if ( _cur_date &gt; _access_date_end )
								return false;
						}
					}
					else if ( _cur_date &gt; Date( StrDate( _cur_date, false ) + ' ' + access_time_end ) )
					{
						return false;
					}
				}
				catch( err )
				{
					alert( err );
				}
			return true;
	"/>

