	<clear_cur_position PROPERTY="1" EXPR="
			if ( ! position_id.HasValue )
				return;

			_array = XQuery( 'for $elem in positions where $elem/basic_collaborator_id = ' + Doc.DocID + ' and $elem/id != ' + position_id + ' return $elem' );
			_first = ArrayOptFirstElem( _array );
			if ( _first != undefined )
				position_id = _first.id;
			else
				position_id.Clear();
	"/>



	<rows TYPE="variant" TEMP="1"/>
	<row_disp_elem TYPE="string" NOT-NULL="1" DEFAULT="person_fullname" TEMP="1"/>
	<row_list_field TYPE="string" DEFAULT=".Env.ListElem" TEMP="1"/>
	<row_key_field TYPE="string" DEFAULT=".PrimaryKey" TEMP="1"/>
	<list_variant TYPE="variant" TEMP="1"/>
	<start_action PROPERTY="1" PARAM="sTypeParam" EXPR="
			try
			{
				sTypeParam;
			}
			catch ( err )
			{
				sTypeParam = '';
			}
			try
			{
				if ( list_variant.HasValue )
				{
					_rows = list_variant.Object.SelRows;
					list_variant.Clear();
				}
			}
			catch ( err )
			{
				_rows = Screen.FindItem( 'ViewGrid' ).SelRows;
			}
			_num = ArrayCount( _rows );
			if ( _num &gt; 10 &amp;&amp; ! Screen.MsgBox( ms_tools.get_const('8rklpbv2ro'), ms_tools.get_const('c_question'), 'question', 'yes,no,cancel' ) )
				Cancel();

			catPerson = ArrayOptFirstElem( _rows );
			if ( catPerson != undefined )
			{
				if ( catPerson.Env.ListElem.ChildExists( 'fullname' ) )
				{
					row_disp_elem = 'fullname';
				}
				else
				{
					row_disp_elem = 'person_fullname';
					if ( sTypeParam != 'FinishCourse' &amp;&amp; sTypeParam != 'FinishTest' )
					{
						row_key_field = catPerson.Env.ListElem.ChildExists( 'collaborator_id' ) ? '.collaborator_id' : '.person_id';
					}
				}
			}
			rows = _rows;
			return _num;
	"/>
<!--
	<ple>
		<is_enabled TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
		<columns TYPE="integer"/>
		<cwts>
			<cwt MULTIPLE="1" PRIMARY-KEY="id">
				<id TYPE="integer" FOREIGN-ARRAY="custom_web_templates"/>
				<name TYPE="string"/>
				<position>
					<x TYPE="integer"/>
					<y TYPE="integer"/>
				</position>
				<INHERIT TYPE="web_variables_base"/>
			</cwt>
		</cwts>
	</ple>
-->
	<set_basic_position PROPERTY="1" PARAM="iPositionIDParam" EXPR="
			if ( position_id == iPositionIDParam )
				return false;

			if ( iPositionIDParam == null )
			{
				org_id.Clear();
				position_id.Clear();
				position_parent_id.Clear();
				org_name.Clear();
				position_name.Clear();
				position_parent_name.Clear();
			}
			else
			{
				try
				{
					tePosition = OpenDoc( UrlFromDocID( iPositionIDParam ) ).TopElem;
				}
				catch ( err )
				{
					ActiveScreen.MsgBox( ms_tools.get_const('gmk3t7zeoc'), ms_tools.get_const('c_question'), 'question', 'yes,no,cancel' );
					return false;
				}
				position_name = tePosition.name;
				position_parent_id = tePosition.parent_object_id;
				org_id = tePosition.org_id;
				org_name = tools.get_foreign_field( org_id, 'disp_name', global_settings.object_deleted_str );

				try
				{
					if ( position_parent_id.HasValue )
						position_parent_name = OpenDoc( UrlFromDocID( position_parent_id ) ).TopElem.name;
				}
				catch( err )
				{
					position_parent_name = global_settings.object_deleted_str + ' ' + StrHexInt( position_parent_id, 16 );
				}

				position_id = iPositionIDParam;
			}
			return true;
	"/>

	<get_courses PROPERTY="1" PARAM="sTypeParam" EXPR="
		try
		{
			sTypeParam;
		}
		catch(_x_)
		{
			sTypeParam = 'all';
		}

		var iCurUserID = Child(0).Parent.id.Value;

		function getList(bCompleted)
		{
			return XQuery('for $elem in ' +(bCompleted ? 'learnings' : 'active_learnings')+ ' where $elem/person_id = ' + iCurUserID + ' return $elem');
		}
		switch (sTypeParam)
		{
			case 'active':
				return getList(false);
				break;
			case 'completed':
				return getList(true);
				break;
			case 'all':
			default:
				return ArrayUnion(getList(true), getList(false));
				break;
		}
	"/>

	<get_tests PROPERTY="1" PARAM="sTypeParam" EXPR="
		try
		{
			sTypeParam;
		}
		catch(_x_)
		{
			sTypeParam = 'all';
		}

		var iCurUserID = Child(0).Parent.id.Value;

		function getList(bCompleted)
		{
			return XQuery('for $elem in ' +(bCompleted ? 'test_learnings' : 'active_test_learnings')+ ' where $elem/person_id = ' + iCurUserID + ' return $elem');
		}
		switch (sTypeParam)
		{
			case 'active':
				return getList(false);
				break;
			case 'completed':
				return getList(true);
				break;
			case 'all':
			default:
				return ArrayUnion(getList(true), getList(false));
				break;
		}
	"/>

	<assign_course PROPERTY="1" PARAM="iCourseIDPARAM" PARAM="dStartPARAM" PARAM="dEndPARAM" PARAM="iEventIDPARAM" EXPR="
			try
			{
				Day(dStartPARAM);
			}
			catch(_x_)
			{
				dStartPARAM = null;
			}
			try
			{
				Day(dEndPARAM);
			}
			catch(_x_)
			{
				dEndPARAM = '';
			}
			try
			{
				iEventIDPARAM = Int(iEventIDPARAM);
			}
			catch(_x_)
			{
				iEventIDPARAM = null;
			}


			var iLearning = tools.activate_course_to_person(Child(0).Parent.id.Value, iCourseIDPARAM, iEventIDPARAM, Child(0).Parent, null, null, dStartPARAM, dEndPARAM);
			if (iLearning != null)
			{
				try
				{
					iLearning = iLearning.DocID;
				}
				catch(_X_)
				{
				}
			}
			return iLearning;
	"/>

	<assign_test PROPERTY="1" PARAM="iTestIDPARAM" PARAM="dStartPARAM" PARAM="dEndPARAM" PARAM="iEventIDPARAM" EXPR="
			try
			{
				Day(dStartPARAM);
