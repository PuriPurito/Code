<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<plugin>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	<block TYPE="string" FOREIGN-ARRAY="common.access_block_types" TITLE="const=c_block"/>
	<plugin_id TYPE="string" TITLE="const=plagin"/>
	<version TYPE="integer" TITLE="const=0zwsfpu9kg"/>
	
	<history_logs>
		<history_log MULTIPLE="1">
			<install_date TYPE="date" TITLE="const=y6ls8xn0ca"/>
			<version TYPE="integer" TITLE="const=0zwsfpu9kg"/>
			<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
		</history_log>
	</history_logs>
	

	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
		
	<view TEMP="1">
		<is_edit_mode TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
		<selector TYPE="string" NOT-NULL="1" DEFAULT="common" TEMP="1"/>	
	</view>
</plugin>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('plagin') + ': ' + plugin.name
"/>

</SPXML-FORM>