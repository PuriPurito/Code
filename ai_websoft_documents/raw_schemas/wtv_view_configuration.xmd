<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<view_configuration>
	<INHERIT TYPE="object_code_name_base"/>
<!--
+ Управление колонками в каждом инстансе – список доступных колонок, выбранные по умолчанию
+ Настройки форматирования колонок – цвета, ( ? шрифты, … )
++ Право изменять колонки из интерфейса (да/нет)
++ Включать preview по умолчанию (да/нет)
++ Возможность включать и выключить preview (да/нет)
+ Возможность включать категории (да/нет)
++ Категории включены по умолчанию (да/нет)
++ Возможность создавать категории (да/нет)
++ Возможность ли редактирование карточек в режиме preview (да/нет)
++ Разрешены ли связанные виды (да/нет)
* Управление списком связанных видов
+ Можно ли создавать новые объекты в виде (да/нет)
* Управление значениями полей «по умолчанию» при создании объектов из вида
++ Возможность использовать фильтры (да/нет)
+ Фильтр, применяемый по умолчанию
* Второй связанный вид (родительский)
* Включить второй вид (да/нет)
* Возможность создавать объекты второго вида (да/нет)
* Возможность открывать карточки из второго вида по двойному щелчку (да/нет)
++ Возможность открывать карточки из основного вида по двойному щелчку (да/нет)
++ Показ контекстного меню в виде (да/нет)
* Управление набором операций в контекстном меню (включая удаленные действия над объектами вида)
* Показывать блок показателей (информеров) над видом (да/нет)
* Управление набором показателей
* Показывать блок показателей (информеров) для объекта в панели preview (да/нет)
* Управление набором показателей для объекта
++ Способ поиска в виде – по каталогу/по полнотекстовому индексу/как в общих настройках
* Использовать коллекцию вместо вида (ссылка на коллекцию)
+ Условия выборки (query_qual)
* Использовать нестандартный XMS для preview – ссылка на шаблон
* Использовать нестандартный XMS для тайлов (основные сведения) – ссылка на шаблон
++ Параметры категоризации в виде – Возможна (да/нет)
-? Параметры категоризации в виде – схлопнут/расхлопнут по умолчанию, …
++ Управление текстовыми сообщениями – текст в пустом preview, сообщения о заполнении обязательных полей, …
-->
	<catalog_name TYPE="string" FOREIGN-ARRAY="common.exchange_object_types"/>

	<INHERIT TYPE="view_base"/>
	<link_name TYPE="string"/>

	<link_selector TYPE="string"/>

	<INHERIT TYPE="ms_view_configuration_base"/>

	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	
	<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" TITLE="const=4egocnh7uc"/>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
</view_configuration>


<DocDesc PROPERTY="1" EXPR="
		'Представление' + ': ' + view_configuration.name
"/>

<OnSave PROPERTY="1" EXPR="
	if ( GetOptCachedDoc( UrlFromDocID( TopElem.id ) ) != undefined )
	{
		ReplaceCachedDoc( UrlFromDocID( TopElem.id ), TopElem.Doc );
	}
"/>

</SPXML-FORM>