<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="successor">

<USE FORM="//wtv/wtv_general.xmd"/>
<successors>
	<successor MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		<key_position_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="key_positions" TITLE="const=klyuchevayadolzhno"/>
		<key_person_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
		<key_person_fullname TYPE="string" INDEXED="1" TITLE="const=sotrudniknaklyu"/>
		
		<person_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=preemnik"/>
		<person_position_name TYPE="string" TITLE="const=eli0ttzxol"/>
		
		
		<budget_period_id INDEXED="1" TYPE="integer" FOREIGN-ARRAY="budget_periods" TITLE="const=c_budget_period"/>
		<readiness_level_id INDEXED="1" TYPE="integer" FOREIGN-ARRAY="readiness_levels" TITLE="const=urovengotovnos"/>
		<development_potential_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="development_potentials" TITLE="const=potencialrazvi_9"/>
		<efficiency_estimation_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="efficiency_estimations" TITLE="const=ocenkaeffektiv"/>
		<request_id INDEXED="1" TYPE="integer" FOREIGN-ARRAY="requests" TITLE="const=c_request"/>
		
		<status TYPE="string" INDEXED="1" NOT-NULL="1" DEFAULT="active" FOREIGN-ARRAY="common.successor_status_types" TITLE="const=c_status"/>
		<INHERIT TYPE="admin_access_base"/>
		
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				
				if ( SrcDoc.TopElem.key_position_id.HasValue)
				{
					key_person_id=SrcDoc.TopElem.key_position_id.person_id
					key_person_fullname=SrcDoc.TopElem.key_position_id.person_fullname
				}
		"/>
	</successor>
</successors>


</SPXML-FORM>