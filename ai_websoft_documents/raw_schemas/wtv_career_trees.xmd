<?xml version="1.0" encoding="windows-1251"?>
<SPXML-FORM CATALOG="1" x-linked-catalogs="career_reserves">

<career_trees>
	<career_tree MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<current_position_name TYPE="string" TITLE="const=qbmk0k5672"/>
		<position_name TYPE="string" TITLE="const=vsb_purpose"/>
		<person_fullname TYPE="string" TITLE="const=lhbyv18qkm"/>
		<position_collaborator_fullname TYPE="string" TITLE="const=hkjld9msys"/>
		
	</career_tree>
</career_trees>

<OnBuildExt PROPERTY="1" EXPR="
		
		DeleteCatalogEntries( SrcDoc.DocID, 'id' );

		if (SrcDoc.TopElem.position_type != 'adaptation')
		{
			newSpot = AddCatalogEntry();

			newSpot.AssignElem( SrcDoc.TopElem );
			newSpot.id = SrcDoc.DocID;
			newSpot.position_name.Clear();

			newSpot.current_position_name = SrcDoc.TopElem.person_id.sd.position_name;
			newSpot.person_fullname = SrcDoc.TopElem.person_id.sd.fullname;
			newSpot.position_collaborator_fullname.Clear();
			switch ( SrcDoc.TopElem.position_type )
			{
				case 'name':
					newSpot.position_name = SrcDoc.TopElem.position_name;
					break;
				case 'position':
					newSpot.position_name = SrcDoc.TopElem.position_id.sd.name;
					newSpot.position_collaborator_fullname = SrcDoc.TopElem.position_id.sd.basic_collaborator_fullname;
					break;
				case 'position_common':
					newSpot.position_name = SrcDoc.TopElem.position_common_id.sd.name;
					break;
				case 'staff_position':
					newSpot.position_name = SrcDoc.TopElem.staff_position_id.sd.name;
					break;
				default:
					newSpot.position_name.Clear();
					break;
			}
			
			StoreCatalogEntry( newSpot );
		}
"/>

<MatchDocTypeExt PROPERTY="1" EXPR="
		SrcDoc.FormUrl == 'x-local://wtv/wtv_career_reserve.xmd'
"/>

<OnDeleteExt PROPERTY="1" EXPR="
		DeleteCatalogEntries( SrcDocID, 'id' );
"/>

</SPXML-FORM>