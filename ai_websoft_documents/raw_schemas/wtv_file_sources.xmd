<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="file_source">

<USE FORM="//wtv/wtv_general.xmd"/>

<file_sources>
	<file_source MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<category TYPE="string" TITLE="const=4egocnh7uc"/>
		<search_available TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=dostupenpoiskp"/>
		<selection_available TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=dostupenvyborf"/>

		<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
		<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

		<INHERIT TYPE="access_doc_base"/>
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				id.Parent.AssignElem( SrcDoc.TopElem.access );
		"/>
	</file_source>
</file_sources>

</SPXML-FORM>