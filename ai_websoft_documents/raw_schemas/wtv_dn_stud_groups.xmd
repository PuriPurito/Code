<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="dn_stud_group">

<USE FORM="//wtv/wtv_general.xmd"/>

<dn_stud_groups>
	<dn_stud_group MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		<stream_id TYPE="integer" FOREIGN-ARRAY="dn_streams" TITLE="ms_tools.get_const('potok')"/>
	    <status_id TYPE="string" DEFAULT="activ" FOREIGN-ARRAY="common.stud_group_states" TITLE="const=2uivot368w"/>
		<academ_year_id TYPE="integer" FOREIGN-ARRAY="dn_academ_years" TITLE=""/>
	    <special_id TYPE="integer" FOREIGN-ARRAY="dn_specials" TITLE=""/>
	    <specialization_id TYPE="integer" FOREIGN-ARRAY="dn_specializations" TITLE=""/>
        <qualification_id TYPE="integer" FOREIGN-ARRAY="qualifications" TITLE="const=c_qualification"/>
	
	    <faculty TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE="const=shy9bk42vy"/>
		<INHERIT TYPE="admin_access_base"/>
		<group_size TYPE="integer" TITLE=""/>
		
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				
		"/>
	</dn_stud_group>
</dn_stud_groups>

</SPXML-FORM>