<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<web_mode>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<is_default TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="По умолчанию для портала"/>
	<is_default_admin TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="По умолчанию для администратора"/>

	<catalog_name TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=c_object_type"/>
	<placeholder_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="Шаблон разметки"/>
	<web_design_id TYPE="integer" FOREIGN-ARRAY="web_designs" TITLE="const=k26170zag7"/>
	<site_id TYPE="integer" FOREIGN-ARRAY="sites" TITLE="const=sayt"/>

	<INHERIT TYPE="object_type_base"/>

	<access TITLE="const=bmlkskx7us">
		<INHERIT TYPE="access_doc_base"/>
	</access>
	
	<INHERIT TYPE="i18n_base"/>

	<INHERIT TYPE="func_managers_base"/>

	<INHERIT TYPE="web_variables_base"/>

	<template_links TITLE="Связи шаблонов">
		<template_link MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" EXPR-INIT="tools.random_string( 6 )" TITLE="ID"/>
			<type TYPE="string" DEFAULT="view" TITLE="const=c_type"/>
			<source_template_id TYPE="integer" FOREIGN-ARRAY="override_web_templates" TITLE="Элемент шаблона"/>
			<target_template_id TYPE="integer" FOREIGN-ARRAY="override_web_templates" TITLE="Элемент шаблона"/>
			<INHERIT TYPE="view_conditions_base"/>
		</template_link>
	</template_links>

	<statistic_recs TITLE="const=kaleydoskoppok">
		<statistic_rec MULTIPLE="1" PRIMARY-KEY="statistic_rec_id">
			<statistic_rec_id TYPE="integer" FOREIGN-ARRAY="statistic_recs" TITLE="ID"/>
			<INHERIT TYPE="web_variables_base"/>
		</statistic_rec>
	</statistic_recs>

	<is_std TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<postloading TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="##'Постзагрузка контента'##"/>
	<loading_instruction TYPE="string" TITLE="##'Инструкции загрузки'##"/>
	<use_fcache TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="##'Кеширование структуры'##"/>
	<searchable_portal TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="##'Доступна для поиска на портале'##"/>

	<doc_info TYPE="doc_info_base"/>

	<use_lpapi PROPERTY="1" EXPR="
			TopElem = Child(0).Parent;
			return ( TopElem.wvars.ChildNum != 0 );
	"/>
	<view TEMP="1">
		<sel_statistic_recs_id TYPE="string" TEMP="1"/>
	</view>

	<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" TITLE="const=4egocnh7uc"/>
</web_mode>


<OnSave PROPERTY="1" EXPR="
		tools.remove_fetch_doc( web_mode.id.Value );
"/>


<DocDesc PROPERTY="1" EXPR="
		'Тип страницы' + ': ' + web_mode.name
"/>

</SPXML-FORM>