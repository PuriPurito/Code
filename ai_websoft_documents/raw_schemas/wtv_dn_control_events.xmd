<?xml version="1.0" encoding="utf-8"?><SPXML-FORM CATALOG="1" OBJECT-NAME="dn_control_event"><USE FORM="//wtv/wtv_general.xmd"/><dn_control_events>	<dn_control_event MULTIPLE="1" PRIMARY-KEY="id">		<id TYPE="integer" INDEXED="1" TITLE="ID"/>		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>		<name TYPE="string" TITLE="const=c_name"/>	    <date_event TYPE="date" TITLE="const=vdb_aim_date"/>	    <status_id TYPE="string" FOREIGN-ARRAY="common.lesson_states" TITLE="const=2uivot368w"/>		<faculty_id TYPE="integer" FOREIGN-ARRAY="subdivisions" INDEXED="1" TITLE="const=shy9bk42vy"/>	    <chair_id TYPE="integer" FOREIGN-ARRAY="subdivisions" INDEXED="1"/>	    <discipl_id TYPE="integer" FOREIGN-ARRAY="dn_disciplines"/>        <lector_id TYPE="integer" FOREIGN-ARRAY="lectors" TITLE="const=c_lector"/>	    <control_form_id TYPE="integer" FOREIGN-ARRAY="dn_control_forms" TITLE="const=formaitogovogo"/>		    <lesson_id TYPE="integer" FOREIGN-ARRAY="dn_lessons"/>					<stream_id TYPE="integer" FOREIGN-ARRAY="dn_streams"/>		<stud_group_id TYPE="integer" FOREIGN-ARRAY="dn_stud_groups" TITLE="const=xg7kvxmhyi"/>			<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>		<INHERIT TYPE="admin_access_base"/>		<OnBuild PROPERTY="1" EXPR="				id.Parent.AssignElem( SrcDoc.TopElem );				modification_date = SrcDoc.TopElem.doc_info.modification.date;				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;		"/>			</dn_control_event>	</dn_control_events></SPXML-FORM>									