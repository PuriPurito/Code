<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="budget">

<USE FORM="//wtv/wtv_general.xmd"/>

<budgets>
	<budget MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		<is_approved TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=utverzhden"/>
		<type_id TYPE="integer" FOREIGN-ARRAY="budget_types" TITLE="const=tipbyudzheta"/>
		
		<state TYPE="string" FOREIGN-ARRAY="common.budget_state_types" TITLE="const=c_status"/>
		
		<INHERIT TYPE="cost_currency_base"/>
		
		<cost_center_id TYPE="integer" FOREIGN-ARRAY="cost_centers" INDEXED="1" TITLE="const=c_cost_center"/>
		<budget_period_id TYPE="integer" FOREIGN-ARRAY="budget_periods" INDEXED="1" TITLE="const=c_budget_period"/>
		<expense_item_id TYPE="integer" FOREIGN-ARRAY="expense_items" INDEXED="1" TITLE="const=c_expense_item"/>
		
		<INHERIT TYPE="admin_access_base"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</budget>
</budgets>

</SPXML-FORM>