<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="fact_payment">

<USE FORM="//wtv/ms_general.xmd"/>

<fact_payments>
	<fact_payment MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" TITLE="ID"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>

		<org_id TYPE="integer" FOREIGN-ARRAY="orgs" TITLE="const=c_org"/>
		<client_org_id TYPE="integer" FOREIGN-ARRAY="orgs" TITLE="const=klient"/>
		<agent_org_id TYPE="integer" FOREIGN-ARRAY="orgs" TITLE="##'Организация-партнер'##"/>

		<client_legal TYPE="string" TITLE="##'Юридическое лицо (клиент)'##"/>
		<provider_legal TYPE="string" TITLE="##'Юридическое лицо (поставщик)'##"/>
		<agent_legal TYPE="string" TITLE="##'Юридическое лицо (партнер)'##"/>

		<client_legal_name TYPE="string" TITLE="##'Юридическое лицо (клиент)'##"/>
		<provider_legal_name TYPE="string" TITLE="##'Юридическое лицо (поставщик)'##"/>
		<agent_legal_name TYPE="string" TITLE="##'Юридическое лицо (партнер)'##"/>

		<cost_currency_type_id TYPE="string" FOREIGN-ARRAY="lists.currency_types" TITLE="const=c_currency_type"/>
		<cost_value TYPE="real" TITLE="const=c_sum"/>

		<date TYPE="date" INDEXED="1" TITLE="const=c_date"/>
		<expense_id TYPE="integer" FOREIGN-ARRAY="expenses" TITLE="const=mn62xy3jdw"/>
		<comment TYPE="string" TITLE="const=vkpb_comment"/>
		
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
		"/>
	</fact_payment>
</fact_payments>

</SPXML-FORM>