<?xml version="1.0" encoding="utf-8"?><SPXML-FORM><USE FORM="//wtv/ms_general.xmd"/><dn_control_event>	<code TYPE="string" TITLE="const=c_code"/>	<name TYPE="string" TITLE="const=c_name"/>	<date_event TYPE="date" TITLE="const=vdb_aim_date"/>	<status_id TYPE="string" DEFAULT="plan" FOREIGN-ARRAY="common.lesson_states" TITLE=""/>	<faculty_id TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE=""/>	<chair_id TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE=""/>	<discipl_id TYPE="integer" FOREIGN-ARRAY="dn_disciplines" TITLE=""/>	<lector_id TYPE="integer" FOREIGN-ARRAY="lectors" TITLE="const=c_lector"/>	<control_form_id TYPE="integer" FOREIGN-ARRAY="dn_control_forms" TITLE=""/>	    <lesson_id TYPE="integer" FOREIGN-ARRAY="dn_lessons" TITLE=""/>			<desc TYPE="string" TITLE="const=c_desc"/>		<control_assessms TITLE="const=c_tests">		<control_assessm MULTIPLE="1" PRIMARY-KEY="assessm_id">			<assessm_id TYPE="integer" FOREIGN-ARRAY="assessments"/>		</control_assessm>	</control_assessms>		<stream_id TYPE="integer" FOREIGN-ARRAY="dn_streams" TITLE=""/>	<stud_group_id TYPE="integer" FOREIGN-ARRAY="dn_stud_groups" TITLE=""/>		<participants TITLE="const=c_members">		<participant MULTIPLE="1" PRIMARY-KEY="student_id">			<student_id TYPE="integer" FOREIGN-ARRAY="dn_students"/>		</participant>	</participants>		<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>		<INHERIT TYPE="admin_access_base"/>		<INHERIT TYPE="custom_elems_base"/>		<view TEMP="1">	    <INHERIT TYPE="desc_base"/>				<filter TEMP="1">			<INHERIT TYPE="au_ft_filter" TEMP="1"/>		</filter>	</view>	</dn_control_event><DocDesc PROPERTY="1" EXPR="		 ms_tools.get_const('kontrolnoemero') + ': ' +  dn_control_event.name;"/></SPXML-FORM>	