<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="digital_signature">

<USE FORM="//wtv/wtv_general.xmd"/>

<digital_signatures>
	<digital_signature MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>

		<person_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=preemnik"/>
		<person_position_name TYPE="string" TITLE="const=eli0ttzxol"/>

		<object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" INDEXED="1" TITLE="const=c_object_type"/>
		<object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( object_type + 's' )" INDEXED="1" TITLE="const=c_object"/>
		<object_name TYPE="string" INDEXED="1" TITLE="const=c_object_name"/>

		<create_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>
		<sign_date TYPE="date" INDEXED="1" TITLE="const=datapodpisaniya"/>

		<is_signed TYPE="bool" NOT-NULL="1" INDEXED="1" DEFAULT="false" TITLE="const=podpisana"/>

		<custom_web_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" INDEXED="1" TITLE="const=doc_template"/>

		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</digital_signature>
</digital_signatures>

</SPXML-FORM>