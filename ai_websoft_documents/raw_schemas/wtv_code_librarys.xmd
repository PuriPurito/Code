<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="code_library">

<USE FORM="//wtv/wtv_general.xmd"/>

<code_librarys>
	<code_library MULTIPLE="1" PRIMARY-KEY="id">
		<INHERIT TYPE="object_code_name_base"/>

		<code_type TYPE="string" TITLE="Тип программного кода"/>
		<code_url TYPE="string" TITLE="const=gwdslrn9x8"/>

		<associated_applications_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="applications" INDEXED="1" TITLE="##'Приложения'##"/>

		<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
		<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				id.Parent.AssignElem( SrcDoc.TopElem.exec_code );
				for( _application in SrcDoc.TopElem.associated_applications )
				{
					associated_applications_id.ObtainByValue( _application.PrimaryKey );
				}
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</code_library>
</code_librarys>

</SPXML-FORM>