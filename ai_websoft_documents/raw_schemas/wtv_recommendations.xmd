<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="recommendation">

<USE FORM="//wtv/wtv_general.xmd"/>

<recommendations>
	<recommendation MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<fullname TYPE="string" INDEXED="1" TITLE="const=c_fio"/>
		
		<phone TYPE="string" TITLE="const=uf_phone"/>
		<email TYPE="string" TITLE="E-mail"/>
		<work_phone TYPE="string" TITLE="const=dd2zo2k2mj"/>
		<mobile_phone TYPE="string" TITLE="const=emoqzexw7p"/>
		<status TYPE="string" INDEXED="1" FOREIGN-ARRAY="common.vacancy_response_status_types" TITLE="const=c_status"/>

		<vacancy_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="vacancys" TITLE="const=idvakansii"/>
		<vacancy_name TYPE="string"  TITLE="const=nazvanievakans"/>
		<src_person_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="collaborators" TITLE="const=c_person_send_recommendation"/>
		<src_person_fullname TYPE="string"  TITLE="const=lhbyv18qkm"/>
		
		<INHERIT TYPE="admin_access_base"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem, true );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</recommendation>
</recommendations>

</SPXML-FORM>