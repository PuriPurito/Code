	<calculate PROPERTY="1" PARAM="oParams" EXPR="
		var fldAAT, TopElem = Child(0).Parent;

		try
		{
			if (!TopElem.assessment_appraise_type.HasValue)
				throw 'empty';
			if (!TopElem.status.HasValue)
				throw 'empty2';
			fldAAT = OpenDoc(UrlFromDocID(TopElem.assessment_appraise_id)).TopElem.participants.GetChildByKey(TopElem.status).assessment_appraise_types.GetChildByKey(TopElem.assessment_appraise_type);
		}
		catch(_e_)
		{
			TopElem.overall.Clear();
			return;
		}

		try
		{
			oParams.HasProperty('a');
		}
		catch(_e_)
		{
			oParams = new Object;
		}

		var TOTAL = 0.0;
		var SUM = 0.0;
		var COUNT = 0;
		var MIN = null;
		var MAX = null;
		var NA_COUNT = 0;

		if (TopElem.assessment_appraise_type.Value == 'competence_appraisal')
		{
			function competence_pass_total_formula(SOURCE, EVAL_COLLECTION, FORMULA, EVAL_DEST)
			{


				var _obj, _cur_markk, _res;

				for (_obj in SOURCE.EvalPath(EVAL_COLLECTION))
				{
					if (_obj.mark == 'N')
					{
						NA_COUNT++;
						continue;
					}

					_cur_markk = _obj.mark_value;
					if (_obj.mark_value.HasValue)
						SUM += _cur_markk;

					if (_cur_markk != null)
					{
						COUNT++;
						TOTAL = TOTAL + _cur_markk * (OptReal(_obj.weight.Value, 0) / 100.0);
						if (MAX == null || MAX < _cur_markk) MAX = _cur_markk;
						if (MIN == null || MIN > _cur_markk) MIN = _cur_markk;
					}
				}

				_res = OptEval(FORMULA);
				//alert('TOTAL = ' + TOTAL +	'\n SUM = ' + SUM + '\n COUNT = ' + COUNT + '\n	MIN = ' + MIN + '\nMAX = ' + MAX + '\nNA_COUNT = ' + NA_COUNT);
				if (_res != undefined)
				for (sDestValField in String(EVAL_DEST).split(';'))
					SOURCE.EvalPath(sDestValField).Value = OptReal(StrReal(_res, 2),null);
			}

			if (oParams.GetOptProperty('competence_by_indicators') == true)
			{
				var _comp;
				for (_comp in TopElem.competences)
					competence_pass_total_formula(_comp, 'indicators', ( fldAAT.sub_formula.HasValue ? fldAAT.sub_formula.Value : 'TOTAL' ), 'mark;mark_value;mark_text');
			}

			if (Trim(fldAAT.formula.Value) == '')
			{
				fldAAT.formula.Value = 'TOTAL';
			}
			
			if (Trim(fldAAT.formula.Value) != '')
			{
				competence_pass_total_formula(TopElem, 'competences', fldAAT.formula.Value, 'overall');
			}
			else
			{
				TopElem.overall.Clear();
			}
		}
		else if (TopElem.assessment_appraise_type.Value == 'activity_appraisal' || TopElem.assessment_appraise_type.Value == 'staffrating')
		{
			var _fldKPI, _teKPI, FACT, PLAN, WEIGHT, _res;

			if (oParams.GetOptProperty('projects') == true)
			{
				var THRESHOLD, CHALLENGE;
				for (_fldKPI in TopElem.projects)
				{
					WEIGHT = (_fldKPI.weight.HasValue ? _fldKPI.weight.Value : 0);
					PLAN = OptReal(_fldKPI.plan.Value, null);
					FACT = OptReal(_fldKPI.fact.Value, null);
					THRESHOLD = OptReal(_fldKPI.threshold.Value, null);
					CHALLENGE = OptReal(_fldKPI.challenge.Value, null);

					_res = OptReal(OptEval( fldAAT.sub_formula.HasValue ? fldAAT.sub_formula.Value : 'FACT / PLAN'), null);
					_fldKPI.mark = _res;

					if (fldAAT.formula.HasValue)
					{
						if (_res != null)
						{
							COUNT++;
							SUM+= _res;
							TOTAL += _res * (WEIGHT / 100.0);
							if (MAX == null || MAX < _res) MAX = _res;
							if (MIN == null || MIN > _res) MIN = _res;
						}
						else
							NA_COUNT++;
					}
					else if (_res != null)
						TOTAL += _res * (WEIGHT / 100.0);

				}
				TopElem.overall = fldAAT.formula.HasValue ? OptEval(fldAAT.formula.Value,null) : TOTAL;
			}
			else
			{
				for (_fldKPI in TopElem.kpis)
				{
					try
					{
						_teKPI = OpenDoc(UrlFromDocID(_fldKPI.PrimaryKey)).TopElem;
					}
					catch(_e_)
					{
						continue;
					}

					switch(_teKPI.type.Value)
					{
						case 'calc':
						case 'auto':
							WEIGHT = (_fldKPI.weight.HasValue ? _fldKPI.weight.Value : 0);
							PLAN = OptReal(_fldKPI.plan.Value, null);
							FACT = OptReal(_fldKPI.fact.Value, null);
							_res = OptReal(OptEval( _teKPI.auto_formula.HasValue ? _teKPI.auto_formula.Value : 'FACT / PLAN'), null);
							_fldKPI.mark = _res;
							break;
						case 'input':
							_res = OptReal(_fldKPI.mark, null);
							break;
						case 'scale':
							_res = _teKPI.scales.GetOptChildByKey(_fldKPI.mark);
							if (_res != undefined)
								_res = _res.percent.HasValue ? _res.percent.Value : null;
							else
								_res = null;
							break;
						default:
							continue;
							break;
					}

					if (fldAAT.additional_formula.HasValue)
					{
						if (_res != null)
						{
							COUNT++;
							SUM+= _res;
							TOTAL += _res * (OptReal(_fldKPI.weight.Value, 0) / 100.0);
							if (MAX == null || MAX < _res) MAX = _res;
							if (MIN == null || MIN > _res) MIN = _res;
						}
						else
							NA_COUNT++;
					}
					else if (_res != null)
						TOTAL = TOTAL + _res * (OptReal(_fldKPI.weight.Value, 0) / 100.0);

				}

				TopElem.overall = fldAAT.additional_formula.HasValue ? OptEval(fldAAT.additional_formula.Value,null) : TOTAL;
			}
		}


		return TopElem.overall.Value;
	"/>

	<load_kpi_values PROPERTY="1" EXPR="
		var TopElem = Child(0).Parent;

		var catBudgetPeriod = TopElem.budget_period_id.OptForeignElem;

		var iObjectID = (TopElem.flag_appraise_department.Value ? TopElem.department_id.Value : TopElem.person_id.Value);
		if (iObjectID == null)
			return;

		var iKPIs = ArrayExtract(TopElem.kpis, 'This.PrimaryKey');
		var xarrKPIValues = XQuery('for $elem in kpi_values where $elem/object_id = ' + XQueryLiteral(iObjectID) + ' and MatchSome($elem/kpi_id, (' +ArrayMerge(iKPIs, 'This', ',')+ ')) return $elem');

		var aValues = new Array();
		var dStart = TopElem.period_start.Value;
		var	dEnd = TopElem.period_end.Value;
		if (catBudgetPeriod != undefined)
		{
			aValues = ArraySelectByKey(xarrKPIValues, catBudgetPeriod.PrimaryKey.Value, 'budget_period_id');
			if (dStart == null) dStart = catBudgetPeriod.start_date.Value;
			if (dEnd == null) dEnd = catBudgetPeriod.finish_date.Value;
		}
		if (dStart != null || dEnd != null)
		{
			if (dStart != null) dStart = DateNewTime(dStart);
			if (dEnd != null) dEnd = DateNewTime(dEnd);

			xarrKPIValues = ArraySelect(xarrKPIValues, (catBudgetPeriod != undefined ? '!This.budget_period_id.HasValue && ' : '') + '(dStart != null && This.start_date.HasValue && dStart >= DateNewTime(This.start_date.Value) || dEnd != null && This.end_date.HasValue && dEnd <= DateNewTime(This.end_date.Value))');

			aValues = ArrayUnion(aValues, xarrKPIValues);
		}

		var fldKPI, catValue, teKPI, fldScale;
		for (fldKPI in TopElem.kpis)
		{
			catValue = ArrayOptFindByKey(aValues, fldKPI.PrimaryKey.Value, 'kpi_id');
			if (catValue != undefined)
			{
				fldKPI.fact = catValue.fact;
				if (catValue.value.HasValue)
				{
					teKPI = OpenDoc(UrlFromDocID(fldKPI.PrimaryKey)).TopElem;
					if (teKPI.type == 'scale')
					{
						fldScale = teKPI.scales.GetOptChildByKey(catValue.value, 'percent');
						if (fldScale != undefined)
							fldKPI.mark = fldScale.PrimaryKey;
					}
					else
						fldKPI.mark = catValue.value;
				}
				else
						fldKPI.mark = catValue.value;
			}
		}
	"/>

</pa>


<OnBeforeSave PROPERTY="1" EXPR="
		try
		{
			if ( TopElem.workflow_id.HasValue &amp;&amp; ! TopElem.is_workflow_init )
			{
				workflowDoc = OpenDoc( UrlFromDocID( TopElem.workflow_id ) ).TopElem;
				TopElem.workflow_state = workflowDoc.default_state;
				TopElem.workflow_state_name = TopElem.get_workflow_state_name( workflowDoc );

				if ( workflowDoc.default_action.HasValue )
					tools.workflow_action_process( TopElem.Doc, workflowDoc.default_action, TopElem.workflow_id, workflowDoc, null, false );

				TopElem.is_workflow_init = true;
			}
		}
		catch ( _err_ )
		{
			alert('ERROR ONBEFORE PA SAVE: ' + _err_);
		}

		if	(pa.flag_appraise_department)
			pa.person_id.Clear();
		else
			pa.department_id.Clear();
			
		if ( TopElem.person_id.HasValue &amp;&amp; ! TopElem.person_id.sd.fullname.HasValue )
		{
			tools_ass.assessment_person_filling( TopElem.person_id, TopElem.person_id.Value );
		}
		if ( TopElem.expert_person_id.HasValue &amp;&amp; ! TopElem.expert_person_id.sd.fullname.HasValue )
		{
			tools_ass.assessment_person_filling( TopElem.expert_person_id, TopElem.expert_person_id.Value );
		}
		
		docPa = TopElem.Doc;
		iPaID = docPa.DocID
		
		ms_tools.raise_system_event_env( 'common_pa_save', {
			'curUser': tools.get_cur_user(),
			'curUserID': tools.get_cur_user_id(),
			'iPaID': iPaID,
			'docPa': docPa,
		} );
		
		if ( TopElem.is_done != TopElem.last_data.is_done )
		{
			TopElem.last_data.is_done = TopElem.is_done;
			if (tools_web.is_true(TopElem.is_done))
			{
				ms_tools.raise_system_event_env( 'common_pa_done', {
					'curUser': tools.get_cur_user(),
					'curUserID': tools.get_cur_user_id(),
					'iPaID': iPaID,
					'docPa': docPa,
				} );
			}
		}
		
		if ( TopElem.workflow_state != TopElem.last_data.workflow_state )
		{
			TopElem.last_data.workflow_state = TopElem.workflow_state;

			ms_tools.raise_system_event_env( 'common_pa_wfstate_change', {
				'curUser': tools.get_cur_user(),
				'curUserID': tools.get_cur_user_id(),
				'iPaID': iPaID,
				'docPa': docPa,
			} );
		}
"/>




<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('wrj18njror') + ': ' + pa.name
"/>

</SPXML-FORM>