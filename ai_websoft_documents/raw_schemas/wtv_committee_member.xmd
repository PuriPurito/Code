<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<committee_member>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>

	<catalog TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" INDEXED="1" TITLE="const=c_object_type" NOT-NULL="1" DEFAULT="collaborator"/>
	<object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( catalog + 's' )" INDEXED="1" TITLE="const=c_object"/>	
	<object_name TYPE="string" INDEXED="1" TITLE="const=c_object_name"/>
	<boss_type_id TYPE="integer" FOREIGN-ARRAY="boss_types" TITLE="const=c_role"/>
	<committee_member_type TYPE="string" NOT-NULL="1" DEFAULT="participant" FOREIGN-ARRAY="common.committee_member_types" TITLE="const=tipuchastnikapr"/>
	<status TYPE="string" NOT-NULL="1" DEFAULT="not_confirmed" FOREIGN-ARRAY="common.committee_member_status_types" TITLE="const=c_status"/>
	<personnel_committee_id TYPE="integer" FOREIGN-ARRAY="personnel_committees" TITLE="Кадровый комитет"/>

	<INHERIT TYPE="file_list_base"/>

	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base"/>

	<access TITLE="const=bmlkskx7us">
		<INHERIT TYPE="access_doc_base"/>
	</access>
	<INHERIT TYPE="admin_access_base"/>

	<INHERIT TYPE="custom_elems_base"/>

	<view TEMP="1">
		<INHERIT TYPE="desc_base"/>
	</view>

</committee_member>

<DocDesc PROPERTY="1" EXPR="
		'Участник кадрового комитета' + ': ' + committee_member.object_name
"/>

</SPXML-FORM>