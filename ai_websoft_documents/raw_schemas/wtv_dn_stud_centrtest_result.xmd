<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<dn_stud_centrtest_result>
    <subject TYPE="string"/>
	<mark TYPE="integer" TITLE="const=veresb_score"/>
	<result_date TYPE="date" TITLE="const=vdb_aim_date"/>
	
	<student_id TYPE="integer" FOREIGN-ARRAY="dn_students" TITLE="ms_tools.get_const('siwbxij6vi')"/>
	<student_fullname TYPE="string"/>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	
    <INHERIT TYPE="admin_access_base"/>
	
	<INHERIT TYPE="custom_elems_base"/>
	
	<view TEMP="1">
		<filter TEMP="1">
			<INHERIT TYPE="au_ft_filter" TEMP="1"/>
		</filter>
		<INHERIT TYPE="desc_base"/>
	</view>
	
</dn_stud_centrtest_result>

<DocDesc PROPERTY="1" EXPR="
		 ms_tools.get_const('rezultatege') + ': ' +  dn_stud_centrtest_result.subject;
"/>

</SPXML-FORM>

	
