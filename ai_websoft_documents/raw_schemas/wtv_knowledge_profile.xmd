<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<knowledge_profile>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>	
	<resource_id TYPE="integer" FOREIGN-ARRAY="resources" TITLE="const=c_resource"/>
	<knowledge_parts TITLE="const=vkpb_knowledge_parts_title">
		<knowledge_part MULTIPLE="1" PRIMARY-KEY="knowledge_part_id">
			<knowledge_part_id TYPE="integer" FOREIGN-ARRAY="knowledge_parts"/>
			<name TYPE="string"/>
			<target_level_id TYPE="string" TITLE="##'Целевой уровень'##"/>
			<target_level_index TYPE="integer" TITLE="##'Индекс целевого уровня'##"/>
			<target_level_name TYPE="string" TITLE="##'Целевой уровень'##"/>
		</knowledge_part>
	</knowledge_parts>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
		
	<view TEMP="1">
		<selector TYPE="string" NOT-NULL="1" DEFAULT="common" TEMP="1"/>	
	</view>
</knowledge_profile>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('jxftsoncpe') + ': ' + knowledge_profile.name
"/>

</SPXML-FORM>