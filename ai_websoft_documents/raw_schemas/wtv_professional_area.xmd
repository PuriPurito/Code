<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<professional_area>

	<INHERIT TYPE="object_code_name_base"/>

	<parent_id TYPE="integer" FOREIGN-ARRAY="professional_areas" TITLE="const=kornevoyelement"/>
	<professional_area_type_id TYPE="integer" FOREIGN-ARRAY="professional_area_types" TITLE="Тип профессиональной области"/>

	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

	<INHERIT TYPE="file_list_base"/>

	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base"/>

	<access TITLE="const=bmlkskx7us">
		<INHERIT TYPE="access_doc_base"/>
	</access>
	<INHERIT TYPE="admin_access_base"/>

	<INHERIT TYPE="custom_elems_base"/>

	<view TEMP="1">
		<INHERIT TYPE="desc_base"/>
	</view>

</professional_area>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('vrb_professional_field') + ': ' + professional_area.object_name
"/>

</SPXML-FORM>