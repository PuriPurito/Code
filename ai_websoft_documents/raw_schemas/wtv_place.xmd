<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<place>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	
	<parent_id TYPE="integer" FOREIGN-ARRAY="places" TITLE="const=gth4chds1g"/>
	<region_id TYPE="integer" FOREIGN-ARRAY="regions" TITLE="const=vrb_region"/>
	<timezone_id TYPE="integer" FOREIGN-ARRAY="common.timezones" TITLE="'Временные зоны'"/>
	<address TYPE="string" TITLE="const=uf_address"/>
	
	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	
	<INHERIT TYPE="file_list_base"/>
	
	<INHERIT TYPE="admin_access_base"/>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	
	<view TEMP="1">
		<INHERIT TYPE="desc_base"/>
	</view>

	<INHERIT TYPE="custom_elems_base"/>

</place>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('c_place') + ': ' + place.name
"/>

</SPXML-FORM>