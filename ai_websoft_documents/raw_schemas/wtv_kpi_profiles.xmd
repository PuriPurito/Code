<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" HIER="1" PARENT-ID-ELEM="parent_kpi_profile_id" OBJECT-NAME="kpi_profile">

<USE FORM="//wtv/wtv_general.xmd"/>

<kpi_profiles>
	<kpi_profile MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>

		<competence_profile_family_id TYPE="integer" FOREIGN-ARRAY="competence_profile_familys" INDEXED="1" TITLE="const=a3ys523cg4"/>
		
		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>
		<parent_kpi_profile_id TYPE="integer" FOREIGN-ARRAY="kpi_profiles" TITLE="const=ass_kpi_profileparent"/>
		<kpi_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="kpis" TITLE="const=kpe"/>
		
		<knowledge_parts TYPE="string" TITLE="const=vkpb_knowledge_parts_title"/>
		<tags TYPE="string" TITLE="##'ID тегов'##"/>
		<experts TYPE="string" TITLE="const=vkpb_experts"/>
		
		<workflow_id TYPE="integer" FOREIGN-ARRAY="workflows" TITLE="const=vw_title"/>
		<workflow_state TYPE="string" INDEXED="1" TITLE="const=c136i4h31p"/>
		<workflow_state_name TYPE="string" INDEXED="1" TITLE="const=ld9m4gsmfn"/>
		<workflow_person_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<workflow_matching_type TYPE="string" TITLE="const=c136i4h31q"/>
		<workflow_main_person_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>
		
		<INHERIT TYPE="admin_access_base"/>
		
		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				
				for (fldKPIElem in SrcDoc.TopElem.kpis)
					kpi_id.Add().Value = fldKPIElem.PrimaryKey;
					
				knowledge_parts = ArrayMerge(SrcDoc.TopElem.knowledge_parts, 'This.PrimaryKey', ';');
				tags = ArrayMerge(SrcDoc.TopElem.tags, 'This.PrimaryKey', ';');
				experts = ArrayMerge(SrcDoc.TopElem.experts, 'This.PrimaryKey', ';');
		"/>
	</kpi_profile>
</kpi_profiles>

</SPXML-FORM>