<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="vacation_day">

<USE FORM="//wtv/ms_general.xmd"/>

<vacation_days>
	<vacation_day MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<person_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
		<INHERIT TYPE="person_filling_base"/>
		<org_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="orgs" TITLE="const=c_org"/>
		<org_code TYPE="string" INDEXED="1" TITLE="const=it3zztxhz4"/>
		<update_date TYPE="date" INDEXED="1" TITLE="const=dataizmeneniya"/>
		<balance TYPE="real" TITLE="const=vbrb_remainder"/>
		
		<INHERIT TYPE="admin_access_base"/>

		<creation_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>
		<creation_user_id TYPE="integer" TITLE="const=wrm4ebg7c9"/>
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<modification_user_id TYPE="integer" TITLE="const=wrm4ebg7c9"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
			id.Parent.AssignElem( SrcDoc.TopElem, true );

			fldDocInfo = SrcDoc.TopElem.doc_info;
			creation_date = fldDocInfo.creation.date;
			creation_user_id = fldDocInfo.creation.user_id;
			modification_date = fldDocInfo.modification.date;
			modification_user_id = fldDocInfo.modification.user_id;
			app_instance_id = fldDocInfo.creation.app_instance_id;
		"/>

	</vacation_day>
</vacation_days>

</SPXML-FORM>