<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="working_condition">

<USE FORM="//wtv/wtv_general.xmd"/>

<working_conditions>
	<working_condition MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
		<INHERIT TYPE="person_filling_base"/>
		<is_model TYPE="bool" TITLE="##'Эталонное условие работы'##"/>
		<state_id TYPE="string" NOT-NULL="1" DEFAULT="0" FOREIGN-ARRAY="common.working_condition_states" INDEXED="1" TITLE="const=vppb_state"/>
		
		<start_date TYPE="date" TIME="0" INDEXED="1" TITLE="const=c_start_date"/>
		<finish_date TYPE="date" TIME="0" INDEXED="1" TITLE="const=3bywib72ya"/>
		
		<probationary_duration TYPE="integer" TITLE="##'Длительность испытательного срока (месяцев)'##"/>
		<position_name TYPE="string" TITLE="const=g89skt4yui"/>
		<place_name TYPE="string" TITLE="##'Место работы'##"/>
		<place_id TYPE="integer" FOREIGN-ARRAY="places" TITLE="const=c_place"/>
		<working_condition_type_id TYPE="integer" FOREIGN-ARRAY="working_condition_types" TITLE="##'Тип условиий труда'##"/>
		<salary_payment_type_id TYPE="integer" FOREIGN-ARRAY="salary_payment_types" TITLE="##'Тип графика выплат заработной платы'##"/>
		<work_form_id TYPE="integer" FOREIGN-ARRAY="work_forms" TITLE="##'Форма работы'##"/>
		<payment_remuneration TYPE="string" DEFAULT="salary" TITLE="##'Выплата вознаграждения'##"/>
		
		<salary TYPE="integer" TITLE="const=oklad"/>
		<currency_type_id TYPE="string" FOREIGN-ARRAY="lists.currency_types" DEFAULT="RUB" TITLE="const=c_currency_type"/>

		<work_schedule_type_id TYPE="integer" FOREIGN-ARRAY="work_schedule_types" TITLE="##'Тип графика работы'##"/>
		<daily_duration TYPE="integer" TITLE="##'Продолжительность ежедневной работы (смены) в часах'##"/>
		<weekly_duration TYPE="integer" TITLE="##'Продолжительность рабочей недели (в часах)'##"/>
		<start_work_type TYPE="string" TITLE="##'Время начала работы'##"/>
		<start_work_time TYPE="string" DEFAULT="09:00" TITLE="##'Время начала работы'##"/>
		<end_work_time TYPE="string" DEFAULT="18:00" TITLE="##'Время окончания работы'##"/>
		
		<lunch_break_duration TYPE="real" TITLE="##'Длительность обеденного перерыва'##"/>
		<lunch_break_type TYPE="string" TITLE="##'Тип обеденного перерыва'##"/>
		<start_lunch_break_time TYPE="string" DEFAULT="09:00" TITLE="##'Время начала обеденного перерыва'##"/>
		<end_lunch_break_time TYPE="string" DEFAULT="18:00" TITLE="##'Время окончания обеденного перерыва'##"/>
		<shifts_number TYPE="integer" TITLE="##'Число смен в сутки'##"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>
		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</working_condition>
</working_conditions>

</SPXML-FORM>