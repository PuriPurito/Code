<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="submission">

<USE FORM="//wtv/wtv_general.xmd"/>

<submissions>
	<submission MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<submission_type_id TYPE="integer" FOREIGN-ARRAY="submission_types" INDEXED="1" TITLE="const=c_submission_type"/>
		<submission_type_name TYPE="string" TITLE="const=bpqjaq06wv"/>
		<period_date_start TYPE="date" TIME="0" TITLE="const=c_period_date_start"/>
		<period_date_finish TYPE="date" TIME="0" TITLE="const=c_period_date_finish"/>
		<phase_name TYPE="string" TITLE="const=c_phase"/>
		<phase_id TYPE="integer" TITLE="const=c_phase"/>
		<status_id TYPE="string" NOT-NULL="1" DEFAULT="plan" FOREIGN-ARRAY="common.submission_states" TITLE="const=c_status"/>

		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<INHERIT TYPE="person_filling_base"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>

	</submission>
</submissions>

</SPXML-FORM>