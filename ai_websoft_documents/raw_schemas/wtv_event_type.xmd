<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<event_type>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	<custom_web_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="##'Шаблон карточки на портале'##"/>
	<simpl_custom_web_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="##'Шаблон упрощенной карточки на портале'##"/>
	
	<online TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="##'Мероприятие online'##"/>
	<auto_start TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="##'Автоматический запуск мероприятия при входе'##"/>
	<can_use_camera TYPE="bool" DEFAULT="false"/>
	<can_use_microphone TYPE="bool" DEFAULT="false"/>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>

	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>

	<INHERIT TYPE="custom_elems_base"/>
	
	<INHERIT TYPE="admin_access_base"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
</event_type>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('9il1vjwtjw') + ': ' + event_type.name
"/>

</SPXML-FORM>