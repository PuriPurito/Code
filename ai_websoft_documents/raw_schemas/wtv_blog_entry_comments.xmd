<?xml version="1.0" encoding="utf-8"?>
<!-- copy to @component blogs_mng  -->
<SPXML-FORM CATALOG="1" HIER="1" PARENT-ID-ELEM="parent_id" OBJECT-NAME="blog_entry_comment">

<USE FORM="//wtv/wtv_general.xmd"/>

<blog_entry_comments>
	<blog_entry_comment MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<create_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>
		<blog_entry_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( object_type + 's' )" INDEXED="1" TITLE="const=c_blog_entry"/>
		<object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" DEFAULT="blog_entry" TITLE="const=c_object_type"/>
		<object_name TYPE="string" TITLE="const=j2xkyixyrs"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" TITLE="const=lhbyv18qkm"/>
		<creator_name TYPE="string" INDEXED="1" TITLE="const=88cnbbrh3a"/>
		<message TYPE="string" TITLE="const=7zen195nnp"/>
		<parent_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="blog_entry_comments" TITLE="const=hkjvnjrkci"/>
		<like_id TYPE="integer" FOREIGN-ARRAY="likes" TITLE="const=ass_mark"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem, true );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				//message = StrLeftCharRange(UnifySpaces(HtmlToPlainText(SrcDoc.TopElem.message)),140);
				message = UnifySpaces(HtmlToPlainText(SrcDoc.TopElem.message));
		"/>
	</blog_entry_comment>
</blog_entry_comments>

</SPXML-FORM>