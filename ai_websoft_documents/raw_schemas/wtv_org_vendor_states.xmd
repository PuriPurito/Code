<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="org_vendor_state">

<USE FORM="//wtv/wtv_general.xmd"/>

<org_vendor_states>
	<org_vendor_state MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		
		<vendor_status_id TYPE="integer" FOREIGN-ARRAY="vendor_states" TITLE="const=statusvendora"/>	
		<education_org_id TYPE="integer" FOREIGN-ARRAY="education_orgs" TITLE="const=8ep5fzi6uu"/>	
		<org_id TYPE="integer" FOREIGN-ARRAY="orgs" TITLE="const=c_org"/>
		
		<vendor_status_type_id TYPE="string" FOREIGN-ARRAY="common.vendor_status_types" NOT-NULL="1" DEFAULT="assigned" TITLE="const=vppb_state"/>	
		
		<start_date TYPE="date" TITLE="const=c_start_date"/>
		<recertification_date TYPE="date" TITLE="const=c_finish_date"/>
		
		<INHERIT TYPE="admin_access_base"/>
		
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				
		"/>
	</org_vendor_state>
</org_vendor_states>

</SPXML-FORM>