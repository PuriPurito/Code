<?xml version="1.0" encoding="utf-8"?>
<!-- copy to @component blogs_mng  -->
<SPXML-FORM CATALOG="1" OBJECT-NAME="blog_entry">

<USE FORM="//wtv/wtv_general.xmd"/>

<blog_entrys>
	<blog_entry MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		<type TYPE="string" TITLE="const=c_type"/>
		<create_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>

		<allow_comment TYPE="bool" TITLE="const=m2koi3tmrj"/>
		<blocked TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=zablokirovano"/>

		<labels TYPE="string" TITLE="const=9cfy4glyfb"/>

		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=vfb_author"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=27yeo2gz3r"/>

		<blog_id TYPE="integer" FOREIGN-ARRAY="blogs" INDEXED="1" TITLE="const=c_blog"/>
		<feed_item_id TYPE="string" INDEXED="1" TITLE="ID статьи в ленте"/>
		<object_id TYPE="integer" INDEXED="1" TITLE="const=c_object"/>

		<comment_num TYPE="integer" TITLE="const=8ndbe2lr2o"/>

		<knowledge_parts TYPE="string" TITLE="const=vkpb_knowledge_parts_title"/>
		<tags TYPE="string" TITLE="##'ID тегов'##"/>
		<experts TYPE="string" TITLE="const=vkpb_experts"/>

		<INHERIT TYPE="access_doc_base"/>

		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				knowledge_parts = ArrayMerge(SrcDoc.TopElem.knowledge_parts, 'This.PrimaryKey', ';');
				tags = ArrayMerge(SrcDoc.TopElem.tags, 'This.PrimaryKey', ';');
				experts = ArrayMerge(SrcDoc.TopElem.experts, 'This.PrimaryKey', ';');

				id.Parent.AssignElem( SrcDoc.TopElem.access );
		"/>

	</blog_entry>
</blog_entrys>

</SPXML-FORM>