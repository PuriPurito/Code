<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="personnel_reserve">

<USE FORM="//wtv/wtv_general.xmd"/>

<personnel_reserves>
	<personnel_reserve MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<status TYPE="string" INDEXED="1" FOREIGN-ARRAY="common.personnel_reserve_status_types" TITLE="const=c_status"/>
		<career_reserve_type_id INDEXED="1" TYPE="integer" FOREIGN-ARRAY="career_reserve_types" TITLE="const=tipkadrovogore"/>
		<exclusion_reason_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="exclusion_reasons" TITLE="const=osnovaniedlyais"/>
		<nomination_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="talent_pool_nominations" TITLE="const=sposobvydvizhen"/>
		<development_potential_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="development_potentials" TITLE="const=potencialrazvi_9"/>
		<efficiency_estimation_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="efficiency_estimations" TITLE="const=ocenkaeffektiv"/>
		
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=lhbyv18qkm"/>
		<person_position_name TYPE="string" INDEXED="1" TITLE="const=ixr5rs3b76"/>
		
		<start_date TYPE="date" INDEXED="1" TITLE="const=y6ls8xn0ca"/>
		<include_reserve_date TYPE="date" INDEXED="1" TITLE="const=datavklyucheniyav"/>
		<finish_date TYPE="date" INDEXED="1" TITLE="const=c_close_date"/>
		
		<INHERIT TYPE="admin_access_base"/>
		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>
		
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				
				person_fullname = SrcDoc.TopElem.person_id.sd.fullname;
				person_position_name = SrcDoc.TopElem.person_id.sd.position_name;
		"/>
	</personnel_reserve>
</personnel_reserves>


</SPXML-FORM>