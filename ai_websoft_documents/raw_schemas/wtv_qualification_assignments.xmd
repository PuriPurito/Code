<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="qualification_assignment">

<USE FORM="//wtv/wtv_general.xmd"/>

<qualification_assignments>
	<qualification_assignment MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		
		<assignment_date TYPE="date" INDEXED="1" TITLE="const=c_qualif_ass_date"/>
		<expiration_date  TYPE="date" INDEXED="1" TITLE="const=c_qualif_end_date"/>
		<status TYPE="string" FOREIGN-ARRAY="common.qualification_assignment_states" NOT-NULL="1" DEFAULT="assigned" TITLE="const=c_status"/>
		<qualification_id TYPE="integer" FOREIGN-ARRAY="qualifications" INDEXED="1" TITLE="const=c_qualification"/>	
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<sender_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=otpravitel"/>
		<competence_id TYPE="integer" FOREIGN-ARRAY="competences" INDEXED="1" TITLE="const=ass_competence"/>
		<reason TYPE="string" TITLE="const=kc32vvfwg2"/>
		<event_id TYPE="integer" FOREIGN-ARRAY="events" TITLE="const=c_event"/>
		<is_reward TYPE="bool" TITLE="##'Является наградой'##"/>
		<INHERIT TYPE="person_filling_base"/>
		
		<INHERIT TYPE="admin_access_base"/>
		
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				
		"/>
	</qualification_assignment>
</qualification_assignments>

</SPXML-FORM>