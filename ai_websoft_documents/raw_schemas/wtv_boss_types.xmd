<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="boss_type">

<boss_types>
	<boss_type MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>

		<operations TYPE="string" TITLE="const=s9w32fds9k"/>

		<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
		<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<object_type MULTIPLE="1" TYPE="string" FOREIGN-ARRAY="common.exchange_object_types"/>
		<operation_id MULTIPLE="1" TYPE="string" FOREIGN-ARRAY="operations"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				operations = ArrayMerge(SrcDoc.TopElem.operations , 'This.PrimaryKey', ';');

				for (fldOTElem in SrcDoc.TopElem.object_types)
					object_type.Add().Value = fldOTElem.PrimaryKey;
				for (fldOTElem in SrcDoc.TopElem.operations)
					operation_id.Add().Value = fldOTElem.PrimaryKey;

		"/>
	</boss_type>
</boss_types>

</SPXML-FORM>