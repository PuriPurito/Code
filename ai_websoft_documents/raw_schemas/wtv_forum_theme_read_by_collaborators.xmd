<?xml version="1.0" encoding="windows-1251"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="forum_theme_read_by_collaborator">

<USE FORM="//wtv/wtv_general.xmd"/>

<forum_theme_read_by_collaborators>
	<forum_theme_read_by_collaborator MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1"/>
		<forum_id TYPE="integer" FOREIGN-ARRAY="forums" INDEXED="1"/>
		<forum_theme_id TYPE="integer" FOREIGN-ARRAY="forum_entrys" INDEXED="1"/>
		<date TYPE="date" EXPR-INIT="Date()"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</forum_theme_read_by_collaborator>
</forum_theme_read_by_collaborators>

</SPXML-FORM>