<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<rating>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=c_object_type"/>
	<date TYPE="date" TITLE="const=vdb_aim_date"/>

	<expert_person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=mkwzmalbrv">
		<INHERIT TYPE="ms_person_sd_inner_base"/>
	</expert_person_id>

	<status TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=c_status"/>

	<objects TITLE="const=whqdx78mre">
		<object MULTIPLE="1" PRIMARY-KEY="object_id">
			<object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( object_type + 's' )"/>
			<object_name TYPE="string" TITLE="const=c_object_name"/>
		</object>
	</objects>

	<INHERIT TYPE="admin_access_base"/>

	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
</rating>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('c_rating') + ' - ' + rating.name;
"/>

</SPXML-FORM>