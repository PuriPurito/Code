<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<system_event>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	<type TYPE="string" TITLE="const=c_type"/><!-- admin, server -->
	<desc TYPE="string" TITLE="const=c_desc"/>

	<linked_system_event_id TYPE="integer" FOREIGN-ARRAY="system_events" TITLE="const=v7jtcfmes4"/>

	<perfom_condition TYPE="string" STORE-SECTION="cdata" TITLE="const=648rt373e5"/>
	<is_active TYPE="bool" NOT-NULL="1" DEFAULT="true" TITLE="const=drj1mfrxat"/>

	<sections TITLE="const=mlf4djx5b4">
		<section MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" EXPR-INIT="tools.random_string(5)"/>
			<name TYPE="string" TITLE="const=3izwygorc8"/>
			<perfom_condition TYPE="string" STORE-SECTION="cdata" TITLE="const=648rt373e5"/>
			<actions>
				<action MULTIPLE="1" PRIMARY-KEY="id">
					<id TYPE="string" EXPR-INIT="tools.random_string(5)"/>
					<type TYPE="string" FOREIGN-ARRAY="common.system_event_operation_types"/>
					<eval_str TYPE="string" STORE-SECTION="cdata"/>
					<notification_id TYPE="integer" FOREIGN-ARRAY="notifications"/>
					<print_form_id TYPE="integer" FOREIGN-ARRAY="print_forms"/>
					<activity_id TYPE="integer" FOREIGN-ARRAY="activitys"/>
					<log_eval_str TYPE="string"/>
					<operation_id TYPE="integer" FOREIGN-ARRAY="operations">
						<INHERIT TYPE="ms_parameters_base"/>
					</operation_id>
				</action>
			</actions>
		</section>
	</sections>

	<INHERIT TYPE="ms_variables_base"/>

	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>

	<view TEMP="1">
		<filter TEMP="1">
			<INHERIT TYPE="au_ft_filter" TEMP="1"/>
		</filter>
		<INHERIT TYPE="desc_base"/>
	</view>

	<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" TITLE="const=4egocnh7uc"/>
</system_event>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('lm0vvsk9uw') + ': ' + system_event.name
"/>

</SPXML-FORM>