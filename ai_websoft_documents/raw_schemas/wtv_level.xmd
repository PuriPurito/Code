<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<level>
	<INHERIT TYPE="object_code_name_base"/>
	<prev_level_id TYPE="integer" FOREIGN-ARRAY="levels" TITLE="'Предыдущий уровень'"/>
	
	<currency_type_id TYPE="string" FOREIGN-ARRAY="lists.currency_types" TITLE="const=c_currency_type"/>
	<min_value TYPE="real"/>
	<max_value TYPE="real"/>
	<currency_types TITLE="const=c_currency_type">
		<currency_type MULTIPLE="1" PRIMARY-KEY="currency_type_id">
			<currency_type_id TYPE="string" FOREIGN-ARRAY="lists.currency_types" TITLE="const=c_currency_type"/>
			<min_value TYPE="real"/>
			<max_value TYPE="real"/>
		</currency_type>
	</currency_types>
	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base"/>

	<view TEMP="1">
		<INHERIT TYPE="desc_base"/>
	</view>
</level>

<OnInit PROPERTY="1" EXPR="
		if( ArrayOptFirstElem( TopElem.currency_types ) == undefined && ( TopElem.currency_type_id.HasValue || TopElem.min_value.HasValue || TopElem.max_value.HasValue ) )
		{
			_child = TopElem.currency_types.ObtainChildByKey( TopElem.currency_type_id );
			_child.AssignElem( TopElem );
		}
"/>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('ela6vna8le') + ': ' + TopElem.name
"/>

</SPXML-FORM>