<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="statement_object">

<USE FORM="//wtv/wtv_general.xmd"/>

<statement_objects>
	<statement_object MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" TITLE="ID"/>
		<path TYPE="string" TITLE="##'Путь'##"/>
		<object_id TYPE="string" TITLE="##'ID объекта'##"/>
		<object_type TYPE="string" TITLE="##'Тип объекта'##"/>
		
		<statement_id TYPE="integer" FOREIGN-ARRAY="statements" INDEXED="1" TITLE="##'Сообщение учебной активности'##"/>
		
		<definition_type TYPE="string" TITLE="##'Тип активности'##"/>
		<definition_more_info TYPE="string" TITLE="##'Информация об активности'##"/>
		<definition_interaction_type TYPE="string" TITLE="##'Тип взаимодействия'##"/>
		<context_activity_type TYPE="string" TITLE="##'Тип активности в контексте'##"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</statement_object>
</statement_objects>

</SPXML-FORM>