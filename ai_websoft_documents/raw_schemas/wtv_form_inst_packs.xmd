<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<inst_packs>
	<inst_pack MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="string"/>
		<name TYPE="string"/>
		<comment TYPE="string"/>
		<lng_id TYPE="string" FOREIGN-ARRAY="lngs"/>
		<url TYPE="string"/>
		<package_date TYPE="date"/>
		<type TYPE="string" NOT-NULL="1" DEFAULT="simple"/>

		<is_std TYPE="bool" NULL-FALSE="1" DEFAULT="false"/>
		<is_demo TYPE="bool" NULL-FALSE="1" DEFAULT="false"/>
		<always_update_objects TYPE="bool" NULL-FALSE="1" DEFAULT="false"/>

		<processed TYPE="bool" NULL-FALSE="1" DEFAULT="false"/>
		<process_date TYPE="date"/>
		<process_log TYPE="string"/>
	</inst_pack>
</inst_packs>

</SPXML-FORM>