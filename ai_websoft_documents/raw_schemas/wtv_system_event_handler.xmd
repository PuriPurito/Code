<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<system_event_handler>
	<INHERIT TYPE="object_code_name_base"/>
	<is_enabled TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=zeta4i89wg"/>	

	<INHERIT TYPE="exec_code_base"/>
	<system_event_id TYPE="integer" FOREIGN-ARRAY="system_events" INDEXED="1" TITLE="const=lm0vvsk9uw"/>
	<INHERIT TYPE="web_variables_base"/>
	
	<perfom_condition TYPE="string" STORE-SECTION="cdata" TITLE="const=648rt373e5"/>

	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

	<view TEMP="1">
	</view>
	<last_system_event_id TYPE="integer" FOREIGN-ARRAY="system_events" INDEXED="1" TITLE="const=lm0vvsk9uw"/>
	<last_is_enabled TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=zeta4i89wg"/>	
	
</system_event_handler>
<OnBeforeSave PROPERTY="1" EXPR="
	if( TopElem.is_enabled && TopElem.system_event_id.HasValue )
	{
		tools.add_system_event_handlers_to_obj( TopElem.system_event_id, TopElem.Doc.DocID, TopElem );
	}
	else if( TopElem.last_is_enabled && TopElem.last_system_event_id.HasValue )
	{
		tools.del_system_event_handlers_from_obj( TopElem.last_system_event_id, TopElem.Doc.DocID );
	}
	
	TopElem.last_system_event_id = TopElem.system_event_id;
	TopElem.last_is_enabled = TopElem.is_enabled;
"/>
<DocDesc PROPERTY="1" EXPR="
		'Обработчик системного события' + ': ' + system_event_handler.name
"/>

</SPXML-FORM>