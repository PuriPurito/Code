<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<remote_collection>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	<category TYPE="string" TITLE="const=vkpb_comment"/>

	<cache_vars TYPE="string"/>

	<INHERIT TYPE="exec_code_base"/>
	<url TYPE="string"/>
	<script TYPE="string" STORE-SECTION="cdata" TITLE="const=c_code"/>

	<catalog_name TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=c_object_type"/>

	<INHERIT TYPE="web_variables_base"/>

	<INHERIT TYPE="result_fields_base"/>

	<api_ver TYPE="string" DEFAULT="0" TITLE="##'Версия API'##" />
	<api_search>
		<has_fulltext TYPE="bool" NOT-NULL="1" DEFAULT="true" TITLE="##'Возможен полнотекстовый поиск'##"/>
		<names TYPE="string" TITLE="##'Допустимые имена полей для поиска'##"/>
	</api_search>
	<api_filters TITLE="const=filtry">
		<api_filter MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" EXPR-INIT="tools.random_string( 6 )" TITLE="ID"/>
			<name TYPE="string" TITLE="##'Имя поля фильтра'##"/>
			<type TYPE="string" FOREIGN-ARRAY="common.filter_types" TITLE="const=c_type"/>
			<title TYPE="string" TITLE="const=c_heading"/>
		</api_filter>
	</api_filters>
	<ready_to_analytics TYPE="bool" DEFAULT="false" NOT-NULL="1" TITLE="##'Выборка готова к использованию в \'Центре аналитики\''##"/>
	<analytics>
		<param_wvars>
			<param_wvar MULTIPLE="1" PRIMARY-KEY="wvar_id">
				<wvar_id TYPE="string" FOREIGN-ARRAY="Doc.TopElem.wvars" TITLE="##'Переменные (модификаторы) выборки для \'Центра аналитики\''##"/>
			</param_wvar>
		</param_wvars>
		<filter_start_date TYPE="string" TITLE="##'Поле отбора - дата начала периода'##"/>
		<filter_finish_date TYPE="string" TITLE="##'Поле отбора - дата конца периода'##"/>
		<filter_person_ids TYPE="string" TITLE="##'Поле отбора - ID сотрудников'##"/>
		<field_name TYPE="string" FOREIGN-ARRAY="Doc.TopElem.result_fields" TITLE="##'Наименования ряда'##"/>
		<field_timestamp TYPE="string" FOREIGN-ARRAY="Doc.TopElem.result_fields" TITLE="##'Дата таймлайна'##"/>
	</analytics>

	<comment TYPE="string" TITLE="const=vkpb_comment"/>

	<start_index TYPE="integer" TEMP="1"/>
	<page_index TYPE="integer" TEMP="1"/>
	<page_size TYPE="integer" TEMP="1"/>
	<use_cache TYPE="integer" TEMP="1" NOT-NULL="1" DEFAULT="0"/> <!-- 1 - wvars, 2 - userID, 4 - objectID, 8 - sort, 16 - paging -->
	<sort_field_name TYPE="string"/>
	<sort_direction TYPE="string"/>

	<columns_white_list MULTIPLE="1" TYPE="string" TEMP="1"/>

	<tree_node_id TYPE="string" DEFAULT="source" TEMP="1"/>

	<constructor>
		<use TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		<object_name TYPE="string"/>
		<INHERIT TYPE="criterion_base"/>
		<INHERIT TYPE="column_base"/>
	</constructor>

	<access TITLE="const=bmlkskx7us">
		<INHERIT TYPE="access_doc_base"/>
	</access>

	<INHERIT TYPE="i18n_base"/>

	<default_for_portal TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="##'По умолчанию на портале'##"/>
	<default_for_admin TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="##'По умолчанию в приложениях'##"/>

	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>

	<view TEMP="1">
		<test_format TYPE="string" NOT-NULL="1" DEFAULT="xml" TEMP="1"/>
		<test_destination TYPE="string" NOT-NULL="1" DEFAULT="alert" TEMP="1"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TEMP="1"/>
		<INHERIT TYPE="object_type_base" TEMP="1"/>
		<test_result_obj TYPE="variant" TEMP="1"/>
		<referer_url TYPE="string" TEMP="1"/>
		<INHERIT TYPE="result_fields_base"/>
	</view>
	<converter TYPE="bool" EXPR="
			TopElem = Child(0).Parent;
			ms_tools.convert_exec_code( TopElem.exec_code, TopElem.url, TopElem.script );
	" TEMP="1"/>

	<setPaging PROPERTY="1" PARAM="iIdx" PARAM="iSize" EXPR="
		TopElem = Child(0).Parent;
		TopElem.page_index = OptInt(iIdx,null);
		TopElem.page_size = OptInt(iSize,null);
	"/>

	<setColumnsWhiteList PROPERTY="1" PARAM="aFields" EXPR="
		TopElem = Child(0).Parent;
		var vFld, sFld;

		TopElem.columns_white_list.Clear();

		if (IsArray(aFields))
			for (vFld in aFields)
			{
				sFld = String(vFld);
				if (tools.ValidateName(sFld, true))
					TopElem.columns_white_list.Add().Value = sFld;
			}
	"/>

	<getStamp PROPERTY="1" PARAM="cur_user_id" PARAM="cur_object_id" EXPR="
		TopElem = Child(0).Parent;

		var _key = 'rcolch_'+ TopElem.id;
		var _flags = TopElem.use_cache.Value;
		if ((_flags & 1) != 0)
		  _key += '_v' + CRC(TopElem.wvars.GetXml(({'tabs':false})));

		if ((_flags & 2) != 0)
			_key += '_u' + cur_user_id;
		if ((_flags & 4) != 0)
			_key += '_o' + cur_object_id;
		if ((_flags & 8) != 0)
			_key += '_s' + CRC(TopElem.sort_field_name + TopElem.sort_direction);
		if ((_flags & 16) != 0)
		  _key += '_p' + TopElem.page_index + 'p' + TopElem.page_size;

		return _key;
	"/>

	<evaluate PROPERTY="1" PARAM="sDataTypePARAM" PARAM="Request" PARAM="oArgVars" PARAM="sConfiguration" EXPR="
		try
		{
			sDataTypePARAM = StrLowerCase(sDataTypePARAM);
		}
		catch(_X_)
		{
			sDataTypePARAM = 'xml';
		}


       		try
       		{
       			sConfiguration;
       		}
       		catch ( err )
       		{
       			sConfiguration = 'Release';
       		}


		var oResulter = {'error':0,'messageText':'','result':'','total':0};
		var TopElem = Child(0).Parent;

		var MESSAGE = '';
		var ERROR = 0;
		var oActivity = tools.lite_call_code_library_method( '//wtv/libs/open_telemetry_library.js', 'StartActivity', [UniqueID(), CodeLiteral (TopElem.code), '', [
			{'name':'component', 'value':'remote_collection'},
			{'name':'activity.name', 'value':CodeLiteral(TopElem.name)}
		], ['hcm.remote_collections.started', 'hcm.remote_collections.working']]);
		if ( TopElem.code == 'uni_catalog_list' )
		{
			var fldWvarCatalogName = TopElem.wvars.GetOptChildByKey( 'catalog_name' );
			if ( fldWvarCatalogName != undefined &amp;&amp; fldWvarCatalogName.value.HasValue )
			{
				var catCatalogRemoteCollection = ArrayOptFirstElem( XQuery( 'for $elem in remote_collections where $elem/code = ' + XQueryLiteral( 'uni_catalog_list_' + fldWvarCatalogName.value ) + ' return $elem/Fields(\'id\')' ) );
				if ( catCatalogRemoteCollection == undefined )
				{
					ERROR = 1;
					MESSAGE = ms_tools.get_const('nedostatochnopr');
				}
				else
				{
					var teRemoteCollection = OpenDoc( UrlFromDocID( catCatalogRemoteCollection.id ) ).TopElem;
					teRemoteCollection.sort_field_name = TopElem.sort_field_name;
					teRemoteCollection.sort_direction = TopElem.sort_direction;
					teRemoteCollection.view.referer_url = TopElem.view.referer_url;
					teRemoteCollection.tree_node_id = TopElem.tree_node_id;
					teRemoteCollection.page_index = TopElem.page_index;
					teRemoteCollection.page_size = TopElem.page_size;

					sXqueryQual = teRemoteCollection.wvars.ObtainChildByKey( 'xquery_qual' ).value.Value;
					if ( sXqueryQual != '' )
					{
						fldTEXqueryQual = TopElem.wvars.GetOptChildByKey( 'xquery_qual' );
						if ( fldTEXqueryQual != undefined &amp;&amp; fldTEXqueryQual.value.HasValue )
						{
							sXqueryQual += ' and ( ' + fldTEXqueryQual.value + ' )';
						}
					}
					else
					{
						fldTEXqueryQual = TopElem.wvars.GetOptChildByKey( 'xquery_qual' );
						if ( fldTEXqueryQual != undefined &amp;&amp; fldTEXqueryQual.value.HasValue )
						{
							sXqueryQual = fldTEXqueryQual.value;
						}
					}

					sXqueryQualDefault = teRemoteCollection.wvars.ObtainChildByKey( 'xquery_qual_default' ).value.Value;

					teRemoteCollection.wvars.AssignElem( TopElem.wvars );
					teRemoteCollection.wvars.ObtainChildByKey( 'xquery_qual' ).value = sXqueryQual;
					teRemoteCollection.wvars.ObtainChildByKey( 'xquery_qual_default' ).value = sXqueryQualDefault;

					TopElem = teRemoteCollection;
				}
			}
		}
		else if ( TopElem.code != 'uni_catalog_list_menu' &amp;&amp; StrBegins( TopElem.code, 'uni_catalog_list_' ) )
		{
			TopElem.wvars.ObtainChildByKey( 'catalog_name' ).value = StrReplace( TopElem.code, 'uni_catalog_list_', '' );
		}

		try
		{
			oArgVars;
			if(DataType(oArgVars) == 'string')
				oArgVars = ParseJson(oArgVars);
		}
		catch(e)
		{
			oArgVars = {};
		}
		var bArgVarHasAttribute = false;
		for(i in oArgVars)
			bArgVarHasAttribute = true;

		var RESULT = null;
		var COLUMNS = Array();
		var OUTFORMAT = sDataTypePARAM;
		var RESULTSTREAM = new BufStream;
		var DATA = new Object;

		var TREE_NODE_ID = TopElem.tree_node_id.Value;

		var SORT = new Object;
		SORT.FIELD = (TopElem.sort_field_name.HasValue ? TopElem.sort_field_name.Value : null);
		SORT.DIRECTION =	(StrLowerCase(TopElem.sort_direction.Value) == 'desc'? 'DESC' : 'ASC');

		var PAGING = new Object;
		PAGING.INDEX = TopElem.page_index.Value;
		PAGING.START_INDEX = TopElem.start_index.Value;
		PAGING.SIZE = TopElem.page_size.Value;
		PAGING.MANUAL = false;
		PAGING.TOTAL = null;

		var COLUMNS_WHITELIST = (ArrayCount(TopElem.columns_white_list) > 0 ? ArrayExtract(TopElem.columns_white_list, 'This.Value') : null);


			try
			{
				Request;
				Env = Request.Session.GetOptProperty('Env', ({}));
				InPlaceEval( tools_web.env_to_script( Env ) );
			}
			catch ( err )
			{
				ERROR = 1;
				MESSAGE = ms_tools.get_const('neobhodimoobno');
			}

			if ( ERROR == 0 )
			{
				try
				{
					curUserID;
				}
				catch ( err )
				{
					curUserID = null;
					curUser = null;
				}
				try
				{
					curLng;
				}
				catch ( err )
				{
					try
					{
						curLng = Env.GetOptProperty( 'curLng', null );
					}
					catch ( err1 )
					{
						curLng = null;
					}
				}
				curLocale = curLng == null ? null : curLng.short_id;

				if ( ! tools_web.check_access( TopElem, curUserID, curUser, Request.Session ) )
				{
					ERROR = 1;
					MESSAGE = ms_tools.get_const('nedostatochnopr');
				}
			}

			if ( ERROR == 0 )
			{
				oLastI18n_temp = null;
				try
				{
					oLastI18n_temp = curI18n;
				}
				catch ( err )
				{
				}
				curI18n = i18n.get_cur_i18n( TopElem.i18n_param, curLocale );

				var __stamp, _oCache = null;
				if (TopElem.use_cache.Value > 0)
				{
					try
					{
						curObjectID;
					}
					catch(_x_)
					{
						curObjectID = null;
					}
					 __stamp = getStamp(curUserID, curObjectID);
					 _oCache = tools_web.get_user_data(__stamp);
					 if (_oCache != null)
					 {
						try
						{
							_oCache = ParseJson(_oCache);
						}
						catch(_x_)
						{
							_oCache = null;
						}
					 }
				}
				if (_oCache != null)
				{
					oResulter = _oCache;
				}
				else
				{
					var oCloneWvars = TopElem.wvars.Clone();
					if ( bArgVarHasAttribute )
					{
					   for ( _pr in oArgVars )
					  {
						if ( oCloneWvars.GetOptChildByKey( _pr ) == undefined || !oCloneWvars.GetOptChildByKey( _pr ).silent )
						{
							_prObj = oArgVars.GetProperty( _pr );
							if ( ObjectType( _prObj ) == 'JsObject' )
							{
								oCloneWvars.ObtainChildByKey( _pr ).value = String( _prObj.GetOptProperty( 'value', '' ) );
							}
							else
							{
								oCloneWvars.ObtainChildByKey( _pr ).value = String( _prObj );
							}
						}
					  }
					}
					var s_anti_str = tools.wvars_to_script( oCloneWvars, false );
					//var s_anti_str = bArgVarHasAttribute ? tools.object_to_script(oArgVars, false) : tools.wvars_to_script(TopElem.wvars, false);

					try
					{
						curUser = Env.GetOptProperty( 'curUser', null );
						tools_web.set_st_category( curUser );
					}
					catch ( err )
					{
					}


					try
					{

						if ( TopElem.exec_code.code_type == 'cs' ) //c#
						{
                                                        try
                                                        {
                                                         websoft_dotnetbuild;
                                                        }
                                                        catch(e)
                                                        {
                                                         websoft_dotnetbuild = {};
                                                        }
							var args = bArgVarHasAttribute ? oArgVars : tools.wvars_to_object( TopElem.wvars );
							//retRemoteCollDataObject = tools.call_code_library_method('libDotNetBuild', 'Parse', [TopElem, 'Collections.RemoteCollection.Run',[args],sConfiguration]);
							retRemoteCollDataObject = websoft_dotnetbuild.Parse(TopElem, 'Collections.RemoteCollection.Run',[args], sConfiguration);

							if (retRemoteCollDataObject!=undefined && retRemoteCollDataObject!=null)
							{
								MESSAGE = retRemoteCollDataObject.GetOptProperty('MESSAGE');
                		 				ERROR = retRemoteCollDataObject.GetOptProperty('ERROR');
                 						RESULT = retRemoteCollDataObject.GetOptProperty('RESULT');        						
							}

						}
						else
						{

						if (TopElem.url.HasValue)
						{
							var sRenderUrl = TopElem.url.Value;
							if (!IsAbsoluteUrlStr(sRenderUrl))
								sRenderUrl = UrlAppendPath('x-local://wt/web', sRenderUrl);
							eval(s_anti_str + LoadUrlText(sRenderUrl));
						}
						else
							eval(s_anti_str + TopElem.script.Value);
						}						

						if (RESULT != null && IsArray(RESULT) == false) throw 'Result is not an array';
					}
					catch(_X_)
					{
						if (!IsCancelError(_X_) || (RESULT != null && IsArray(RESULT) == false))
						{
							ERROR = 1;
							MESSAGE = 'Error evaluating collection ' + TopElem.name.XQueryLiteral + '\n' + _X_;
							RESULT = Array();
							COLUMNS = Array();
							alert( MESSAGE );
						}
					}

					curI18n = oLastI18n_temp;

					oResulter.total = OptInt(PAGING.TOTAL, (IsArray(RESULT) ? ArrayCount(RESULT) : oResulter.total));
					if (ERROR == 0)
					{
						if (PAGING.MANUAL == false)
						{
							if (TopElem.page_size.HasValue)
							{
								if (TopElem.page_index.HasValue)
								{
									if (oResulter.total &lt;= TopElem.page_index.Value * TopElem.page_size.Value)
										TopElem.page_index = 0;

									RESULT = ArrayRange(RESULT, TopElem.page_index.Value * TopElem.page_size.Value, TopElem.page_size.Value);
								}
								else
									RESULT = ArrayRange(RESULT, 0, TopElem.page_size.Value);
							}
						}
						else
						{
							TopElem.setPaging(PAGING.INDEX, PAGING.SIZE);
						}
					}

					if (OUTFORMAT == 'raw')
					{
						oResulter.result = RESULT;
						oResulter.columns = COLUMNS;
						oResulter.data = DATA;
					}
					else
					{
						if (IsArray(RESULT))
							oResulter.result = tools.array_to_text(RESULT, OUTFORMAT);
						else
						{
							oResulter.result = RESULTSTREAM.DetachStr();
							if (oResulter.result == '')
								oResulter.result = tools.array_to_text(([]), OUTFORMAT);
						}
						oResulter.columns = tools.array_to_text(COLUMNS, OUTFORMAT);
						oResulter.data = tools.object_to_text( DATA, OUTFORMAT );
					}

					if (TopElem.use_cache.Value > 0)
					{
						tools_web.set_user_data(__stamp, EncodeJson(oResulter), 86400);
					}
				}
			}
			else
			{
				oResulter.result = tools.array_to_text(([]), sDataTypePARAM);
				oResulter.columns = oResulter.result;
				oResulter.total = 0;
				oResulter.data = tools.object_to_text( DATA, OUTFORMAT );
			}

		oResulter.sort_field_name = SORT.FIELD;
		oResulter.sort_direction = (StrLowerCase(SORT.DIRECTION) == 'desc'? 'DESC':'ASC');

		oResulter.error = OptInt(ERROR,0);
		oResulter.messageText = MESSAGE;

		oEndRes = tools.lite_call_code_library_method( '//wtv/libs/open_telemetry_library.js', 'EndActivity', [oActivity, false, oResulter.error, oResulter.messageText, ['hcm.remote_collections.working']]);
		return oResulter;
	"/>

	<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" TITLE="const=4egocnh7uc"/>
</remote_collection>

<OnBeforeSave PROPERTY="1" EXPR="
	try
	{
		TopElem.cache_vars = EncodeJson( tools_lp.plain_wvars_to_json( TopElem, true ) );
	}
	catch(e) { alert('Remote collection - wvars to JSON failure: ' + e) }

       	if ( TopElem.exec_code.is_compiling && TopElem.exec_code.code_type == 'cs' ) //c#
	{
                try
                {
                 websoft_dotnetbuild;
                }
                catch(e)
                {
                 websoft_dotnetbuild = {};
                }

		//oResult = tools.call_code_library_method('libDotNetBuild', 'SaveProjectTE', [TopElem]);
		oResult = websoft_dotnetbuild.SaveProjectTE(TopElem);
		if(oResult.error != 0)
			alert(oResult.errorText);
	}
"/>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('udalennoedeyst') + ': ' + remote_collection.name
"/>

</SPXML-FORM>