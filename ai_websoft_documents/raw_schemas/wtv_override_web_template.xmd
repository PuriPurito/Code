<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<override_web_template>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name PROPERTY="1" TITLE="const=c_name" EXPR="
		sCWT = global_settings.object_deleted_str;
		if ( custom_web_template_id.HasValue )
		{
			sCWT = custom_web_template_id.OptForeignElem;
			if ( sCWT != undefined )
				sCWT = sCWT.name;
		}
		return '[' + mode + '][' + zone + '][' + ( web_design_id.HasValue ? web_design_id : '*' ) + '][' + ( site_id.HasValue ? site_id : '*' ) + '][' + sCWT + ']';
	"/>
	<parent_id TYPE="integer" FOREIGN-ARRAY="override_web_templates" TITLE="const=bmqfpg1jbr"/>
	<mode TYPE="string" TITLE="Mode"/>
	<mode_exception TYPE="string" TITLE="const=isklyucheniyamode"/>
	<zone TYPE="string" TITLE="const=js5lpan3l7"/>
	<custom_web_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="const=doc_template"/>
	<custom_web_template_name TYPE="string" TITLE="const=doc_template"/>
	<web_design_id TYPE="integer" FOREIGN-ARRAY="web_designs" TITLE="const=k26170zag7"/>
	<site_id TYPE="integer" FOREIGN-ARRAY="sites" TITLE="const=sayt"/>
	<weight TYPE="integer" NOT-NULL="1" DEFAULT="0" TITLE="const=7kjcb43w9b"/>
	<is_enabled TYPE="bool" NOT-NULL="1" DEFAULT="true" TITLE="const=zeta4i89wg"/>

	<cache_static TYPE="string"/>
	<cache_dynamic TYPE="string"/>
	<cache_html TYPE="string"/>
	<cache_vars TYPE="string"/>
	<cache_refresh TYPE="bool" NULL-FALSE="1"/>

	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

	<access TITLE="const=bmlkskx7us">
		<INHERIT TYPE="access_doc_base"/>
	</access>

	<INHERIT TYPE="web_variables_base"/>

	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>

	<comment TYPE="string" TITLE=""/>

	<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" TITLE="const=4egocnh7uc"/>
</override_web_template>

<OnBeforeSave PROPERTY="1" EXPR="
	try
	{
		arrWvars = tools_lp.owt_wvars_to_json( TopElem, true );
		if ( arrWvars == null )
		{
			throw 'wrong_data';
		}
		TopElem.cache_vars = EncodeJson( arrWvars );
	}
	catch ( err )
	{
		TopElem.cache_vars.Clear();
		alert( 'WARNING: Override web template - wvars to JSON failure: ' + err );
	}
"/>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('omyx4urajn') + ': ' + override_web_template.name
"/>

</SPXML-FORM>