<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<dn_discipline_block>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
		
	<disciplines>
		<discipline MULTIPLE="1" PRIMARY-KEY="discipline_id">
			<discipline_id TYPE="integer" FOREIGN-ARRAY="dn_disciplines"/>
		</discipline>
	</disciplines>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
		
	<doc_info TYPE="doc_info_base"/>
	
	<INHERIT TYPE="admin_access_base"/>
	
	<INHERIT TYPE="custom_elems_base"/>
	
	
	<view TEMP="1">	
	    <filter TEMP="1">
			<INHERIT TYPE="au_ft_filter" TEMP="1"/>
		</filter>
		<INHERIT TYPE="desc_base"/>
	</view>
</dn_discipline_block>	

<DocDesc PROPERTY="1" EXPR="
		 ms_tools.get_const('blokdisciplin') + ': ' + dn_discipline_block.name;
"/>

</SPXML-FORM>