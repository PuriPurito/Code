<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="response">

<USE FORM="//wtv/wtv_general.xmd"/>

<responses>
	<response MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<status TYPE="string" NOT-NULL="1" DEFAULT="plan" FOREIGN-ARRAY="common.response_status_types" TITLE="const=c_status"/>
		<type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" INDEXED="1" TITLE="const=c_object_type"/>
		<response_type_id TYPE="integer" FOREIGN-ARRAY="response_types" INDEXED="1" TITLE="const=7t6iv3kt7t"/>

		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=lhbyv18qkm"/>
		<person_org_name TYPE="string" TITLE="const=kyvtanhi3r"/>

		<owner_person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=vrb_initiator"/>

		<object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( type + 's' )" INDEXED="1" TITLE="const=c_object"/>
		<object_name TYPE="string" INDEXED="1" TITLE="const=c_object_name"/>

		<basic_score TYPE="real" TITLE="##'Оценка'##"/>
		<basic_desc TYPE="string" TITLE="##'Описание'##"/>

		<create_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>
		<plan_date TYPE="date" TITLE="const=u6lvp7f029"/>
		<done_date TYPE="date" TITLE="const=c_fact_date"/>

		<is_public TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=publichnyyotzyv"/>

		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</response>
</responses>

</SPXML-FORM>