<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="cl_module">

<USE FORM="//wtv/ms_general.xmd"/>

<cl_modules>
	<cl_module MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<cl_course_id TYPE="integer" FOREIGN-ARRAY="cl_courses" TITLE="const=kurskurslab"/>
		<resource_url TYPE="string" TITLE="const=ssylkanafaylyr"/>
		<category TYPE="string" TITLE="const=c_folder"/>
		<category_label TYPE="string" TITLE="const=4egocnh7uc"/>

		<slide_width TYPE="integer" TITLE="const=shirinaslayda"/>
		<slide_height TYPE="integer" TITLE="const=vysotaslayda"/>

		<is_template TYPE="bool" TITLE="const=yavlyaetsyashablon"/>
		<stamp TYPE="integer" TITLE="Stamp"/>

		<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
		<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<INHERIT TYPE="access_doc_base"/>

		<INHERIT TYPE="admin_access_base"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				id.Parent.AssignElem( SrcDoc.TopElem.access );

				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				slide_width = SrcDoc.TopElem.design.slide_width;
				slide_height = SrcDoc.TopElem.design.slide_height;
		"/>
	</cl_module>
</cl_modules>

</SPXML-FORM>