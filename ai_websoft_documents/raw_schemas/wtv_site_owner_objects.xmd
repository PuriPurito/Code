<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" x-linked-catalogs="sites">

<site_owner_objects>
	<site_owner_object MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>

		<site_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="sites"/>

		<object_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="XQuery( catalog_name + 's' )"/>
		<catalog_name TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=s5j056rnbt"/>
	</site_owner_object>
</site_owner_objects>

<MatchDocTypeExt PROPERTY="1" EXPR="
		StrContains( SrcDoc.FormUrl, 'wtv_site.xmd' )
"/>

<OnBuildExt PROPERTY="1" EXPR="
		DeleteCatalogEntries( SrcDoc.DocID, 'site_id' );

		for ( srcSpot in SrcDoc.TopElem.owner_objects )
		{
			newSpot = AddCatalogEntry();
			iTempID = newSpot.id.Value;

			newSpot.AssignElem( SrcDoc.TopElem );
			newSpot.AssignElem( srcSpot );
			newSpot.site_id = SrcDoc.DocID;

			newSpot.id = iTempID;
			StoreCatalogEntry( newSpot );
		}
"/>

<OnDeleteExt PROPERTY="1" EXPR="
		DeleteCatalogEntries( SrcDocID, 'site_id' );
"/>

</SPXML-FORM>