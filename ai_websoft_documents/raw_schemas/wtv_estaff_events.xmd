<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="estaff_event">

<USE FORM="//wtv/wtv_general.xmd"/>

<estaff_events>
	<estaff_event MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code_event TYPE="string" TITLE="const=kodsobytiya"/>
		<event_name TYPE="string" TITLE=""/>
		<start_date TYPE="date" EXPR-INIT="DateNewTime( Date(), 9, 0, 0 )" TITLE="const=c_start_date"/>
		
		<vacancy_id TYPE="integer" FOREIGN-ARRAY="vacancys" TITLE="const=c_vacancy"/>
		<vacancy_name TYPE="string" TITLE="const=nazvanievakans"/>
		<vacancy_code TYPE="string" TITLE="const=kodvakansii"/>
		
		<request_id TYPE="integer" FOREIGN-ARRAY="requests" TITLE="const=c_request"/>
		
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" TITLE="const=lhbyv18qkm"/>
			
		<estaff_event_type_id TYPE="integer" FOREIGN-ARRAY="estaff_event_types" TITLE="const=tipsobytiyaesta"/>
		<estaff_event_type_name TYPE="string" TITLE="const=tipsobytiyaesta"/>
		
		<object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" NOT-NULL="1" DEFAULT="document" TITLE="const=c_object_type"/>
		
		<objects TYPE="string" TITLE="const=prikreplennyeo"/>
		
		<object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( object_type + 's' )" TITLE="const=svyazannyyobekt"/>
		<object_name TYPE="string" TITLE="const=c_object_name"/>
		<linked_object_url TYPE="string" TITLE=""/>
		
		<event_status_id TYPE="string" DEFAULT="active" FOREIGN-ARRAY="common.estaff_event_status_types" TITLE="const=c_status"/>
		
		<estaff_event_eid TYPE="integer" TITLE=""/>
		
		<modification_date TYPE="date" INDEXED="1" EXPR-INIT="DateNewTime( Date(), 9, 0, 0 )" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>
		
		<INHERIT TYPE="admin_access_base"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				person_fullname = SrcDoc.TopElem.person_id.sd.fullname;		
				
				objects = ArrayMerge(SrcDoc.TopElem.objects, 'This.PrimaryKey', ';');
				
				event_name = SrcDoc.TopElem.estaff_event_type_name + ' (' + SrcDoc.TopElem.person_id.sd.fullname + ')';
		"/>
	
	
	</estaff_event>
</estaff_events>

</SPXML-FORM>