<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<remote_action>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=a74bhtte55"/>
	<type TYPE="string" NOT-NULL="1" DEFAULT="eval" FOREIGN-ARRAY="common.eval_types" TITLE="const=c_type"/>
	<category TYPE="string" TITLE="const=vkpb_comment"/>

	<cache_vars TYPE="string"/>

	<catalog_name TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=c_object_type"/>
	<link_name TYPE="string"/>
	<show_in_list TYPE="bool" NOT-NULL="1" DEFAULT="true" TITLE="##'Использовать в видах'##"/>
	<show_in_form TYPE="bool" NOT-NULL="1" DEFAULT="true" TITLE="##'Использовать в карточке объекта'##"/>

	<INHERIT TYPE="exec_code_base"/>
	<url TYPE="string" TITLE="const=gwdslrn9x8"/>
	<script TYPE="string" STORE-SECTION="cdata" TITLE="const=c_code"/>

	<default_disp_evaluate TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="Выводить типовые диалоги при выполнении действия"/>

	<INHERIT TYPE="web_variables_base"/>

	<INHERIT TYPE="result_fields_base"/>

	<access TITLE="const=bmlkskx7us">
		<INHERIT TYPE="access_doc_base"/>
	</access>

	<INHERIT TYPE="i18n_base"/>

	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>

	<view TEMP="1">
		<referer_url TYPE="string" TEMP="1"/>
	</view>
	<converter TYPE="bool" EXPR="
			TopElem = Child(0).Parent;
			ms_tools.convert_exec_code( TopElem.exec_code, TopElem.url, TopElem.script );
	" TEMP="1"/>

	<evaluate PROPERTY="1" PARAM="sResultTypePARAM" PARAM="Request" PARAM="oArgVars" PARAM="sConfiguration" EXPR="
		var __oResulter = {'error':0, 'messageText':'','result':'','type':'void'};
		TopElem = Child(0).Parent;

		try
		{
			oArgVars;
			if(DataType(oArgVars) == 'string')
				oArgVars = ParseJson(oArgVars);
		}
		catch(e)
		{
			oArgVars = {};
		}

       		try
       		{
       			sConfiguration;
       		}
       		catch ( err )
       		{
       			sConfiguration = 'Release';
       		}

		var bArgVarHasAttribute = false;
		for(i in oArgVars)
			bArgVarHasAttribute = true;

		var MESSAGE = '';
		var ERROR = 0;
		var RESULT = new Object;
		var PARAMETERS = new Object;
		var oActivity = tools.lite_call_code_library_method( '//wtv/libs/open_telemetry_library.js', 'StartActivity', [UniqueID(), CodeLiteral (TopElem.code), '', [
			{'name':'component', 'value':'remote_action'},
			{'name':'activity.name', 'value':CodeLiteral(TopElem.name)}
		], ['hcm.remote_actions.started', 'hcm.remote_actions.working']]);


			try
			{
				Request;
				Env = Request.Session.GetOptProperty('Env', ({}));
				InPlaceEval( tools_web.env_to_script( Env ) );
			}
			catch ( err )
			{
				ERROR = 1;
				MESSAGE = ms_tools.get_const('neobhodimoobno');
			}

			try
			{
				sRefererUrl = UrlDecode( Child(0).Parent.view.referer_url );
				sEnvUrl = tools_web.get_cur_env_url( Env );
				oInitQuery = sRefererUrl == '' || sEnvUrl == sRefererUrl ? { 'doc_id': ( Env.curDocID == null ? '' : Env.curDocID ), 'object_id': ( Env.curObjectID == null ? '' : Env.curObjectID ), 'mode': Env.GetOptProperty('curMode', null) } : tools_web.get_url_query( sRefererUrl );
				EnvObject = tools_web.object_init( Request.Session, oInitQuery );
				Env.SetProperty( 'curDocID', curDocID = EnvObject.GetProperty( 'curDocID' ) );
				curDoc = EnvObject.GetProperty( 'curDoc' );
				Env.SetProperty( 'curDocSid', curDocSid = EnvObject.GetProperty( 'curDocSid' ) );
				Env.SetProperty( 'curObjectID', curObjectID = EnvObject.GetProperty( 'curObjectID' ) );
				curObjectDoc = EnvObject.GetProperty( 'curObjectDoc' );
				curObject = curObjectDoc == null ? null : curObjectDoc.TopElem;
				Env.SetProperty( 'curMode', curMode = Env.GetOptProperty('curMode', null) );
			}
			catch ( err )
			{
				if ( global_settings.debug )
					alert( err );
			}

			try
			{
				curUserID = Env.GetOptProperty( 'curUserID', null );
				curUser = Env.GetOptProperty( 'curUser', null );
			}
			catch ( err )
			{
				curUserID = null;
				curUser = null;
			}
			try
			{
				curLng;
			}
			catch ( err )
			{
				try
				{
					curLng = Env.GetOptProperty( 'curLng', null );
				}
				catch ( err1 )
				{
					curLng = null;
				}
			}
			curLocale = curLng == null ? null : curLng.short_id;

			try
			{
				if ( curUserID != null )
				{
					Request.AuthUserID = curUserID;
					Request.AuthLogin = curUser.login.Value;
					tools_web.set_st_category( curUser );
				}
			}
			catch ( err )
			{
				if ( global_settings.debug )
					alert( err );
			}

			if ( ERROR == 0 )
			{
				if ( ! tools_web.check_access( TopElem, curUserID, curUser, Request.Session ) )
				{
					ERROR = 1;
					MESSAGE = ms_tools.get_const('nedostatochnopr');
				}
			}

			if ( ERROR == 0 )
			{
				try
				{
					curI18n = i18n.get_cur_i18n( TopElem.i18n_param, curLocale );

					if(bArgVarHasAttribute)
					{
						if ( oArgVars.GetOptProperty( 'command' ) == undefined )
						{
							oArgVars.SetProperty( 'command', { value: 'eval'} );
						}
						
						if ( oArgVars.GetOptProperty( 'SELECTED_OBJECT_IDS', '' ) == '' )
						{
							if ( oArgVars.GetOptProperty( 'OBJECT_ID', '' ) != '' )
							{
								oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', oArgVars.GetProperty( 'OBJECT_ID' ) );
							}
							else if ( oArgVars.GetOptProperty( '_ITEM_', '' ) != '' )
							{
								try
								{
									_tmp = ParseJson( oArgVars.GetProperty( '_ITEM_' ) );
									if ( OptInt( _tmp.GetOptProperty( 'ra_id', '' ), 0 ) == 0 &amp;&amp; OptInt( _tmp.GetOptProperty( 'action_id', '' ), 0 ) == 0 &amp;&amp; OptInt( _tmp.GetOptProperty( 'id', '' ), 0 ) != TopElem.id )
									{
										oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', _tmp.id );
										oArgVars.SetProperty( 'OBJECT_ID', _tmp.id );
									}
									else if ( oArgVars.GetOptProperty( 'curObjectID', '' ) != '' )
									{
										oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', oArgVars.GetProperty( 'curObjectID' ) );
										oArgVars.SetProperty( 'OBJECT_ID', oArgVars.GetProperty( 'curObjectID' ) );
									}
									else if ( oArgVars.GetOptProperty( '_remote_object_id', '' ) != '' )
									{
										oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', oArgVars.GetProperty( '_remote_object_id' ) );
										oArgVars.SetProperty( 'OBJECT_ID', oArgVars.GetProperty( '_remote_object_id' ) );
									}
									else if ( oArgVars.GetOptProperty( '_object_id', '' ) != '' )
									{
										oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', oArgVars.GetProperty( '_object_id' ) );
										oArgVars.SetProperty( 'OBJECT_ID', oArgVars.GetProperty( '_object_id' ) );
									}
								}
								catch( _zzz_ )
								{
								}
							}
							else if ( oArgVars.GetOptProperty( '_ITEMS_ARRAY_', '' ) != '' )
							{
								try
								{
									_tmp = ParseJson( oArgVars.GetProperty( '_ITEMS_ARRAY_' ) );
									if ( OptInt( _tmp[0].GetOptProperty( 'ra_id', '' ), 0 ) == 0 &amp;&amp; OptInt( _tmp[0].GetOptProperty( 'action_id', '' ), 0 ) == 0 &amp;&amp; OptInt( _tmp[0].GetOptProperty( 'id', '' ), 0 ) != TopElem.id )
									{
										oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', ArrayMerge( _tmp, 'This.id', ';' ) );
										oArgVars.SetProperty( 'OBJECT_ID', _tmp[0].id );
									}
									else if ( oArgVars.GetOptProperty( 'curObjectID', '' ) != '' )
									{
										oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', oArgVars.GetProperty( 'curObjectID' ) );
										oArgVars.SetProperty( 'OBJECT_ID', oArgVars.GetProperty( 'curObjectID' ) );
									}
									else if ( oArgVars.GetOptProperty( '_remote_object_id', '' ) != '' )
									{
										oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', oArgVars.GetProperty( '_remote_object_id' ) );
										oArgVars.SetProperty( 'OBJECT_ID', oArgVars.GetProperty( '_remote_object_id' ) );
									}
								}
								catch( _zzz_ )
								{
								}
							}
							else if ( oArgVars.GetOptProperty( 'curObjectID', '' ) != '' )
							{
								oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', oArgVars.GetProperty( 'curObjectID' ) );
							}
							else if ( oArgVars.GetOptProperty( '_remote_object_id', '' ) != '' )
							{
								oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', oArgVars.GetProperty( '_remote_object_id' ) );
							}
							else if ( oArgVars.GetOptProperty( '_object_id', '' ) != '' )
							{
								oArgVars.SetProperty( 'SELECTED_OBJECT_IDS', oArgVars.GetProperty( '_object_id' ) );
							}
						}
						if ( oArgVars.GetOptProperty( 'OBJECT_ID', '' ) == '' )
						{
							oArgVars.SetProperty( 'OBJECT_ID', String( oArgVars.GetOptProperty( 'SELECTED_OBJECT_IDS', '' ) ).split( ';' )[0] );
						}
						if ( oArgVars.GetOptProperty( '_ITEM_', '' ) == '' )
						{
							oArgVars.SetProperty( '_ITEM_', EncodeJson( ({ 'id': oArgVars.GetOptProperty( 'OBJECT_ID', '' ) }) ) );
							if ( oArgVars.GetOptProperty( '_ITEMS_ARRAY_', '' ) == '' )
							{
								oArgVars.SetProperty( '_ITEMS_ARRAY_', EncodeJson( ArrayExtract( String( oArgVars.GetOptProperty( 'SELECTED_OBJECT_IDS', '' ) ).split( ';' ), '({ \'id\': This })' ) ) );
							}
						}
						
						PARAMETERS = {};
						for(attribArgVars in oArgVars)
						{
							PARAMETERS.SetProperty(attribArgVars, oArgVars[attribArgVars].value)
						}

						SCOPE_WVARS = PARAMETERS;
						var s_anti_str = tools.object_to_script(oArgVars, false);
					}
					else
					{
						if ( TopElem.wvars.GetOptChildByKey( 'command' ) == undefined )
						{
							TopElem.wvars.ObtainChildByKey( 'command' ).value = 'eval';
						}
														  
						if ( TopElem.wvars.GetOptChildByKey( 'SELECTED_OBJECT_IDS' ) == undefined || TopElem.wvars.GetOptChildByKey( 'SELECTED_OBJECT_IDS' ).value == '' )
						{
							if ( TopElem.wvars.GetOptChildByKey( 'OBJECT_ID' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( 'OBJECT_ID' ).value != '' )
							{
								TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value;
							}
							else if ( TopElem.wvars.GetOptChildByKey( '_ITEM_' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( '_ITEM_' ).value != '' )
							{
								try
								{
									_tmp = ParseJson( TopElem.wvars.ObtainChildByKey( '_ITEM_' ).value );
									if ( OptInt( _tmp.GetOptProperty( 'ra_id', '' ), 0 ) == 0 &amp;&amp; OptInt( _tmp.GetOptProperty( 'action_id', '' ), 0 ) == 0 &amp;&amp; OptInt( _tmp.GetOptProperty( 'id', '' ), 0 ) != TopElem.id )
									{
										TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = _tmp.id;
										TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value = _tmp.id;
									}
									else if ( TopElem.wvars.GetOptChildByKey( 'curObjectID' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( 'curObjectID' ).value != '' )
									{
										TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = TopElem.wvars.ObtainChildByKey( 'curObjectID' ).value;
										TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value = TopElem.wvars.ObtainChildByKey( 'curObjectID' ).value;
									}
									else if ( TopElem.wvars.GetOptChildByKey( '_remote_object_id' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( '_remote_object_id' ).value != '' )
									{
										TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = TopElem.wvars.ObtainChildByKey( '_remote_object_id' ).value;
										TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value = TopElem.wvars.ObtainChildByKey( '_remote_object_id' ).value;
									}
									else if ( TopElem.wvars.GetOptChildByKey( '_object_id' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( '_object_id' ).value != '' )
									{
										TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = TopElem.wvars.ObtainChildByKey( '_object_id' ).value;
										TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value = TopElem.wvars.ObtainChildByKey( '_object_id' ).value;
									}
								}
								catch( _zzz_ )
								{
								}
							}
							else if ( TopElem.wvars.GetOptChildByKey( '_ITEMS_ARRAY_' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( '_ITEMS_ARRAY_' ).value != '' )
							{
								try
								{
									_tmp = ParseJson( TopElem.wvars.ObtainChildByKey( '_ITEMS_ARRAY_' ).value );
									if ( OptInt( _tmp[0].GetOptProperty( 'ra_id', '' ), 0 ) == 0 &amp;&amp; OptInt( _tmp[0].GetOptProperty( 'action_id', '' ), 0 ) == 0 &amp;&amp; OptInt( _tmp[0].GetOptProperty( 'id', '' ), 0 ) != TopElem.id )
									{
										TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = ArrayMerge( _tmp, 'This.id', ';' );
										TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value = _tmp[0].id;
									}
									else if ( TopElem.wvars.GetOptChildByKey( 'curObjectID' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( 'curObjectID' ).value != '' )
									{
										TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = TopElem.wvars.ObtainChildByKey( 'curObjectID' ).value;
										TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value = TopElem.wvars.ObtainChildByKey( 'curObjectID' ).value;
									}
									else if ( TopElem.wvars.GetOptChildByKey( '_remote_object_id' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( '_remote_object_id' ).value != '' )
									{
										TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = TopElem.wvars.ObtainChildByKey( '_remote_object_id' ).value;
										TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value = TopElem.wvars.ObtainChildByKey( '_remote_object_id' ).value;
									}
									else if ( TopElem.wvars.GetOptChildByKey( '_object_id' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( '_object_id' ).value != '' )
									{
										TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = TopElem.wvars.ObtainChildByKey( '_object_id' ).value;
										TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value = TopElem.wvars.ObtainChildByKey( '_object_id' ).value;
									}
								}
								catch( _zzz_ )
								{
								}
							}
							else if ( TopElem.wvars.GetOptChildByKey( 'curObjectID' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( 'curObjectID' ).value != '' )
							{
								TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = TopElem.wvars.ObtainChildByKey( 'curObjectID' ).value;
							}
							else if ( TopElem.wvars.GetOptChildByKey( '_remote_object_id' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( '_remote_object_id' ).value != '' )
							{
								TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = TopElem.wvars.ObtainChildByKey( '_remote_object_id' ).value;
							}
							else if ( TopElem.wvars.GetOptChildByKey( '_object_id' ) != undefined &amp;&amp; TopElem.wvars.GetOptChildByKey( '_object_id' ).value != '' )
							{
								TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value = TopElem.wvars.ObtainChildByKey( '_object_id' ).value;
							}
						}
						if ( TopElem.wvars.GetOptChildByKey( 'OBJECT_ID' ) == undefined || TopElem.wvars.GetOptChildByKey( 'OBJECT_ID' ).value == '' )
						{
							TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value = String( TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value ).split( ';' )[0];
						}
						if ( TopElem.wvars.GetOptChildByKey( '_ITEM_' ) == undefined || TopElem.wvars.GetOptChildByKey( '_ITEM_' ).value == '' )
						{
							TopElem.wvars.ObtainChildByKey( '_ITEM_' ).value = EncodeJson( ({ 'id': String( TopElem.wvars.ObtainChildByKey( 'OBJECT_ID' ).value.Value ) }) );
							if ( TopElem.wvars.GetOptChildByKey( '_ITEMS_ARRAY_' ) == undefined || TopElem.wvars.GetOptChildByKey( '_ITEMS_ARRAY_' ).value == '' )
							{
								TopElem.wvars.ObtainChildByKey( '_ITEMS_ARRAY_' ).value = EncodeJson( ArrayExtract( String( TopElem.wvars.ObtainChildByKey( 'SELECTED_OBJECT_IDS' ).value ).split( ';' ), '({ \'id\': This })' ) );
							}
						}
						
						PARAMETERS = tools.wvars_to_object( TopElem.wvars );
						SCOPE_WVARS = PARAMETERS;
						var s_anti_str = tools.wvars_to_script(TopElem.wvars, false);
					}
					
					var sRenderUrl = TopElem.url.Value;
					if ( sRenderUrl != '' && ! IsAbsoluteUrlStr( TopElem.url ) )
						sRenderUrl = UrlAppendPath( global_settings.web_path, TopElem.url );

					if ( TopElem.type == 'page' )
					{
						s_anti_str = '&lt;%' + StrReplace( StrReplace( s_anti_str, '&lt;%', '&lt; %' ), '%&gt;', '% &gt;' ) + '%&gt;';
						if ( sRenderUrl == '' )
							EvalCodePage( (s_anti_str + TopElem.script.Value), true );
						else
							EvalCodePage( (s_anti_str + LoadUrlText(sRenderUrl)), true );
					}
					else if ( TopElem.type == 'eval' )
					{
       					if ( TopElem.exec_code.code_type == 'cs' ) //c#
       					{
                                                try
                                                {
                                                 websoft_dotnetbuild;
                                                }
                                                catch(e)
                                                {
                                                 websoft_dotnetbuild = {};
                                                }

       						//retRemoteActionDataObject = tools.call_code_library_method('libDotNetBuild', 'Parse', [TopElem, 'RemoteActions.RemoteAction.Run',[PARAMETERS], sConfiguration]);
							retRemoteActionDataObject = websoft_dotnetbuild.Parse(TopElem, 'RemoteActions.RemoteAction.Run',[PARAMETERS], sConfiguration);

							if (retRemoteActionDataObject!=undefined && retRemoteActionDataObject!=null)
							{		
								MESSAGE = retRemoteActionDataObject.GetOptProperty('MESSAGE');
										ERROR = retRemoteActionDataObject.GetOptProperty('ERROR');
										RESULT = retRemoteActionDataObject.GetOptProperty('RESULT');        						
							}
       					}
       					else
       					{
							if ( sRenderUrl == '' )
								eval(s_anti_str + TopElem.script.Value);
							else
								eval(s_anti_str + LoadUrlText(sRenderUrl));
						}
					}
					else
					{
						oConstructorResult = tools.call_code_library_method('libMain', 'ParseConstructorAction', [TopElem, PARAMETERS, Env]);
						if( oConstructorResult.error == 0)
						{
							eval(s_anti_str + oConstructorResult.data);
						}						
						else
						{
							throw 'Error evaluating action: ' + oConstructorResult.errorText
						}
					}
       			}
				catch(_X_)
				{
					if ( ! IsCancelError( _X_ ) )
					{
						alert(_X_);
						ERROR = 1;
						MESSAGE = 'Error evaluating action ' + TopElem.name.XQueryLiteral + '\n' + _X_;
					}
				}
			}

		__oResulter.error = OptInt(ERROR,0);
		__oResulter.messageText = ( '' + MESSAGE );
		if (sResultTypePARAM == 'raw')
			__oResulter.result = RESULT;
		else
			__oResulter.result = (DataType(RESULT) == 'object' ? tools.object_to_text(RESULT, sResultTypePARAM) : '');

		oEndRes = tools.lite_call_code_library_method( '//wtv/libs/open_telemetry_library.js', 'EndActivity', [oActivity, false, __oResulter.error, __oResulter.messageText]);
		return __oResulter;
	"/>

	<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" TITLE="const=4egocnh7uc"/>
</remote_action>

<OnBeforeSave PROPERTY="1" EXPR="
	try
	{
		TopElem.cache_vars = EncodeJson( tools_lp.plain_wvars_to_json( TopElem, true ) );
	}
	catch(e) { alert('Remote action - wvars to JSON failure: ' + e) }

       	if ( TopElem.exec_code.is_compiling && TopElem.exec_code.code_type == 'cs' ) //c#
       	{
                try
                {
                 websoft_dotnetbuild;
                }
                catch(e)
                {
                 websoft_dotnetbuild = {};
                }

       		//oResult = tools.call_code_library_method('libDotNetBuild', 'SaveProjectTE', [TopElem]);
		oResult = websoft_dotnetbuild.SaveProjectTE(TopElem);
       		if(oResult.error != 0)
       			alert(oResult.errorText);
       	}	

"/>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('udalennoedeyst') + ': ' + remote_action.name
"/>

</SPXML-FORM>