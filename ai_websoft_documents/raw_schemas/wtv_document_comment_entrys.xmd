<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" HIER="1" PARENT-ID-ELEM="parent_document_entry_id" OBJECT-NAME="document_comment_entry">

<USE FORM="//wtv/wtv_general.xmd"/>

<document_comment_entrys>
	<document_comment_entry MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		<create_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>

		<deleted TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="ms_tools.get_const('vdceb_comment_del')"/>

		<how2show TYPE="string" FOREIGN-ARRAY="common.forum_person_info_types" DEFAULT="realname" NOT-NULL="1"/>
		<author_info TYPE="string" />
		<user_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=c_coll"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=lhbyv18qkm"/>
		<portal_doc_id TYPE="integer" FOREIGN-ARRAY="documents" INDEXED="1" TITLE="const=vfb_forum"/>
		<parent_document_entry_id TYPE="integer" FOREIGN-ARRAY="document_comment_entrys" INDEXED="1" TITLE="const=oejhs4rwog"/>

		<last_create_date TYPE="date"/>
		<child_num TYPE="integer"/>


		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				try
				{
					author_info = SrcDoc.TopElem.author_info;
				}
				catch ( e )
				{
				}

				try
				{
					if ( user_id != null )
					{
						if ( person_fullname == '' )
						{
							person_fullname = SrcDoc.TopElem.user_id.OptForeignElem!=undefined ? SrcDoc.TopElem.user_id.OptForeignElem.fullname : '';
						}
					}
				}
				catch ( ee )
				{
					person_fullname = ms_tools.get_const('jmkcjvkz8n');
				}
		"/>

	</document_comment_entry>
</document_comment_entrys>

</SPXML-FORM>