<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="plugin">

<plugins>
	<plugin MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<block TYPE="string" FOREIGN-ARRAY="common.access_block_types" TITLE="const=c_block"/>
		<plugin_id TYPE="string" TITLE="const=plagin"/>
		<version TYPE="integer" TITLE="const=0zwsfpu9kg"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
		"/>
	</plugin>
</plugins>

</SPXML-FORM>