<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="formula">

<formulas>
	<formula MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<type TYPE="string" TITLE="const=c_type"/><!-- plan_fact|plan_fact_weight|code|designer -->
		<status TYPE="string" TITLE="const=c_type"/><!-- activ|archiv|project -->
		<dependencies TYPE="string" TITLE="const=5dpyxlj7fl" /><!-- object_id;object_id-->
		<formula_eval_str TYPE="string"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
			id.Parent.AssignElem( SrcDoc.TopElem, true );
			dependencies = ArrayMerge(SrcDoc.TopElem.dependencies, 'This.PrimaryKey', ';');
			modification_date = SrcDoc.TopElem.doc_info.modification.date;
			app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</formula>
</formulas>

</SPXML-FORM>