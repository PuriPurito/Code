<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<digital_signature>
	<name TYPE="string" EXPR="person_fullname" TITLE="const=c_name"/>
	
	<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
	<INHERIT TYPE="person_filling_base"/>
	
	<object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=c_object_type"/>
	<object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( object_type + 's' )" TITLE="const=c_object"/>
	<object_name TYPE="string" TITLE="const=c_object_name"/>
	
	<create_date TYPE="date" EXPR-INIT="Date()" TITLE="const=c_create_date"/>
	<sign_date TYPE="date" TITLE="const=datapodpisaniya"/>
	
	<is_signed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=podpisana"/>
	
	<custom_web_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="const=doc_template"/>
	
	<sign_open TYPE="string" STORE-SECTION="cdata" TITLE="const=podpisannyydok"/>
	<sign_encrypted TYPE="string" STORE-SECTION="cdata" TITLE="const=cifrovayapodpis"/>

	
	<INHERIT TYPE="file_list_base"/>

	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base"/>
	
	<access TITLE="const=bmlkskx7us">
		<INHERIT TYPE="access_doc_base"/>
	</access>
	<INHERIT TYPE="admin_access_base"/>

	<INHERIT TYPE="custom_elems_base"/>

	<view TEMP="1">
		<INHERIT TYPE="desc_base"/>
	</view>
</digital_signature>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('elektronnocifr') + ': ' + digital_signature.name
"/>

</SPXML-FORM>