<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<web_rule>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<is_pattern TYPE="bool" TITLE="const=yavlyaetsyashablon" PROPERTY="1" EXPR="
		return StrContains(url, '*');
	"/>
	<use_matches TYPE="bool" TITLE="const=ispolzuetpodst" PROPERTY="1" EXPR="
		return is_pattern && StrContains(redirect_url, '$');
	"/>

	<url TYPE="string" TITLE="URL"/>

	<script TYPE="string" TITLE="Script"/>

	<is_enabled TYPE="bool" DEAULT="true" NOT-NULL="1" TITLE="const=zeta4i89wg"/>

	<redirect_url TYPE="string" TITLE="Redirect URL"/>
	<redirect_type TYPE="integer" TITLE="Redirect type" NOT-NULL="1" DEFAULT="0"/>
	<redirect_web_mode_id TYPE="integer" FOREIGN-ARRAY="web_modes" TITLE="Тип страницы"/>

	<web_design_id TYPE="integer" FOREIGN-ARRAY="web_designs" TITLE="const=k26170zag7"/>
	<site_id TYPE="integer" FOREIGN-ARRAY="sites" TITLE="const=sayt"/>

	<weight TYPE="integer"/>

	<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>
	<is_std TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>


	<script_validate PROPERTY="1" PARAM="PATH" PARAM="PARAMETERS" EXPR="
		var RESULT = ({'type': '', 'url': ''});

		try
		{
			EvalCs(Child(0).Parent.script.Value);
			RESULT.type; RESULT.url;
		}
		catch(_x_)
		{
			RESULT = ({'type': 'error', 'message': 'Error evaluating script ' + CodeLiteral(Child(0).Parent.name)});
		}

		return RESULT;
	"/>

</web_rule>

<OnSave PROPERTY="1" EXPR="
		tools_web.clear_std_web_rules();
"/>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('pravilo') + ': ' + web_rule.name
"/>

</SPXML-FORM>