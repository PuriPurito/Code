<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<competence_profile_family>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	
	<competence_profiles TITLE="const=q9lwz1kebb">
		<competence_profile MULTIPLE="1" PRIMARY-KEY="competence_profile_id">
			<competence_profile_id TYPE="integer" FOREIGN-ARRAY="competence_profiles"/>
		</competence_profile>
	</competence_profiles>
			
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	
	<INHERIT TYPE="admin_access_base"/>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
		
	<view TEMP="1">
		<selector TYPE="string" NOT-NULL="1" DEFAULT="common" TEMP="1"/>	
	</view>
</competence_profile_family>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('cdred685vx') + ': ' + competence_profile_family.name
"/>

</SPXML-FORM>