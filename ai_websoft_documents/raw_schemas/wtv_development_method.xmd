<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<development_method>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	
	<development_objects>
		<development_object MULTIPLE="1" PRIMARY-KEY="object_name">
			<object_name TYPE="string" FOREIGN-ARRAY="common.exchange_object_types"/>
		</development_object>
	</development_objects>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	
	<INHERIT TYPE="custom_elems_base"/>
	<INHERIT TYPE="admin_access_base"/>

	<view TEMP="1">
		<selector TYPE="string" NOT-NULL="1" DEFAULT="common" TEMP="1"/>	
	</view>
</development_method>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('ks3idixed9') + ': ' + development_method.name
"/>

</SPXML-FORM>