<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<credential>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	
	<type TYPE="string" TITLE="const=c_type" NOT-NULL="1" DEFAULT="basic"/>
	
	<login TYPE="string" TITLE="const=uf_login"/>
	<password TYPE="string" TITLE="const=veb_pass"/>


	<remote_security_profile_id TYPE="integer" FOREIGN-ARRAY="remote_security_profiles" TITLE="Профиль безопасности"/>


	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
</credential>


<DocDesc PROPERTY="1" EXPR="
		'Удостоверение' + ' - ' + credential.name;
"/>

</SPXML-FORM>