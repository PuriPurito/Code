<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" HIER="1" PARENT-ID-ELEM="parent_object_id" OBJECT-NAME="section_instruction">

<section_instructions>
	<section_instruction MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<desc TYPE="string" TITLE="const=c_desc"/>
		<parent_object_id TYPE="integer" FOREIGN-ARRAY="section_instructions" INDEXED="1" TITLE="const=yk3ocfz31y"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;

				desc = StrLeftRange(UnifySpaces(HtmlToPlainText(SrcDoc.TopElem.desc)),100);
		"/>
	</section_instruction>
</section_instructions>

</SPXML-FORM>