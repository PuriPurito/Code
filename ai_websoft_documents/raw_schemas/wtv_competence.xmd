<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<competence>
	<INHERIT TYPE="object_code_name_base"/>

	<INHERIT TYPE="competence_scale_base"/>

	<competence_block_id TYPE="integer" FOREIGN-ARRAY="competence_blocks" TITLE="const=c_block"/>

	<INHERIT TYPE="competence_level_base"/>

	<INHERIT TYPE="knowledge_parts_base"/>
	<INHERIT TYPE="knowledge_parts_base_old"/>

	<INHERIT TYPE="custom_elems_base"/>
	
	<INHERIT TYPE="file_list_base"/>
	
	<exercises TITLE="const=5z3iuqumsa">
		<exercise MULTIPLE="1" PRIMARY-KEY="exercise_id">
			<exercise_id TYPE="integer" FOREIGN-ARRAY="exercises"/>
		</exercise>
	</exercises>

	<positive_comment TYPE="string" TITLE="const=ass_positive_mark"/>
	<negative_comment TYPE="string" TITLE="const=ass_negative_mark"/>

	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<desc TYPE="string" TITLE="const=c_desc"/>

	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>

	<INHERIT TYPE="admin_access_base"/>

	<view TEMP="1">
		<selector TYPE="string" NOT-NULL="1" DEFAULT="common" TEMP="1"/>
		<knowledge_classifier_id TYPE="integer" TITLE="const=vkpb_classifier" TEMP="1"/>
		<knowledge_sort_type_id TYPE="string" TITLE="const=szmrdieib8" TEMP="1" DEFAULT="name"/>
		<INHERIT TYPE="desc_base"/>
	</view>

	<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" TITLE="const=4egocnh7uc"/>
</competence>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('ass_competence') + ': ' + competence.name
"/>

</SPXML-FORM>