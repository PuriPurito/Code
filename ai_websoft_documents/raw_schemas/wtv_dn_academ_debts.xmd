<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="dn_academ_debt">

<USE FORM="//wtv/wtv_general.xmd"/>

<dn_academ_debts>
	<dn_academ_debt MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<faculty_id TYPE="integer" FOREIGN-ARRAY="subdivisions" INDEXED="1" TITLE="const=shy9bk42vy"/>
	    <chair_id TYPE="integer" FOREIGN-ARRAY="subdivisions" INDEXED="1" TITLE="ms_tools.get_const('kafedra')"/>
		<state_id TYPE="string" DEFAULT="active" FOREIGN-ARRAY="common.academ_debt_states" TITLE="const=2uivot368w"/>
		<stream_id TYPE="integer" FOREIGN-ARRAY="dn_streams" TITLE="ms_tools.get_const('potok')"/>
	    <stud_group_id TYPE="integer" FOREIGN-ARRAY="dn_stud_groups" TITLE="const=xg7kvxmhyi"/>
	    <student_id TYPE="integer" FOREIGN-ARRAY="dn_students" TITLE="ms_tools.get_const('siwbxij6vi')"/>
	    <discipl_id TYPE="integer" FOREIGN-ARRAY="dn_disciplines" TITLE="ms_tools.get_const('disciplina')"/>
		<contr_form_id TYPE="integer" FOREIGN-ARRAY="dn_control_forms" TITLE=""/>
	    <latest_date TYPE="date" TITLE=""/>
		<liquid_date TYPE="date" TITLE=""/>
			
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<INHERIT TYPE="admin_access_base"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
		
	</dn_academ_debt>	
</dn_academ_debts>

</SPXML-FORM>					