<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" x-linked-catalogs="subdivision_groups">

<subdivision_group_subdivisions>
	<subdivision_group_subdivision MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>

		<subdivision_group_id TYPE="integer" FOREIGN-ARRAY="subdivision_groups" INDEXED="1" TITLE="const=1akgrp8ook"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<is_dynamic TYPE="bool" DEFAULT="false" NOT-NULL="1" TITLE="const=z4mv1s9prn"/>

		<subdivision_id TYPE="integer" FOREIGN-ARRAY="subdivisions" INDEXED="1" TITLE="const=c_subd"/>
		<subdivision_name TYPE="string" TITLE="const=uf_depart_name"/>
	</subdivision_group_subdivision>
</subdivision_group_subdivisions>


<MatchDocTypeExt PROPERTY="1" EXPR="
		SrcDoc.FormUrl == 'x-local://wtv/wtv_subdivision_group.xmd'
"/>

<OnBuildExt PROPERTY="1" EXPR="
		DeleteCatalogEntries( SrcDoc.DocID, 'subdivision_group_id' );

		for ( srcSpot in SrcDoc.TopElem.subdivisions )
		{
			newSpot = AddCatalogEntry();
			iTempID = newSpot.id.Value;

			newSpot.subdivision_group_id = SrcDoc.DocID;
			newSpot.AssignElem( SrcDoc.TopElem );
			newSpot.AssignElem( srcSpot );

			newSpot.id = iTempID;
			StoreCatalogEntry( newSpot );
		}
"/>


<OnDeleteExt PROPERTY="1" EXPR="
		DeleteCatalogEntries( SrcDocID, 'subdivision_group_id' );
"/>

</SPXML-FORM>