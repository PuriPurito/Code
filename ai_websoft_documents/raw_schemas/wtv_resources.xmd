<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="resource">

<USE FORM="//wtv/wtv_general.xmd"/>

<resources>
	<resource MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		<type TYPE="string" NOT-NULL="1" DEFAULT="file" FOREIGN-ARRAY="common.resource_types" TITLE="const=x91r5l546f"/>
		<status TYPE="string" FOREIGN-ARRAY="common.course_test_states" INDEXED="1" TITLE="const=c_status"/>
		<resource_id TYPE="integer" FOREIGN-ARRAY="resources" TITLE="const=c_resource"/>
		<resource_type_id TYPE="integer" FOREIGN-ARRAY="resource_types" TITLE="const=tipresursabazy"/>
		<allow_download TYPE="bool" DEFAULT="true" TITLE="Разрешить доступ с портала"/>
		<allow_search TYPE="bool" DEFAULT="false" TITLE="const=razreshitpoisk"/>
		<allow_unauthorized_download TYPE="bool" DEFAULT="false" TITLE="Разрешить скачивание файла без авторизации"/>
		<comment TYPE="string" TITLE="const=vkpb_comment"/>
		<use_count TYPE="integer" NOT-NULL="1" DEFAULT="0" TITLE="const=c_num"/>
		<file_name TYPE="string" TITLE="const=vrb_file_name"/>
		<size TYPE="integer" TITLE="const=6t6e9751fk"/>

		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>
		<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" INDEXED="1" TITLE="const=vladelecresursa"/>
		<person_fullname TYPE="string" INDEXED="1" TITLE="const=lhbyv18qkm"/>

		<file_path TYPE="string" TITLE="Путь"/>
		<checksum TYPE="string" TITLE="Checksum"/>

		<knowledge_parts TYPE="string" TITLE="const=vkpb_knowledge_parts_title"/>
		<tags TYPE="string" TITLE="ID тегов"/>
		<experts TYPE="string" TITLE="const=vkpb_experts"/>

		<INHERIT TYPE="access_doc_base"/>

		<creation_date TYPE="date" INDEXED="1" TITLE="const=c_create_date"/>
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				id.Parent.AssignElem( SrcDoc.TopElem.access );

				knowledge_parts = ArrayMerge(SrcDoc.TopElem.knowledge_parts, 'This.PrimaryKey', ';');
				tags = ArrayMerge(SrcDoc.TopElem.tags, 'This.PrimaryKey', ';');
				experts = ArrayMerge(SrcDoc.TopElem.experts, 'This.PrimaryKey', ';');

				creation_date = SrcDoc.TopElem.doc_info.creation.date;
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</resource>
</resources>

</SPXML-FORM>