<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="good_instance">

<good_instances>
	<good_instance MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>

		<status TYPE="string" NOT-NULL="1" DEFAULT="in_stock" FOREIGN-ARRAY="common.good_instance_status_types" TITLE="const=c_status"/>

		<good_id TYPE="integer" FOREIGN-ARRAY="goods" TITLE="const=tovar"/>

		<reserved_date TYPE="date" INDEXED="1" TITLE="const=datarezervirov"/>
		<paid_date TYPE="date" INDEXED="1" TITLE="const=dataoplaty"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</good_instance>
</good_instances>

</SPXML-FORM>