<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" HIER="1" PARENT-ID-ELEM="parent_id" OBJECT-NAME="professional_area">

<USE FORM="//wtv/wtv_general.xmd"/>

<professional_areas>
	<professional_area MULTIPLE="1" PRIMARY-KEY="id">
		
		<INHERIT TYPE="object_code_name_base"/>

		<parent_id TYPE="integer" FOREIGN-ARRAY="professional_areas" TITLE="const=kornevoyelement"/>
		
		<professional_area_type_id TYPE="integer" FOREIGN-ARRAY="professional_area_types" TITLE="Тип профессиональной области"/>

		<comment TYPE="string" TITLE="const=vkpb_comment"/>

		<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
		<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
		<INHERIT TYPE="admin_access_base"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem )
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</professional_area>
</professional_areas>

</SPXML-FORM>