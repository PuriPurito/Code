<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<account>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<balance TYPE="real" NOT-NULL="1" DEFAULT="0." TITLE="const=c_balance"/>
	<currency_type_id TYPE="string" FOREIGN-ARRAY="lists.currency_types" TITLE="const=c_currency_type"/>
	<status TYPE="string" FOREIGN-ARRAY="common.account_status_types" TITLE="const=c_status"/>

	<INHERIT TYPE="object_type_base"/>
	
	<budget_period_id TYPE="integer" FOREIGN-ARRAY="budget_periods" TITLE="const=c_budget_period"/>

	<comment TYPE="string" TITLE="const=vkpb_comment"/>

	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	<INHERIT TYPE="admin_access_base"/>

</account>

<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('vherb_account') + ': ' + account.code
"/>

</SPXML-FORM>