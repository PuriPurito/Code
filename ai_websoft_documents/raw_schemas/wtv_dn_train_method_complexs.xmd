<?xml version="1.0" encoding="utf-8"?><SPXML-FORM CATALOG="1" OBJECT-NAME="dn_train_method_complex"><USE FORM="//wtv/wtv_general.xmd"/><dn_train_method_complexs>	<dn_train_method_complex MULTIPLE="1" PRIMARY-KEY="id">		<id TYPE="integer" INDEXED="1" TITLE="ID"/>        <code TYPE="string" INDEXED="1" TITLE="const=c_code"/>	    <name TYPE="string" INDEXED="1" TITLE="const=c_name"/>		<faculty_id TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE="const=shy9bk42vy"/>	    <chair_id TYPE="integer" FOREIGN-ARRAY="subdivisions"/>	    <discipline_id TYPE="integer" FOREIGN-ARRAY="dn_disciplines" INDEXED="1"/>	    <program_discipline_id TYPE="integer" FOREIGN-ARRAY="dn_program_discipls" INDEXED="1"/>	    <program_discipline_name INDEXED="1" TYPE="string"/>		    <lector_id TYPE="integer" FOREIGN-ARRAY="lectors" INDEXED="1" TITLE="const=c_lector"/>				<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>		<INHERIT TYPE="admin_access_base"/>		<OnBuild PROPERTY="1" EXPR="				id.Parent.AssignElem( SrcDoc.TopElem );				modification_date = SrcDoc.TopElem.doc_info.modification.date;				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;		"/>			</dn_train_method_complex>	</dn_train_method_complexs></SPXML-FORM>				