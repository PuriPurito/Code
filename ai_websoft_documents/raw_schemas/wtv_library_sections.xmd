<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" HIER="1" PARENT-ID-ELEM="parent_object_id" OBJECT-NAME="library_section">

<USE FORM="//wtv/ms_general.xmd"/>

<library_sections>
	<library_section MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1"/>

		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=2c7tfen6wm"/>
		
		<parent_object_id TYPE="integer" FOREIGN-ARRAY="library_sections" TITLE="const=6xrbiv2oyk"/>
		
		<position TYPE="integer" TITLE="const=c_pos_num"/>
		<link TYPE="string" TITLE="const=q0laxmdm5w"/>
		<external_id TYPE="string" TITLE="'Идентификатор во внешнем источнике'"/>
		<external_import_date TYPE="date" TITLE="'Дата актуализации из внешнего источника'"/>
		
		<state_id TYPE="integer" TITLE="const=c_state" FOREIGN-ARRAY="common.library_states"/>
		
		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<INHERIT TYPE="admin_access_base"/>
		
		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</library_section>
</library_sections>

</SPXML-FORM>