<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<boss_type>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<object_types>
		<object_type MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" FOREIGN-ARRAY="common.exchange_object_types"/>
		</object_type>
	</object_types>

	<operations TITLE="const=s9w32fds9k">
		<operation MULTIPLE="1" PRIMARY-KEY="operation_id">
			<operation_id TYPE="integer" FOREIGN-ARRAY="operations"/>
		</operation>
	</operations>

	<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>

	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>

	<comment TYPE="string" TITLE="const=vkpb_comment"/>

	<view TEMP="1">
		<selector TYPE="string" NOT-NULL="1" DEFAULT="common" TEMP="1"/>
	</view>
</boss_type>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('c_manager_type') + ': ' + boss_type.name
"/>

</SPXML-FORM>