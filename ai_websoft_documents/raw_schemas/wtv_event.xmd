<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM USE-LAST-SAVED-DATA="0">

<USE FORM="//wtv/ms_general.xmd"/>

<event>
	<INHERIT TYPE="object_code_name_base"/>
	
	<type_id TYPE="string" FOREIGN-ARRAY="common.event_types" NOT-NULL="1" DEFAULT="one_time" TITLE="const=c_type"/>
	<event_type_id TYPE="integer" FOREIGN-ARRAY="event_types" TITLE="const=c_type"/>
	
	<start_date TYPE="date" EXPR-INIT="DateNewTime( Date(), 9, 0, 0 )" TITLE="const=c_start_date"/>
