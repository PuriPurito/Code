	<INHERIT TYPE="custom_datas_base"/>
	
	<INHERIT TYPE="catalog_list_base"/>

	<get_chat_messages PROPERTY="1" PARAM="dtLastMessageParam" EXPR="
			if ( ! chat_id.HasValue )
				return [];

			teChat = OpenDoc( UrlFromDocID( chat_id ) ).TopElem;
			try
			{
				dtLast = Date( dtLastMessageParam );
				return ArraySelect( teChat.messages, 'date<dtLast' );
			}
			catch ( err )
			{
				return ArraySelectAll( teChat.messages );
			}
	"/>
	<send_chat_message PROPERTY="1" PARAM="sTextParam" PARAM="sFullnameParam" EXPR="
			if ( chat_id.HasValue )
			{
				docChat = OpenDoc( UrlFromDocID( chat_id ) );
			}
			else
			{
				docChat = OpenNewDoc( 'x-local://wtv/wtv_chat.xmd' );
				docChat.TopElem.name = ms_tools.get_const('chatmeropriyatiya') + ' ' + name;
				docChat.TopElem.name_source = 'fullname';
				docChat.BindToDb( DefaultDb );

				docObject = tools.get_opened_doc( Child(0).Parent );
				if ( docObject == null )
					return false;
				docObject.TopElem.chat_id = docChat.DocID;
				docObject.Save();
			}

			fldMessageChild = docChat.TopElem.messages.AddChild();
			fldMessageChild.date = CurDate;
			fldMessageChild.fullname = sFullnameParam;
			fldMessageChild.text = sTextParam;

			docChat.Save();
			return true;
	"/>


	<phases>
		<phase MULTIPLE="1" PRIMARY-KEY="id">
