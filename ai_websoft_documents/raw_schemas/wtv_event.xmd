				Child(0).Parent.view.lectors.AssignElem( Child(0).Parent.lectors );
			}
	"/>

	<obtain_collaborator PROPERTY="1" PARAM="_person_id" PARAM="_person_doc" EXPR="
			//docEvent = Child(0).Parent.Doc;
			_child = Child(0).Parent.collaborators.ObtainChildByKey( _person_id );
			try
			{
				_person_doc;
				tools.common_filling( 'collaborator', _child, _child.collaborator_id, _person_doc );
			}
			catch ( ee )
			{
				tools.common_filling( 'collaborator', _child, _child.collaborator_id );
			}
			//Child(0).Parent.Doc.Save();
			return _child;
	"/>

	<add_group PROPERTY="1" PARAM="_group_id" EXPR="
			_counter = 0;
			try
			{
				Child(0).Parent.groups.ObtainChildByKey( Int( _group_id ) );
				view.collaborator_array = QueryCatalogByKeys( 'collaborators', 'id', ArrayExtractKeys( collaborators, 'collaborator_id' ) );

				for ( _collaborator in OpenDoc( UrlFromDocID( Int( _group_id ) ) ).TopElem.collaborators )
					try
					{
						catPerson = ArrayOptFindByKey( view.collaborator_array.Object, _collaborator.PrimaryKey, 'id' );
						obtain_collaborator( _collaborator.PrimaryKey, catPerson );
						_counter++;
					}
					catch ( ss )
					{
					}
			}
			catch ( dd )
			{
			}
			return _counter;
	"/>


	<get_workflow_id PROPERTY="1" EXPR="
			if ( use_object_workflow )
				try
				{
					switch ( type_id )
					{
						case 'compound_program_elem':
							_compound_program = compound_program_id.ForeignElem;
							_program = _compound_program.programs.GetChildByKey( program_id );
							return _program.education_method_id.ForeignElem.workflow_id;
						case 'education_method':
						case 'education_method_from_program':
							return education_method_id.ForeignElem.workflow_id;
					}
				}
				catch ( dd )
				{
				}
			return null;
	"/>

	<create_certificate PROPERTY="1" PARAM="_type_id" PARAM="_type_doc" PARAM="bCreateByNotAssist" EXPR="
			try
			{
				if ( _type_doc == null || _type_doc == '' )
					throw 'no_doc';

				serttypeDoc = _type_doc;
			}
			catch ( ee )
			{
				serttypeDoc = OpenDoc( UrlFromDocID( _type_id ) ).TopElem;
			}
			try
			{
				if ( bCreateByNotAssist == null || bCreateByNotAssist == '' )
					throw 'no_param';

				bCreateByNotAssist = tools_web.is_true( bCreateByNotAssist );
			}
			catch ( ee )
			{
				bCreateByNotAssist = false;
			}

			_counter = 0;
			for ( _person in XQuery( 'for $elem in event_results where $elem/event_id = ' + Doc.DocID + ' return $elem' ) )
				try
				{
					if( bCreateByNotAssist || _person.is_assist )
					{
						tools.create_certificate_to_person( _person.person_id, _type_id, Doc.DocID, null, serttypeDoc, Child(0).Parent ).TopElem;
						_counter++;
					}
				}
				catch ( ff )
				{
				}

			return _counter;
	"/>



	<rows TYPE="variant" TEMP="1"/>
	<row_disp_elem TYPE="string" NOT-NULL="1" DEFAULT="person_fullname" TEMP="1"/>
	<row_list_field TYPE="string" DEFAULT=".Env.ListElem" TEMP="1"/>
	<row_key_field TYPE="string" DEFAULT=".PrimaryKey" TEMP="1"/>
	<list_variant TYPE="variant" TEMP="1"/>
	<start_action PROPERTY="1" PARAM="sTypeParam" PARAM="GridItemName" EXPR="
			try
			{
				sTypeParam;
			}
			catch( ex )
			{
				sTypeParam = '';
			}
			try
			{
				GridItemName;
			}
			catch( ex )
			{
				GridItemName = 'ViewGrid';
			}
			row_list_field='.Env.ListElem';
			try
			{
				if ( list_variant.HasValue )
				{
					_rows = list_variant.Object.SelRows;
					list_variant.Clear();
				}
			}
			catch ( err )
			{
				_rows = Screen.FindItem( GridItemName ).SelRows;
			}
			

			try
			{
				fldFistElem = ArrayFirstElem( _rows );
				if ( fldFistElem.Env.ListElem.Name == 'educ_group' )
				{
					row_list_field.Clear();
					rowsArrayCounter = 0;
					rowsArray=Array()
					for ( _row in _rows )
					{
						ListElem = _row.Env.ListElem;

						try
						{
							_educ_group = ArrayOptFind(educ_groups,'group_id==\''+ ListElem.PrimaryKey+'\'' )
							if (_educ_group!=undefined)
							{
								for ( _person in _educ_group.collaborators )
								{
									rowsArray[ rowsArrayCounter ] = _person.collaborator_id.Value;
									rowsArrayCounter++;
								}
							}
						}
						catch( err )
						{
						}

					}
					rowsArray = ArraySelectDistinct( rowsArray, 'This' );
					_rows = QueryCatalogByKeys( 'collaborators', 'id', rowsArray );
					row_list_field='';
				}
				else if( fldFistElem.Env.ListElem.Name == 'collaborator' )
				{
					bNeedCollaborator = sTypeParam == 'ActivateTests' || sTypeParam == 'ActivateEducationPrograms' || sTypeParam == 'ActivateCourses' || sTypeParam == 'PersonDoWebBan' || sTypeParam == 'PersonUndoWebBan' || sTypeParam == 'SendNotificationLoginPassword' || sTypeParam == 'SendNotification' || sTypeParam == 'AddToAssessmentAppraise' || sTypeParam == 'AddToEvent' || sTypeParam == 'PersonAddToGroup';
					rowsArray=Array();
					bEventResult = true;
					for ( _row in _rows )
						try
						{
							if( bNeedCollaborator )
							{
								throw 'error';
							}
							ListElem = _row.Env.ListElem;
							if( ListElem.result.id.HasValue )
							{
								rowsArray.push( ListElem.result.id );
							}
						}
						catch( ex )
						{
							bEventResult = false;
							ListElem = _row.Env.ListElem;
							rowsArray.push( ListElem.PrimaryKey );
						}
					_rows = QueryCatalogByKeys( ( bEventResult ? 'event_results' : 'collaborators' ), 'id', rowsArray );
					row_list_field='';
				}
			}
			catch( err )
			{			}

			_num = ArrayCount( _rows );

			if ( _num &gt; 10 &amp;&amp; ! Screen.MsgBox( ms_tools.get_const('8rklpbv2ro'), ms_tools.get_const('c_question'), 'question', 'yes,no,cancel' ) )
				Cancel();
			if ( sTypeParam != 'FinishCourse' && sTypeParam != 'FinishTest' )
			{
				catPerson = ArrayOptFirstElem( _rows );
				if ( catPerson != undefined )
				{
					try
					{
						if ( catPerson.Env.ListElem.ChildExists( 'fullname' ))
						{
							row_disp_elem = 'fullname';
						}
						else
						{
							row_disp_elem = 'person_fullname';
							row_key_field = catPerson.Env.ListElem.ChildExists( 'collaborator_id' ) ? '.collaborator_id' : '.person_id';
						}
					}
					catch(ex)
					{
						row_disp_elem = 'fullname';
						row_key_field = '.PrimaryKey';
					}
				}
			}
			rows = _rows;
			return _num;
	"/>


	<clear_elems PROPERTY="1" EXPR="
			switch ( type_id )
			{
				case 'real_time':
					compound_program_id.Clear();
				case 'compound_program':
					program_id.Clear();
					//education_org_id.Clear();
					if ( education_org_type == 'id' )
						education_org_name.Clear();
					else
						education_org_id.Clear();
					break;
				case 'compound_program_elem':
					education_method_id.Clear();
					education_program_id.Clear();
					education_org_name.Clear();
					education_org_type.Clear();
					break;
				case 'education_method':
					education_program_id.Clear();
					compound_program_id.Clear();
					program_id.Clear();
					break;
				case 'education_method_from_program':
					compound_program_id.Clear();
					program_id.Clear();
					education_org_name.Clear();
					education_org_type.Clear();
					break;
				case 'one_time':
					compound_program_id.Clear();
					program_id.Clear();
					education_method_id.Clear();
					education_program_id.Clear();
				case 'dist_test':
				case 'assessment':
					compound_program_id.Clear();
					program_id.Clear();
					education_method_id.Clear();
					education_program_id.Clear();

					if ( education_org_type == 'id' )
						education_org_name.Clear();
					else
						education_org_id.Clear();

					break;
			}

			if ( type_id != 'real_time' )
			{
				course_id.Clear();
			}

			for ( _phase in phases )
				for ( _collaborator in ArraySelectAll( _phase.collaborators ) )
					if ( ! Child(0).Parent.collaborators.ChildByKeyExists( _collaborator.PrimaryKey ) )
						_collaborator.Delete();
	"/>



	<activate_test PROPERTY="1" PARAM="_test_id" PARAM="_test_doc" PARAM="_duration" PARAM="_start_learning_date" PARAM="_last_learning_date" PARAM="sActTypeParam" PARAM="bSkipDismissed" PARAM="bUseProctoring" PARAM="iProctorPreferID" PARAM="bActivateOnlyAssist" EXPR="
			
			try
			{
				if ( _test_doc == null || _test_doc == '' )
					throw 'no_doc';

				assessmentDoc = _test_doc;
			}
			catch ( ee )
			{
				assessmentDoc = OpenDoc( UrlFromDocID( _test_id ) ).TopElem;
			}

			try
			{
				duration = ( _duration == '' ? '' : Int( _duration ) );
			}
			catch(err)
			{
				duration = null;
			}
			try
			{
				start_learning_date = Date( _start_learning_date );
			}
			catch(err)
			{
				start_learning_date = null;
			}
			try
			{
				last_learning_date = Date( _last_learning_date );
			}
			catch(err)
			{
				last_learning_date = '';
			}
			try
			{
				last_learning_date = Date( _last_learning_date );
			}
			catch ( err )
			{
				last_learning_date = '';
			}
			try
			{
				sActTypeParam;
			}
			catch ( err )
			{
				sActTypeParam = 'all';
			}
			try
			{
				bSkipDismissed;
			}
			catch ( err )
			{
				bSkipDismissed = false;
			}
			
			try
			{
				bActivateOnlyAssist = tools_web.is_true( bActivateOnlyAssist );
			}
			catch ( err )
			{
				bActivateOnlyAssist = false;
			}
			try
			{
				bUseProctoring = tools_web.is_true( bUseProctoring );
			}
			catch ( err )
			{
				bUseProctoring = false;
			}
			try
			{
				iProctorPreferID = OptInt( iProctorPreferID, null );
			}
			catch ( err )
			{
				iProctorPreferID = null;
			}
			
			switch ( sActTypeParam )
			{
				
				case 'prev':
					arrPersonIDs = ArrayExtract( Child(0).Parent.collaborators, 'PrimaryKey' );
					break;
				case 'post':
				default:
					arrPersonIDs = ArrayExtract( XQuery( 'for $elem in event_results where $elem/event_id = ' + Doc.DocID + ' and MatchSome( $elem/person_id, ( ' + ArrayMerge( Child(0).Parent.collaborators, 'PrimaryKey', ',' ) + ' ) )' + ( bActivateOnlyAssist ? ' and $elem/is_assist = true()' : '' ) + ' return $elem' ), 'person_id' );
					//arrPersonIDs = ArrayExtract( Child(0).Parent.collaborators, 'PrimaryKey' );
					break;
			}

			_counter = 0;
			for ( iPersonIDElem in arrPersonIDs )
				try
				{
					oRes = tools.activate_test_to_person( ({
						'iPersonID': iPersonIDElem,
						'iAssessmentID': _test_id,
						'teAssessment': assessmentDoc,
						'iEventID': Doc.DocID,
						'iDuration': duration,
						'dtStartLearningDate': start_learning_date,
						'dtLastLearningDate': last_learning_date,
						'iGroupID': null,
						'bSkipDismissed': bSkipDismissed,
						'bUseProctoring': bUseProctoring,
						'iProctorPreferID': iProctorPreferID
					}) ).TopElem;
					if(OptInt(oRes) == undefined)
						_counter++;
				}
				catch ( err )
				{
				}

			return _counter;
	"/>

	<assign_qualification PROPERTY="1" PARAM="_qualification_id" PARAM="_assignment_date" PARAM="_expiration_date" PARAM="_send_mail" EXPR="

		try
		{
			if ( _qualification_id == null || _qualification_id == '' )
				throw 'no_doc';

			qualificationID = Int(_qualification_id);
		}
		catch ( ee )
		{
			throw 'no_doc';
		}
		try
		{
			assignment_date = Date( _assignment_date );
		}
		catch(err)
		{
			assignment_date = null;
		}

		_counter = 0;
		_qualification_test_array=Array();
		_qualification_course_array=Array();
		for ( _person in Child(0).Parent.collaborators )
			try
			{
				if( tools.assign_qualification_to_person( _person.PrimaryKey, Doc.DocID, qualificationID, assignment_date, _expiration_date,_qualification_test_array,_qualification_course_array, 1, 0, null, null, true ).TopElem.event_id == Doc.DocID )
					_counter++;
			}
			catch ( ff )
			{
				alert(ff)
			}

		return _counter;
	"/>


	<check_request_quote PROPERTY="1" PARAM="_request_id" PARAM="_request_doc" EXPR="
			try
			{
				if ( _request_doc == null || _request_doc == '' )
					throw 'no_doc';

				requestDoc = _request_doc;
			}
			catch ( ee )
			{
				requestDoc = OpenDoc( UrlFromDocID( _request_id ) ).TopElem;
			}

			_add_flag = true;

			if ( quota_org.HasValue || quota_subdivision.HasValue || quota_person.HasValue )
			{
				_counter = 0;
				personIDArray = Array();
				rpIDArray = Array();
				for ( _person in Child(0).Parent.collaborators )
				{
					personIDArray[ _counter ] = _person.PrimaryKey.Value;
					rpIDArray[ _counter ] = _person.request_person_id.Value;
					_counter++;
				}

				if ( requestDoc.is_group )
				{
					for ( _person in requestDoc.persons )
						if ( ! Child(0).Parent.collaborators.ChildByKeyExists( _person.PrimaryKey ) )
						{
							personIDArray[ _counter ] = _person.PrimaryKey.Value;
							rpIDArray[ _counter ] = requestDoc.person_id.Value;
							_counter++;
						}
				}
				else
				{
					if ( ! Child(0).Parent.collaborators.ChildByKeyExists( requestDoc.person_id ) )
					{
						personIDArray[ _counter ] = requestDoc.person_id.Value;
						rpIDArray[ _counter ] = requestDoc.person_id.Value;
					}
				}

				if ( quota_person.HasValue )
				{
					for ( _person in rpIDArray )
					{
						personCounter = 0;
						for ( _person_in in rpIDArray )
							if ( _person == _person_in )
							{
								personCounter++;
								if ( quota_person < personCounter )
								{
									_add_flag = false;
									break;
								}
							}

						if ( ! _add_flag )
							break;
					}
				}

				if ( _add_flag )
				{
					personCounter = 0;
					personArray = Array();
					for ( _person in personIDArray )
					{
						personArray[ personCounter ] = OpenDoc( UrlFromDocID( _person ) ).TopElem;
						personCounter++;
					}


					if ( quota_org.HasValue )
					{
						for ( _person in personArray )
						{
							orgCounter = 0;
							for ( _person_in in personArray )
								if ( _person.org_id == _person_in.org_id )
								{
									orgCounter++;
									if ( quota_org < orgCounter )
									{
										_add_flag = false;
										break;
									}
								}

							if ( ! _add_flag )
								break;
						}
					}

					if ( _add_flag && teEvent.quota_subdivision.HasValue )
					{
						for ( _person in personArray )
						{
							subCounter = 0;
							for ( _person_in in personArray )
								if ( _person.position_parent_id == _person_in.position_parent_id )
								{
									subCounter++;
									if ( quota_subdivision < subCounter )
									{
										_add_flag = false;
										break;
									}
								}

							if ( ! _add_flag )
								break;
						}
					}
				}
			}

			return _add_flag;
	"/>

	<create_event_phases PROPERTY="1" EXPR="
			phaseArray = Child(0).Parent.phases;
			phaseArray.Clear();

			if ( ! finish_date.HasValue )
				return true;

			_end_date = DateNewTime( finish_date );
			_st_time = StrTime( start_date );
			_end_time = StrTime( finish_date );

			for ( i_date=DateNewTime( start_date ); i_date &lt;= _end_date; i_date=DateOffset( i_date, 86400 ) )
			{
				_child = phaseArray.AddChild();
				_child.start_date = Date( StrDate( i_date, false ) + ' ' + _st_time );
				_child.finish_date = Date( StrDate( i_date, false ) + ' ' + _end_time );
				if ( disp_collaborator_phase_presence )
					_child.AssignElem( Child(0).Parent.collaborators );
			}
	"/>

	<filling_event_phases PROPERTY="1" EXPR="
			if ( Child(0).Parent.lectors.ChildNum == 0 &amp;&amp; Child(0).Parent.object_resources.ChildNum == 0 )
				return;

			for ( fldPhaseElem in ArraySelectDistinct( Child(0).Parent.phases, 'start_date' ) )
			{
				for ( fldLectorElem in Child(0).Parent.lectors )
					if ( ArrayOptFind( Child(0).Parent.phases, 'start_date==fldPhaseElem.start_date&amp;&amp;lector_id==' + fldLectorElem.PrimaryKey ) == undefined )
					{
						_child = ArrayOptFind( Child(0).Parent.phases, 'start_date==fldPhaseElem.start_date &amp;&amp; ! lector_id.HasValue &amp;&amp; ! object_resource_id.HasValue' );
						if ( _child == undefined )
							_child = Child(0).Parent.phases.AddChild();
						_child.start_date = fldPhaseElem.start_date;
						_child.finish_date = fldPhaseElem.finish_date;
						_child.lector_id = fldLectorElem.PrimaryKey;
					}
				for ( fldObjectResourceElem in Child(0).Parent.object_resources )
					if ( ArrayOptFind( Child(0).Parent.phases, 'start_date==fldPhaseElem.start_date&amp;&amp;object_resource_id==' + fldObjectResourceElem.PrimaryKey ) == undefined )
					{
						_child = ArrayOptFind( Child(0).Parent.phases, 'start_date==fldPhaseElem.start_date &amp;&amp; ! lector_id.HasValue &amp;&amp; ! object_resource_id.HasValue' );
						if ( _child == undefined )
							_child = Child(0).Parent.phases.AddChild();
						_child.start_date = fldPhaseElem.start_date;
						_child.finish_date = fldPhaseElem.finish_date;
						_child.object_resource_id = fldObjectResourceElem.PrimaryKey;
					}
			}
	"/>



	<distribute_cost_centers PROPERTY="1" EXPR="
			for ( fldPersonElem in Child(0).Parent.collaborators )
				if ( ! fldPersonElem.not_pay )
				{
					fldPersonElem.cost_center_id = tools.get_cost_center_id_by_person_id( fldPersonElem.PrimaryKey );
					if ( fldPersonElem.cost_center_id.HasValue )
						Child(0).Parent.cost_centers.ObtainChildByKey( fldPersonElem.cost_center_id );
				}
			for ( fldCostCenterElem in Child(0).Parent.cost_centers )
				fldCostCenterElem.person_num = ArrayCount( ArraySelectByKey( Child(0).Parent.collaborators, fldCostCenterElem.PrimaryKey, 'cost_center_id' ) );
	"/>

	<distribute_total_cost PROPERTY="1" EXPR="
			if ( distribute_cost_type == 'person' )
			{
				Child(0).Parent.cost_centers.Clear();
				_person_num = ArrayCount( ArraySelectByKey( Child(0).Parent.collaborators, false, 'not_pay' ) ) + ( unnamed_person_num.HasValue ? unnamed_person_num : 0 );
				for ( _person in Child(0).Parent.collaborators )
					if ( ! _person.not_pay )
					{
						_person.expense_items.AssignElem( Child(0).Parent.expense_items );

						for ( _expense_item in Child(0).Parent.expense_items )
						{
							_price = ( _expense_item.sum.HasValue ? _expense_item.sum / _person_num : 0 );
							_person.expense_items.GetChildByKey( _expense_item.PrimaryKey ).sum = _price;

							if ( unnamed_person_num.HasValue )
								_expense_item.unnamed_person_sum = _price * unnamed_person_num;
							else
								_expense_item.unnamed_person_sum.Clear();
						}

						if ( cost_center_type == 'person' )
							_person.cost_center_id = tools.get_cost_center_id_by_person_id( _person.PrimaryKey );
						else
							_person.cost_center_id = default_cost_center_id;
					}
					else
					{
						_person.expense_items.Clear();
						_person.cost_center_id.Clear();
					}
			}
			else
			{
				for ( fldPersonElem in Child(0).Parent.collaborators )
					fldPersonElem.expense_items.Clear();

				iCostCenterNum = 0.0;
				for ( fldCostCenterElem in Child(0).Parent.cost_centers )
					if ( fldCostCenterElem.person_num.HasValue )
						iCostCenterNum += fldCostCenterElem.person_num;

				for ( fldCostCenterElem in Child(0).Parent.cost_centers )
				{
					fldCostCenterElem.expense_items.AssignElem( Child(0).Parent.expense_items );
					if ( iCostCenterNum &gt; 0 &amp;&amp; fldCostCenterElem.person_num.HasValue &amp;&amp; fldCostCenterElem.person_num != 0 )
					{
						for ( fldExpenseItemElem in fldCostCenterElem.expense_items )
						{
							fldExpenseItemChild = Child(0).Parent.expense_items.GetChildByKey( fldExpenseItemElem.PrimaryKey );
							fldExpenseItemElem.sum = ( fldExpenseItemChild.sum.HasValue ? ( fldExpenseItemChild.sum / iCostCenterNum ) * fldCostCenterElem.person_num : 0 )
						}
					}
					else
					{
						for ( fldExpenseItemElem in fldCostCenterElem.expense_items )
							fldExpenseItemElem.sum.Clear();
					}
				}
			}
	"/>


	<obtain_pay_phases PROPERTY="1" EXPR="
			xarrPayPhase = XQuery( 'for $elem in pay_phases where $elem/event_id = ' + Doc.DocID + ' return $elem' );
			if ( ArrayOptFirstElem( xarrPayPhase ) == undefined )
				return false;

			Child(0).Parent.expense_items.Clear();
			Child(0).Parent.cost_centers.Clear();
			arrBudgetPeriod = Array();
			iBudgetPeriodCounter = 0;

			for ( catPayPhaseElem in xarrPayPhase )
			{
				tePayPhase = OpenDoc( UrlFromDocID( catPayPhaseElem.id ) ).TopElem;
				for ( fldExtenseItemElem in tePayPhase.expense_items )
				{
					fldExtenseItemChild = Child(0).Parent.expense_items.ObtainChildByKey( fldExtenseItemElem.PrimaryKey );
					if ( fldExtenseItemElem.sum.HasValue )
					{
						if ( ! fldExtenseItemChild.sum.HasValue )
							fldExtenseItemChild.sum = 0.0;
						fldExtenseItemChild.sum += fldExtenseItemElem.sum;
					}
				}
				for ( fldCostCenterElem in tePayPhase.cost_centers )
				{
					fldCostCenterChild = Child(0).Parent.cost_centers.ObtainChildByKey( fldCostCenterElem.PrimaryKey );
					for ( fldExtenseItemElem in fldCostCenterElem.expense_items )
					{
						fldExtenseItemChild = fldCostCenterChild.expense_items.ObtainChildByKey( fldExtenseItemElem.PrimaryKey );
						if ( fldExtenseItemElem.sum.HasValue )
						{
							if ( ! fldExtenseItemChild.sum.HasValue )
								fldExtenseItemChild.sum = 0.0;
							fldExtenseItemChild.sum += fldExtenseItemElem.sum;
						}
					}
				}
				if ( tePayPhase.budget_period_id.HasValue &amp;&amp; ArrayOptFind( arrBudgetPeriod, 'This==' + tePayPhase.budget_period_id ) == undefined )
				{
					arrBudgetPeriod[ iBudgetPeriodCounter ] = tePayPhase.budget_period_id.Value;
					iBudgetPeriodCounter++;
				}
			}

			if ( iBudgetPeriodCounter == 1 )
			{
				budget_period_id = arrBudgetPeriod[ 0 ];
			}
			else if ( iBudgetPeriodCounter &gt; 1 )
			{
				iLastBudgetPeriodID = null;
				for ( iBudgetPeriodIDElem in arrBudgetPeriod )
					try
					{
						tePayPhase = OpenDoc( UrlFromDocID( iBudgetPeriodIDElem ) ).TopElem;
						if ( tePayPhase.parent_id.HasValue )
						{
							if ( iLastBudgetPeriodID == null )
								iLastBudgetPeriodID = tePayPhase.parent_id;
							else if ( iLastBudgetPeriodID != tePayPhase.parent_id )
								return true;
						}
					}
					catch ( err )
					{
						alert( err );
					}
				if ( iLastBudgetPeriodID != null )
					budget_period_id = iLastBudgetPeriodID;
			}
			return true;
	"/>


	<save_distributed_total_cost PROPERTY="1" PARAM="_result_array" EXPR="
			try
			{
				_result_array;
			}
			catch ( err )
			{
				_result_array = XQuery( 'for $elem in event_results where $elem/event_id = ' + Doc.DocID + ' return $elem' );
			}

			for ( _collaborator in Child(0).Parent.collaborators )
				try
				{
					_result = ArrayOptFindByKey( _result_array, _collaborator.PrimaryKey, 'person_id' );
					if ( _result != undefined )
					{
						docResult = ObtainUiDoc( UrlFromDocID( _result.id ) );
						docResult.TopElem.not_pay = _collaborator.not_pay;
						if ( docResult.TopElem.not_pay )
							docResult.TopElem.expense_items.Clear();
						else
							docResult.TopElem.expense_items.AssignElem( _collaborator.expense_items );
						docResult.TopElem.cost_center_id = _collaborator.cost_center_id;
						docResult.TopElem.budget_period_id = budget_period_id;
						UpdateUiDoc( docResult );
					}
				}
				catch ( err )
				{
					alert( err );
				}
	"/>


	<calc_duration_plan PROPERTY="1" EXPR="
			if ( start_date &lt;= finish_date )
			{
				duration_days_plan = ( ( DateToRawSeconds( DateNewTime( finish_date ) ) - DateToRawSeconds( DateNewTime( start_date ) ) ) / 86400 ) + 1;
				iDurationPlanInSeconds = ( DateToRawSeconds( DateNewTime( start_date, Hour( finish_date ), Minute( finish_date ) ) ) - DateToRawSeconds( start_date ) ) * duration_days_plan;
				rDurationAdd = Real(iDurationPlanInSeconds % 3600) / 3600;
				// Округляем в большую сторону до получаса
				rDurationAdd = (rDurationAdd > 0.5) ? 1 : (rDurationAdd > 0) ? 0.5 : 0;
				duration_plan = Int(iDurationPlanInSeconds / 3600) + rDurationAdd;
				if ( ! duration_fact.HasValue )
					duration_fact = duration_plan;
				if ( ! duration_days_fact.HasValue )
					duration_days_fact = duration_days_plan;
			}
	"/>


	<update_event_results PROPERTY="1" EXPR="
			eventResultArray = XQuery( 'for $elem in event_results where $elem/event_id = ' + Doc.DocID + ' and $elem/event_result_type_id != ' + Child(0).Parent.default_event_result_type_id.XQueryLiteral + ' return $elem' );
			for ( _event_result in eventResultArray )
				try
				{
					docEventResult = OpenDoc( UrlFromDocID( _event_result.id ) );
					docEventResult.TopElem.event_result_type_id = Child(0).Parent.default_event_result_type_id;
					docEventResult.Save();
				}
				catch ( err )
				{
				}
	"/>

	<update_collaborator_common_filling PROPERTY="1" EXPR="
			view.collaborator_array = QueryCatalogByKeys( 'collaborators', 'id', ArrayExtractKeys( collaborators, 'collaborator_id' ) );
			for( _collaborator in collaborators )
			{
				catPerson = ArrayOptFindByKey( view.collaborator_array.Object, _collaborator.PrimaryKey, 'id' );
				if( catPerson != undefined )
				{
					_collaborator.person_fullname = catPerson.fullname;
					_collaborator.person_position_id = catPerson.position_id;
					_collaborator.person_position_name = catPerson.position_name;
					_collaborator.person_org_id = catPerson.org_id;
					_collaborator.person_org_name = catPerson.org_name;
					_collaborator.person_subdivision_id = catPerson.position_parent_id;
					_collaborator.person_subdivision_name = catPerson.position_parent_name;
					_collaborator.person_code = catPerson.code;
				}
			}
	"/>



	<addPerson PROPERTY="1" PARAM="oInputParam" EXPR="
// PARAM [type][mandatory/option][default] - desc:
// iPersonID [integer][mandatory][null] -
// tePerson [topelem][option][null] -
// iEducationPlanID [integer][option][null] -
// iRequestPersonID [integer][option][null] -
// iRequestID [integer][option][null] -
// bDoObtain [bool][option][false] -
// bSaveInEvent [bool][option][true] -
// bDoFilling [bool][option][true] -
// bDoSave [bool][option][true] -
// bCreateEventResult [bool][option][true] -
// bSendNotification [bool][option][true] -
// RESULT [bool][true] - added
// ERRORS 0 - Ok
			try
			{
				oInputParam;
			}
			catch ( err )
			{
				oInputParam = {};
			}
			TopElem = Child(0).Parent;
			oInputParam.SetProperty( 'iEventID', TopElem.Doc.DocID );
			oInputParam.SetProperty( 'docEvent', TopElem.Doc );
			return tools.call_code_library_method( 'libEducation', 'AddPersonToEventXmd', [ oInputParam ] );
	"/>

	<delPerson PROPERTY="1" PARAM="oInputParam" EXPR="
// PARAM [type][mandatory/option][default] - desc:
// iPersonID [integer][mandatory][null] -
// iEventResultId [integer][option][null] -
// bDoSave [bool][option][true] -
// bSendNotification [bool][option][true] -
// RESULT [bool][true] - deleted
// ERRORS 0 - Ok

			try
			{
				oInputParam;
			}
			catch ( err )
			{
				oInputParam = {};
			}
			TopElem = Child(0).Parent;
			oInputParam.SetProperty( 'iEventID', TopElem.Doc.DocID );
			oInputParam.SetProperty( 'docEvent', TopElem.Doc );
			return tools.call_code_library_method( 'libEducation', 'DeletePersonFromEventXmd', [ oInputParam ] );
	"/>

	<changeTutorList PROPERTY="1" PARAM="oInputParam" EXPR="
			if ( status_id != 'close' &amp;&amp; status_id != 'cancel' &amp;&amp; status_id != 'project' )
			{
				//new
				for( _new_tutor in Child(0).Parent.tutors )
					if ( ArrayCount( ArraySelect( Child(0).Parent.view.tutors, 'collaborator_id ==' + _new_tutor.collaborator_id ) ) == 0)
					{
						//tools.create_notification( '51', _new_tutor.collaborator_id, '', Child(0).Parent.Doc.DocID );
						if (Child(0).Parent.event_settings.send_type=='adding')
						{
							if (Child(0).Parent.event_settings.send_tutors)
							{
								tools.create_notification( '51', _new_tutor.collaborator_id, '', Child(0).Parent.Doc.DocID, null, Child(0).Parent );
							}
						}
					}
				//deleted
				for( _old_tutor in Child(0).Parent.view.tutors )
					if ( ArrayCount( ArraySelect( Child(0).Parent.tutors, 'collaborator_id ==' + _old_tutor.collaborator_id ) ) == 0)
					{
						//tools.create_notification( '52', _old_tutor.collaborator_id, '', Child(0).Parent.Doc.DocID, null, Child(0).Parent );
						if (Child(0).Parent.event_settings.send_type=='adding')
						{
							if (Child(0).Parent.event_settings.send_tutors)
							{
								tools.create_notification( '52', _old_tutor.collaborator_id, '', Child(0).Parent.Doc.DocID, null, Child(0).Parent );
							}
						}
					}
			}
			Child(0).Parent.view.tutors.Clear();
			Child(0).Parent.view.tutors.AssignElem( Child(0).Parent.tutors );
	"/>

	<get_info PROPERTY="1" EXPR="
			return tools.extract_bfields_by_list(Child(0).Parent, 'name;type_id;event_type_id;start_date;finish_date;collaborators/collaborator/collaborator_id;collaborators/collaborator/person_fullname', false);
	"/>

	<remove_collaborator PROPERTY="1" PARAM="iPersonIdParam"  EXPR="
		try
		{
			docEvent = Child(0).Parent.Doc;
			iEventId = docEvent.DocID;

			fldPersonChild = docEvent.TopElem.collaborators.GetOptChildByKey( iPersonIdParam );
			if ( fldPersonChild == undefined )
			{
				return false;
			}
			else
			{
				fldPersonChild.Delete();
				docEvent.Save();

				fldEvenResult = ArrayOptFirstElem(XQuery( 'for $elem in event_results where $elem/person_id = ' + iPersonIdParam + ' and $elem/event_id = ' + iEventId + ' return $elem' ));
				if (fldEvenResult != undefined)
				{
					DeleteDoc(UrlFromDocID(fldEvenResult.id));
				}

				return true;
			}
		}
		catch(ex)
		{
			return false;
			alert(ex);
		}

	"/>

	<get_webinar_admin_template PROPERTY="1" PARAM=""  EXPR="
		//return '&lt;LABEL TITLE-EXPR=&quot;\'yyyyyyyyyyyyyyyyyyy\'&quot;/&gt;';
		teEvent = Child(0).Parent;
		if(teEvent.webinar_system_id.HasValue)
		{
			return OpenDoc(UrlFromDocID(teEvent.webinar_system_id)).TopElem.admin_code;
		}
		return '';

	"/>
		
	<!--
	<get_webinar_setting PROPERTY="1" PARAM="sSettingNameParam"  EXPR="
		fldSetting = Child(0).Parent.webinar_settings.ObtainChildByKey(sSettingNameParam);
		return fldSetting;
		/*
		switch(fldSetting.type)
		{
			case 'bool':
				return Bool(fldSetting.value);
				break;
			case 'integer':
				return OptInt(fldSetting.value,null);
			case 'default':
				return fldSetting.value;
				break;
		}
		*/
	"/>
	-->
	
	<call_webinar_system_method PROPERTY="1" PARAM="sMethodNameParam" PARAM="oParams" PARAM="bReloadDocument"  EXPR="
		
		try
		{
			bReloadDocument;
		}
		catch(x)
		{
			bReloadDocument = false;
		}
		
		var oResult = tools.call_webinar_system_method( webinar_system_id, sMethodNameParam, oParams );
		
		return oResult;
	"/>
	
	<get_webinar_setting PROPERTY="1" PARAM="sSettingNameParam" PARAM="sSettingTypeParam" EXPR="
		fldSetting = Child(0).Parent.webinar_settings.GetOptChildByKey(sSettingNameParam);
		if( fldSetting == undefined )
			return '';
		try
		{
			sSettingTypeParam;
		}
		catch(x)
		{
			sSettingTypeParam = fldSetting.type;
		}
		switch(sSettingTypeParam)
		{
			case 'bool':
				return fldSetting.value == 'true' || fldSetting.value == '1' || fldSetting.value;
				break;
			case 'integer':
				return OptInt(fldSetting.value,0);
			default:
				return fldSetting.value;
				break;
		}
	"/>
	
	<set_webinar_setting PROPERTY="1" PARAM="sSettingNameParam" PARAM="sSettingValueParam" PARAM="sSettingTypeParam"  EXPR="
		fldSetting = Child(0).Parent.webinar_settings.ObtainChildByKey(sSettingNameParam);
		fldSetting.value = sSettingValueParam;
		try
		{
			fldSetting.type = sSettingTypeParam;
		}
		catch(x)
		{
		}
	"/>
	
	
	<get_webinar_url PROPERTY="1" PARAM="iUserIdParam" PARAM="sUrl" EXPR="	
		TopElem = Child(0).Parent;
		if( ( TopElem.event_type_id.OptForeignElem != undefined && TopElem.event_type_id.OptForeignElem.online ) &amp;&amp; TopElem.webinar_system_id.HasValue && TopElem.webinar_system_id.OptForeignElem != undefined)
		{
			var oParam = new Object();
			oParam.docEvent = TopElem.Doc;
			oParam.iEventID = TopElem.Doc.DocID;
			oParam.iUserId = iUserIdParam;
			oParam.sUrl = sUrl;
			oResult = TopElem.call_webinar_system_method('getUserLink',oParam);
			return oResult.link;
		}
		else
		{
			return '';
		}
	"/>
	
	<get_webinar_record_url PROPERTY="1" PARAM="sCurrentHostParam" EXPR="	
		TopElem = Child(0).Parent;
		try
		{
			sCurrentHostParam;
		}
		catch(x)
		{
			sCurrentHostParam = '';
		}
		if( ( TopElem.event_type_id.OptForeignElem != undefined && TopElem.event_type_id.OptForeignElem.online ) &amp;&amp; TopElem.webinar_system_id.HasValue && TopElem.webinar_system_id.OptForeignElem != undefined)
		{
			var oParam = new Object();
			oParam.sCurrentHost = sCurrentHostParam;
			try
			{
				oParam.docEvent = TopElem.Doc;
			}
			catch( ex )
			{
				oParam.docEvent = tools.open_doc( TopElem.id );
			}
			oParam.iEventId = TopElem.id;
			oResult = TopElem.call_webinar_system_method('getRecordLink',oParam );
			return oResult.link;
		}
		else
		{
			return '';
		}
	"/>
	
	<get_webinar_record_download_url PROPERTY="1" PARAM="sCurrentHostParam" EXPR="	
		TopElem = Child(0).Parent;
		try
		{
			sCurrentHostParam;
		}
		catch(x)
		{
			sCurrentHostParam = '';
		}
		if( ( TopElem.event_type_id.OptForeignElem != undefined && TopElem.event_type_id.OptForeignElem.online ) &amp;&amp; TopElem.webinar_system_id.HasValue && TopElem.webinar_system_id.OptForeignElem != undefined)
		{
		
			var oParam = new Object();
			oParam.sCurrentHost = sCurrentHostParam;
			try
			{
				oParam.docEvent = TopElem.Doc;
			}
			catch( ex )
			{
				oParam.docEvent = tools.open_doc( TopElem.id );
			}
			oParam.iEventId = TopElem.id;
			oResult = TopElem.call_webinar_system_method('getRecordDownloadLink',oParam );
			return oResult.link;
		}
		else
		{
			return '';
		}
	"/>
	
	<get_finish_date PROPERTY="1" PARAM="sNewDate" EXPR="	
		TopElem = Child(0).Parent;
		if( TopElem.finish_date.HasValue )
		{
			if( TopElem.finish_date < TopElem.start_date )
			{
				TopElem.finish_date = DateOffset( Date( StrDate( TopElem.start_date, false ) + ' ' + StrTime( TopElem.finish_date ) ), 3600 );
			}
			else
			{
				TopElem.finish_date = DateOffset( Date( StrDate( TopElem.finish_date, false ) + ' ' + StrTime( TopElem.finish_date ) ), 3600 );
			}
		}
		else
		{
			TopElem.finish_date = DateOffset( TopElem.start_date, 3600 );
		}
		if( Hour( TopElem.start_date ) > Hour( TopElem.finish_date ) )
		{
			TopElem.finish_date = DateNewTime( DateOffset( TopElem.finish_date, 0 - 86400 ), 23, 59 );
		}
	"/>
	
	<notification_reminders TITLE="##'Настройки уведомлений до начала мероприятия'##">
		<notification_reminder MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" EXPR-INIT="tools.random_string( 5 )"/>
			<minutes TYPE="integer" TITLE="##'Минут до начала мероприятия'##"/>
			<sended TYPE="bool" DEFAULT="false" TITLE="##'Напоминания отправлены'##"/>
		</notification_reminder>
	</notification_reminders>		
	
	<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" TITLE="const=4egocnh7uc"/>
</event>

<OnBeforeSave PROPERTY="1" EXPR="
		TopElem.course_finished = ArrayCount( XQuery( 'for $elem in learnings where $elem/event_id = ' + TopElem.Doc.DocID + ' return $elem' ) );
		xarrActiveLearnings = XQuery( 'for $elem in active_learnings where $elem/event_id = ' + TopElem.Doc.DocID + ' return $elem' );
		TopElem.course_process = ArrayCount( xarrActiveLearnings );
		TopElem.course_started = ArrayCount( ArraySelectByKey( xarrActiveLearnings, 0, 'state_id' ) );
		TopElem.course_began = ArrayCount( ArraySelectByKey( xarrActiveLearnings, 1, 'state_id' ) );

		TopElem.test_finished = ArrayCount( XQuery( 'for $elem in test_learnings where $elem/event_id = ' + TopElem.Doc.DocID + ' return $elem' ) );
		xarrActiveTestLearnings = XQuery( 'for $elem in active_test_learnings where $elem/event_id = ' + TopElem.Doc.DocID + ' return $elem' );
		TopElem.test_process = ArrayCount( xarrActiveTestLearnings );
		TopElem.test_started = ArrayCount( ArraySelectByKey( xarrActiveTestLearnings, 0, 'state_id' ) );
		TopElem.test_began = ArrayCount( ArraySelectByKey( xarrActiveTestLearnings, 1, 'state_id' ) );

		for ( _group in TopElem.educ_groups )
		{
			for ( _person in _group.collaborators )
				if ( !TopElem.collaborators.ChildByKeyExists(_person.collaborator_id) )
					_person.Delete();

			for ( _lector in _group.lectors )
				if ( !TopElem.lectors.ChildByKeyExists(_lector.lector_id) )
					_lector.Delete();
		}

		if( TopElem.start_date.HasValue || TopElem.name.HasValue )
		{
			var er_conds = new Array();
			if( TopElem.start_date.HasValue )
			{
				er_conds.push( '$elem/event_start_date != date(\'' + TopElem.start_date + '\')' );
			}
			if( TopElem.name.HasValue )
			{
				er_conds.push( '$elem/event_name != ' + XQueryLiteral( TopElem.name.Value ) );
			}
			xarrEventResults = XQuery( 'for $elem in event_results where $elem/event_id = ' + TopElem.Doc.DocID + ' and ( ' + ArrayMerge( er_conds, 'This', ' or ' ) + ' ) return $elem' );
			for(catEventResult in xarrEventResults)
			{
				docEventResult = OpenDoc( UrlFromDocID( catEventResult.PrimaryKey ) );
				docEventResult.TopElem.event_start_date = TopElem.start_date;
				docEventResult.TopElem.event_name = TopElem.name;
				docEventResult.Save();
			}
		}

		if ( TopElem.education_org_id.HasValue )
		{
			if ( ! TopElem.education_org_name.HasValue )
			{
				catEducationOrg = TopElem.education_org_id.OptForeignElem;
				if ( catEducationOrg != undefined )
					TopElem.education_org_name = catEducationOrg.disp_name;
			}
		}
		oResult = tools.check_event_fields( TopElem.Doc.DocID, TopElem.Doc, TopElem );

		if( TopElem.need_create_results )
		{
			TopElem.create_results();
			TopElem.need_create_results = false;
		}
//		update_webinar_info(false);
		ms_tools.raise_system_event( 'common_save_event', null, TopElem.Doc.DocID, TopElem.Doc );
"/>

<OnSave PROPERTY="1" EXPR="
	if( TopElem.conversation_id.HasValue )
	{
		tools.call_code_library_method( 'libChat', 'update_conversation_participants', [ TopElem.Doc.DocID, TopElem, TopElem.Name, TopElem.conversation_id ] );
	}
"/>
<OnInit PROPERTY="1" EXPR="
	try
	{
		if ( TopElem.type_id.HasValue &amp;&amp; ! TopElem.event_type_id.HasValue )
		{
			catEventType = ArrayOptFirstElem( XQuery( 'for $elem in event_types where $elem/code = ' + TopElem.type_id.XQueryLiteral + ' return $elem' ) );
			if ( catEventType != undefined )
				TopElem.event_type_id = catEventType.id;
		}
		else if ( ! TopElem.type_id.HasValue &amp;&amp; TopElem.event_type_id.HasValue )
		{
			catEventType = ArrayOptFirstElem( XQuery( 'for $elem in event_types where $elem/id = ' + TopElem.event_type_id + ' return $elem' ) );
			if ( catEventType != undefined )
				TopElem.type_id = catEventType.code;
		}
	}
	catch ( err )
	{
		if ( (tools.spxml_unibridge_stage & tools.UNI_STAGE_COMPLETE) != 0 )
			throw err;
	}
"/>

<OnClientSave PROPERTY="1" EXPR="	

	if( ( ( TopElem.event_type_id.OptForeignElem != undefined && TopElem.event_type_id.OptForeignElem.online ) &amp;&amp; TopElem.webinar_system_id.HasValue && TopElem.webinar_system_id.OptForeignElem != undefined ) || !TopElem.conversation_id.HasValue )
	{
		TopElem.AssignElem(OpenDoc( UrlFromDocID( TopElem.id ) ).TopElem);
	}
"/>
<OnLocalInit PROPERTY="1" EXPR="
		TopElem.view.collaborators.AssignElem( TopElem.collaborators );
		TopElem.view.tutors.AssignElem( TopElem.tutors );
		TopElem.view.lectors.AssignElem( TopElem.lectors );
		TopElem.view.even_preparations.AssignElem( TopElem.even_preparations );

		TopElem.view.last_distribute_cost_type = TopElem.distribute_cost_type;
		TopElem.view.last_default_event_result_type_id = TopElem.default_event_result_type_id;

		TopElem.view.show_result_fields=TopElem.event_settings.show_result_fields

		if (TopElem.Doc.NeverSaved||!TopElem.event_settings.send_type.HasValue)
		{
			TopElem.event_settings.AssignElem( global_settings.settings.event_settings );
		}
"/>
<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('c_event') + ': ' + event.name
"/>

</SPXML-FORM>