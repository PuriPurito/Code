			<start_date TYPE="date"/>
			<finish_date TYPE="date"/>

			<comment TYPE="string"/>
			<reserve_desc TYPE="string" TEMP="1"/>

			<collaborators>
				<collaborator MULTIPLE="1" PRIMARY-KEY="collaborator_id">
					<collaborator_id TYPE="integer" FOREIGN-ARRAY="BaseMultipleElem.Parent.BaseMultipleElem.Parent.Parent.collaborators"/>
					<is_assist TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
				</collaborator>
			</collaborators>
		</phase>
	</phases>
