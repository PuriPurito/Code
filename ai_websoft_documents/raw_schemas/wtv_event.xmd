							}
						}
					}
				//deleted
				for( _old_person in Child(0).Parent.view.lectors )
					if ( ArrayOptFind( Child(0).Parent.lectors, 'lector_id==' + _old_person.lector_id ) == undefined )
					{
						if (event_settings.send_type=='adding')
						{
							if (event_settings.send_lectors)
							{
								tools.create_notification( '56', _old_person.lector_id, '', ( Child(0).Parent.id.HasValue ? Child(0).Parent.id.Value: Child(0).Parent.Doc.DocID ), null, Child(0).Parent );
							}
