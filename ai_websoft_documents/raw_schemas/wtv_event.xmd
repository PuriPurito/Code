			</even_preparation>
		</even_preparations>

		<assessment_plans TEMP="1">
			<assessment_plan MULTIPLE="1" PRIMARY-KEY="assessment_plan_id" TEMP="1">
				<assessment_plan_id TYPE="integer" FOREIGN-ARRAY="event_assessment_plans" TEMP="1"/>
			</assessment_plan>
		</assessment_plans>

		<loop_date TYPE="date" TIME="0" TEMP="1"/>
