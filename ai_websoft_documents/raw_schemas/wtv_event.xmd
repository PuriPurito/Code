	<AddFile PROPERTY="1" PARAM="iResourceIdParam" PARAM="docResourceParam" EXPR="
			try
			{
				doc = docResourceParam;
			}
			catch(x)
			{
				doc = OpenDoc( UrlFromDocID( iResourceIdParam ) );			
			}
			doc.TopElem.add_counter( Child(0).Parent );
			if (!LdsIsServer)
				UpdateScreens( '*', '*resource*' );
			_child = files.AddChild();
			_child.file_id = iResourceIdParam;
	"/>

