<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="position_common">

<position_commons>
	<position_common MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
		<status TYPE="string" FOREIGN-ARRAY="common.position_common_statuss" TITLE="const=c_status"/>

		<min_salary TYPE="real" TITLE="const=pos_min_salary"/>
		<max_salary TYPE="real" TITLE="const=pos_max_salary"/>
		<currency TYPE="string" FOREIGN-ARRAY="lists.currency_types" TITLE="const=c_currency_type"/>
		<position_familys TYPE="string" TITLE="const=re7n9mti11"/>

		<allow_outstaff TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=mozhnoprivlekat"/>

		<knowledge_parts TYPE="string" TITLE="const=vkpb_knowledge_parts_title"/>
		<tags TYPE="string" TITLE="##'ID тегов'##"/>
		<experts TYPE="string" TITLE="const=vkpb_experts"/>
		<kpi_profile_id TYPE="integer" FOREIGN-ARRAY="kpi_profiles" TITLE="const=ass_kpi_profile"/>
		<kpi_profiles_id TYPE="integer" FOREIGN-ARRAY="kpi_profiles" TITLE="const=ass_kpi_profiles" MULTIPLE="1"/>
		<bonus_profile_id TYPE="integer" FOREIGN-ARRAY="bonus_profiles" TITLE="const=629saq8h6f"/>
		<knowledge_profile_id TYPE="integer" FOREIGN-ARRAY="knowledge_profiles" TITLE="const=syqx4l4uo1"/>

		<parent_position_common_id TYPE="integer" INDEXED="1" FOREIGN-ARRAY="position_commons" MULTIPLE="1"/>
		<grade_ids TYPE="integer" INDEXED="1" FOREIGN-ARRAY="grades" TITLE="const=351hlc1f2m" MULTIPLE="1"/>

		<modification_date TYPE="date" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
				position_familys = ArrayMerge(SrcDoc.TopElem.position_familys, 'This.PrimaryKey', ';');

				knowledge_parts = ArrayMerge(SrcDoc.TopElem.knowledge_parts, 'This.PrimaryKey', ';');
				tags = ArrayMerge(SrcDoc.TopElem.tags, 'This.PrimaryKey', ';');
				experts = ArrayMerge(SrcDoc.TopElem.experts, 'This.PrimaryKey', ';');

				for (fldParentPositionElem in SrcDoc.TopElem.parent_position_commons)
					parent_position_common_id.Add().Value = fldParentPositionElem.PrimaryKey;
					
				for (fldGradeElem in SrcDoc.TopElem.grades)
					grade_ids.Add().Value = fldGradeElem.PrimaryKey;
					
				for ( fldRecipientElem in SrcDoc.TopElem.kpi_profiles )
					kpi_profiles_id.ObtainByValue( fldRecipientElem.id );
		"/>
	</position_common>
</position_commons>

</SPXML-FORM>