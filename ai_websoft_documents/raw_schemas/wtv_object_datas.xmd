<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="object_data">

<USE FORM="//wtv/wtv_general.xmd"/>

<object_datas>
	<object_data MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>

		<object_data_type_id TYPE="integer" FOREIGN-ARRAY="object_data_types" TITLE="Тип данных объекта" INDEXED="1"/>

		<budget_period_id TYPE="integer" FOREIGN-ARRAY="budget_periods" TITLE="const=c_budget_period"/>

		<status_id TYPE="string" NOT-NULL="1" DEFAULT="active" FOREIGN-ARRAY="common.request_status_types" TITLE="const=c_status" INDEXED="1"/>
		<create_date TYPE="date" TITLE="const=c_create_date"/>
		<start_date TYPE="date" TITLE="const=c_start_date"/>
		<finish_date TYPE="date" TITLE="const=c_finish_date"/>

		<INHERIT TYPE="object_type_base"/>
		<sec_object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="##'Тип связанного объекта'##"/>
		<sec_object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( object_type + 's' )" INDEXED="1" TITLE="##'Связанный объект'##"/>
		<sec_object_name TYPE="string" INDEXED="1" TITLE="##'Название связанного объекта'##"/>
		
		<data_str TYPE="string" TITLE="##'Данные в каталог'##"/>

		<INHERIT TYPE="admin_access_base"/>

		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>
		<is_std TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
		<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				name = SrcDoc.TopElem.name.HasValue ? SrcDoc.TopElem.name: SrcDoc.TopElem.object_name;
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</object_data>
</object_datas>

</SPXML-FORM>