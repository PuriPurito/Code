<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="object_param">
<USE FORM="//wtv/ms_general.xmd"/>
<object_params>
	<object_param MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<is_enabled TYPE="bool" NOT-NULL="1" DEFAULT="true" TITLE="const=7je8z5lelv"/>
		<start_date TYPE="date" TITLE="const=c_begin" EXPR-INIT="Date()"/>
		<INHERIT TYPE="object_type_base"/>
		<sec_object_code TYPE="string" TITLE="##'Дополнительный идентификатор'##"/>
		
		<base_object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="##'Тип базового объекта'##"/>
		<base_object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( object_type + 's' )" INDEXED="1" TITLE="##'ID базового объекта'##"/>
		<base_object_name TYPE="string" INDEXED="1" TITLE="##'Название связанного объекта'##"/>
		
		<OnBuild PROPERTY="1" EXPR="
			id.Parent.AssignElem( SrcDoc.TopElem );
			base_object_type = SrcDoc.TopElem.base_object.object_type;
			base_object_id = SrcDoc.TopElem.base_object.object_id;
			base_object_name = SrcDoc.TopElem.base_object.object_name;
		"/>
	</object_param>
</object_params>

</SPXML-FORM>