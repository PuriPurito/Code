<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<vendor_state>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<education_org_id TYPE="integer" FOREIGN-ARRAY="education_orgs" TITLE="const=c_org"/>	
	
	<certificate_types>
		<certificate_type MULTIPLE="1" PRIMARY-KEY="certificate_type_id">
			<certificate_type_id TYPE="integer" FOREIGN-ARRAY="certificate_types"/>	
			<required_quantity TYPE="integer"/>
		</certificate_type>
	</certificate_types>
	
	<INHERIT TYPE="file_list_base"/>
	
	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	
	<INHERIT TYPE="admin_access_base"/>
	
	<INHERIT TYPE="custom_elems_base"/>
	
	<view TEMP="1">
		<INHERIT TYPE="desc_base"/>
	</view>
	
</vendor_state>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('statusvendora') + ': ' + vendor_state.name
"/>

</SPXML-FORM>