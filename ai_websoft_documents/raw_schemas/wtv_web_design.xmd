<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/wtv_general.xmd"/>

<web_design>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<css_custom_web_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="const=shablonportalas"/>
	<default_custom_web_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="const=shablonrazmetki"/>
	<home_custom_web_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="const=shablonrazmetki_1"/>
	<resources_url TYPE="string" TITLE="const=otnositelnayass"/>
	<xaml_interpreter_id TYPE="string" FOREIGN-ARRAY="common.xaml_interpreters" TITLE="const=interpretatorx"/>
	<xaml_interpreter_css_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="const=shablonsxamlcss"/>
	<additional_css_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="const=dopolnitelnyysh"/>
	<throbber_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="Шаблон индикатора подгрузки"/>
	<lp_custom_web_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates" TITLE="Шаблон наборов настроек виджетов"/>

	<INHERIT TYPE="web_variables_base"/>

	<is_std TYPE="bool" NULL-FALSE="1" DEFAULT="false" TITLE="const=rnya4h6g63"/>
	<changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="const=izmenennyy"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base"/>
</web_design>


<OnSave PROPERTY="1" EXPR="
		tools.remove_fetch_doc( web_design.id.Value );
"/>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('jkmkd02mw9') + ': ' + web_design.name
"/>

</SPXML-FORM>