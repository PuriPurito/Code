<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<staff_position_move>
	<id TYPE="integer" TITLE="ID"/>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>

	<person_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
	<person_fullname TYPE="string" TITLE="const=lhbyv18qkm"/>

	<subdivision_id TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE="const=c_subd"/>
	<subdivision_name TYPE="string" TITLE="const=uf_depart_name"/>
	<move_subdivision_id TYPE="integer" FOREIGN-ARRAY="subdivisions" TITLE="const=c_subd"/>

	<position_id TYPE="integer" FOREIGN-ARRAY="positions" TITLE="const=c_position"/>
	<position_name TYPE="string" TITLE="const=g89skt4yui"/>
	<move_position_id TYPE="integer" FOREIGN-ARRAY="positions" TITLE="const=c_position"/>

	<staff_position_id TYPE="integer" FOREIGN-ARRAY="staff_positions" TITLE="Позиция штатного рассписания"/>
	<move_staff_position_id TYPE="integer" FOREIGN-ARRAY="staff_positions" TITLE="Позиция штатного рассписания"/>

	<move_date TYPE="date" TITLE="Дата перемещения"/>
	<document TYPE="string" TITLE="Нормативный документ"/>

	<INHERIT TYPE="file_list_base"/>

	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base"/>
	<INHERIT TYPE="admin_access_base"/>

	<INHERIT TYPE="custom_elems_base"/>

</staff_position_move>

<DocDesc PROPERTY="1" EXPR="
		'Кадровое перемещение' + ': ' + staff_position_move.name
"/>

</SPXML-FORM>