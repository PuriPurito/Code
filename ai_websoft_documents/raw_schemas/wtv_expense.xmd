<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<expense>
	<code TYPE="string" TITLE="const=c_code"/>
	<name TYPE="string" TITLE="const=c_name"/>
	<pay_stage_id TYPE="integer" FOREIGN-ARRAY="pay_stages" TITLE="##'Этап договора'##"/>

	<cost TYPE="real" TITLE="const=c_cost"/>
	<currency_type_id TYPE="string" FOREIGN-ARRAY="lists.currency_types" INDEXED="1" TITLE="const=c_currency_type"/>
	<number TYPE="string" TITLE="const=fnxaxirsmo"/>
	<expense_create_date TYPE="date" TITLE="const=c_create_date"/>
	<is_formed TYPE="bool" DEFAULT="false" TITLE="const=sformirovan"/>
	<payment_plan_date TYPE="date"/>
	<is_paid TYPE="bool" DEFAULT="false" TITLE="const=2czyaog3ri"/>
	<payment_fact_date TYPE="date" TITLE="const=dataoplaty"/>
	<bad_debt TYPE="bool" DEFAULT="false" TITLE="##'Безнадежный долг'##"/>
	
	<sent_date TYPE="date"/>
	<sent_type TYPE="string" FOREIGN-ARRAY="common.document_sent_types"/>
	<recipient TYPE="string"/>
	<consignment_document_number TYPE="string"/>
	<sent_messenger_service_id TYPE="integer" FOREIGN-ARRAY="messenger_services"/>
	<back_sent_type TYPE="string" FOREIGN-ARRAY="common.document_sent_types"/>
	<back_sent_messenger_service_id TYPE="integer" FOREIGN-ARRAY="messenger_services"/>
	<is_received TYPE="bool" DEFAULT="false" TITLE="const=polucheno"/>
	<received_date TYPE="date" TITLE="##'Дата получения'##"/>
	<docs_comment TYPE="string" TITLE="const=vkpb_comment"/>

	<comment TYPE="string" TITLE="const=c_comment"/>
	
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	
	<INHERIT TYPE="file_list_base"/>

</expense>

<OnInit PROPERTY="1" EXPR="

"/>

<DocDesc PROPERTY="1" EXPR="
		'Счет' + ': ' + expense.name;
"/>

</SPXML-FORM>