<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="statement_actor">

<USE FORM="//wtv/wtv_general.xmd"/>

<statement_actors>
	<statement_actor MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" TITLE="ID"/>
		<path TYPE="string" TITLE="##'Путь'##"/>
		<name TYPE="string" TITLE="const=c_name"/>
		<object_type TYPE="string" TITLE="##'Тип объекта'##"/>
		
		<statement_id TYPE="integer" FOREIGN-ARRAY="statements" INDEXED="1" TITLE="##'Сообщение учебной активности'##"/>
		
		<mbox TYPE="string" TITLE="##'Адрес электронной почты'##"/>
		<mbox_sha1sum TYPE="string" TITLE="##'Хэш адреса электронной почты'##"/>
		<openid TYPE="string" TITLE="##'OpenID агента'##"/>
		<account_home_page TYPE="string" TITLE="##'Адрес системы хранящей учетную запись'##"/>
		<account_name TYPE="string" TITLE="##'Уникальное название учетной записи'##"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</statement_actor>
</statement_actors>

</SPXML-FORM>