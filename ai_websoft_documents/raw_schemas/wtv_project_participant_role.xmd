<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<project_participant_role>
	<INHERIT TYPE="object_code_name_base"/>

	<project_id TYPE="integer" FOREIGN-ARRAY="projects" TITLE="const=c_project"/>
	<participant_num TYPE="integer" TITLE="##'Количество участников'##"/>
	
	<provider_id TYPE="integer" FOREIGN-ARRAY="providers" TITLE="##'Продукт/услуга(CRM)'##"/>

	<INHERIT TYPE="file_list_base"/>

	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base"/>

	<access TITLE="const=bmlkskx7us">
		<INHERIT TYPE="access_doc_base"/>
	</access>
	<INHERIT TYPE="admin_access_base"/>

	<INHERIT TYPE="knowledge_parts_base"/>

	<view TEMP="1">
		<INHERIT TYPE="desc_base"/>
	</view>

</project_participant_role>

<DocDesc PROPERTY="1" EXPR="
		'Роль участника проекта' + ': ' + project_participant_role.name
"/>

</SPXML-FORM>