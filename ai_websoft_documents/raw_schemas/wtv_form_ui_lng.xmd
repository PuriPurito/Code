<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<ui_lng>
	<id TYPE="string"/>
	<short_id TYPE="string"/>
	<name TYPE="string"/>
	<lng_file_url TYPE="string"/>

	<common_url TYPE="string"/>
	<startup_page_document_id TYPE="integer" FOREIGN-ARRAY="documents"/>

	<ui_disp TYPE="bool" NOT-NULL="1" DEFAULT="false"/>

	<recovery_date TYPE="date"/>

	<fullname_sequence TYPE="string"/>

	<items>
		<item MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string"/>
			<val TYPE="string"/>
			<web TYPE="bool" NULL-FALSE="1" DEFAULT="false"/>
		</item>
	</items>
</ui_lng>

</SPXML-FORM>