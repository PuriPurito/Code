<workflow_data_base SAMPLE="1">
	<workflow_id TYPE="integer" FOREIGN-ARRAY="workflows"/>
	<workflow_state TYPE="string"/>
	<workflow_state_name TYPE="string"/>
	<workflow_state_last_date TYPE="date"/>
	<get_workflow_state_name PROPERTY="1" PARAM="workflowDoc" EXPR="
			if ( ! workflow_id.HasValue )
				return '';

			try
			{
				if ( workflowDoc == null || workflowDoc == '' )
					throw 'no doc';
			}
			catch ( err )
			{
				try
				{
					workflowDoc = OpenDoc( UrlFromDocID( workflow_id ) ).TopElem;
				}
				catch( e )
				{
					return global_settings.object_deleted_str + ' 0x' + StrHexInt( workflow_id, 16 );
				}
			}

			curState = workflowDoc.states.GetOptChildByKey( workflow_state );
			curState = ( curState == undefined ? workflow_custom_states.GetOptChildByKey( workflow_state ) : curState );
			if ( curState == undefined )
				return '';
			else
				return curState.name;
	"/>
	<set_workflow_state_last_date PROPERTY="1" PARAM="Param" EXPR="
			if ( ! workflow_id.HasValue )
				return '';

			if(Param == undefined || Param == null || Param == '' )
				Param = {};

			var workflowDoc = Param.GetOptProperty('workflow');

			try
			{
				if ( workflowDoc == undefined || workflowDoc == null || workflowDoc == '' )
					throw 'no doc';
			}
			catch ( err )
			{
				try
				{
					workflowDoc = OpenDoc( UrlFromDocID( workflow_id ) ).TopElem;
				}
				catch( e )
				{
					return global_settings.object_deleted_str + ' 0x' + StrHexInt( workflow_id, 16 );
				}
			}

			var state = Param.GetOptProperty('workflow_state');
			var cur_workflow_state = (state == undefined || state == null || state == '' ) ? workflow_state : state;

			var oCurState = workflowDoc.states.GetOptChildByKey( cur_workflow_state );
			oCurState = ( oCurState == undefined ? workflow_custom_states.GetOptChildByKey( cur_workflow_state ) : oCurState );
			if ( oCurState == undefined )
				return '';

			var state_duration = Param.GetOptProperty('state_duration');
			var cur_state_duration = (state_duration == undefined || state_duration == null || state_duration == '' ) ? oCurState.duration.Value : state_duration;

			var finish_date = Param.GetOptProperty('finish_date');

			if(cur_state_duration != undefined && cur_state_duration != null && cur_state_duration != '' )
			{
				var start_date = Param.GetOptProperty('start_date');
				var cur_start_date = (start_date == undefined || start_date == null || start_date == '' ) ? Date() : Date(start_date);

				var cur_finish_date = (finish_date == undefined || finish_date == null || finish_date == '' ) ? DateNewTime(DateOffset(cur_start_date,86400*Int(cur_state_duration))) : Date(finish_date);
				workflow_state_last_date = DateNewTime(cur_finish_date, 23, 59, 59);
			}
			else if(finish_date != undefined && finish_date != null && finish_date != '' )
			{
				workflow_state_last_date = DateNewTime(finish_date, 23, 59, 59);
			}

	"/>
	<add_workflow_log_entry PROPERTY="1" PARAM="Param" EXPR="
			if(Param == undefined || Param == null || Param == '' )
				Param = {};

			var finish_state = Param.GetOptProperty('finish_state');
			var begin_state = Param.GetOptProperty('begin_state');
			if(finish_state == undefined && begin_state == undefined)
			{
				return '';
			}
			else if (finish_state == undefined && begin_state != undefined)
			{
				finish_state = workflow_state;
			}
			else if (finish_state != undefined && begin_state == undefined)
			{
				begin_state = workflow_state;
			}

			if (finish_state != begin_state)
			{
				var person_id = Param.GetOptProperty('person_id', 0);
				var person_fullname = Param.GetOptProperty('person_fullname', '');
				var action_id = Param.GetOptProperty('action_id', '');

				_log_entry = workflow_log_entrys.AddChild();
				_log_entry.create_date = Date();
				_log_entry.begin_state = begin_state;
				_log_entry.finish_state = finish_state;
				if(person_id > 0) _log_entry.person_id = person_id;
				if(person_fullname != '') _log_entry.person_fullname = person_fullname;
				if(action_id != '') _log_entry.action_id = action_id;
			}
	"/>
	<is_workflow_init TYPE="bool" NOT-NULL="1" DEFAULT="false"/>

	<workflow_fields>
		<workflow_field MULTIPLE="1" PRIMARY-KEY="name">
			<name TYPE="string"/>
			<value TYPE="string"/>
			<workflow_state TYPE="string"/>
		</workflow_field>
	</workflow_fields>

	<workflow_log_entrys>
		<workflow_log_entry MULTIPLE="1" PRIMARY-KEY="create_date">
			<create_date TYPE="date" EXPR-INIT="Date()"/>
			<action_id TYPE="string"/>
			<person_id TYPE="integer" FOREIGN-ARRAY="collaborators"/>
			<person_fullname TYPE="string"/>
			<begin_state TYPE="string"/>
			<finish_state TYPE="string"/>
			<submited TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
		</workflow_log_entry>
	</workflow_log_entrys>

	<workflow_custom_states>
		<workflow_custom_state MULTIPLE="1" PRIMARY-KEY="code">
			<code TYPE="string" EXPR-INIT="'cs' + tools.random_string( 5 )"/>
			<name TYPE="string"/>
			<next_workflow_custom_state_code TYPE="string" FOREIGN-ARRAY="parent.parent"/>
			<common_state_code TYPE="string"/>

			<conditions>
				<condition MULTIPLE="1">
					<type TYPE="string" DEFAULT="cur_person"/>
					<cur_user_type TYPE="string" DEFAULT="cur_person"/>
					<person_id TYPE="integer" FOREIGN-ARRAY="collaborators"/>
					<and_or TYPE="string" NOT-NULL="1" DEFAULT="||"/>
					<begin_bracket TYPE="string"/>
					<finish_bracket TYPE="string"/>
				</condition>
			</conditions>
			<condition_eval_str TYPE="string"/>
		</workflow_custom_state>
	</workflow_custom_states>
</workflow_data_base>




<condition_base SAMPLE="1">
	<type TYPE="string"/><!-- if_workflow_state_id, if_workflow_field_value, if_eval_str, if_cur_user, if_custom_workflow_state_id, if_statement_date -->
	<workflow_field_id TYPE="string"/>
	<workflow_field_value TYPE="string"/>
	<workflow_state_id TYPE="string"/><!-- last_custom_state, next_custom_state  -->
	<cur_user_type TYPE="string"/><!-- is_boss, is_main_boss, is_next_boss, cur_parent_object_id, is_cost_center_boss, cur_person, cur_access_role, cur_position_id, cur_group_id, person_func_manager, org_func_manager, func_manager -->
	<and_or TYPE="string" NOT-NULL="1" DEFAULT="&amp;&amp;"/>
	<begin_bracket TYPE="string"/>
	<finish_bracket TYPE="string"/>
	<usl TYPE="string"/>
	<person_id TYPE="integer" FOREIGN-ARRAY="collaborators"/>
	<eval_str TYPE="string"/>
	<cur_access_role TYPE="string" FOREIGN-ARRAY="access_roles"/>
	<cur_parent_object_id TYPE="integer" FOREIGN-ARRAY="subdivisions"/>
	<org_id TYPE="integer" FOREIGN-ARRAY="orgs"/>
	<cur_position_id TYPE="integer" FOREIGN-ARRAY="positions"/>
	<cur_group_id TYPE="integer" FOREIGN-ARRAY="groups"/>
	<cur_activity_id TYPE="integer" FOREIGN-ARRAY="activitys"/>
</condition_base>

<conditions_base SAMPLE="1">
	<conditions>
		<condition MULTIPLE="1">
			<INHERIT TYPE="condition_base"/>
		</condition>
	</conditions>
	<condition_eval_str TYPE="string"/>
	<desc_str TYPE="string"/>
	<has_error TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
	<warning_str TYPE="string" TEMP="1"/>
	<error_str TYPE="string" TEMP="1"/>

	<is_false TYPE="bool" NOT-NULL="1" DEFAULT="false"/>

	<error_eval PROPERTY="1" EXPR="
		_str = '';
		_err_str = '';
		_warn_str = '';
		_begin_bracket_count = 0;
		_finish_bracket_count = 0;

		if ( ! is_false )
		{
			for ( _condition in conditions )
			{
				_child_index = _condition.ChildIndex + 1;
				if ( _condition.begin_bracket != '' )
				{
					_str = _str + '( ';
					_begin_bracket_count++;
				}

				if ( _condition.type == '' )
					_err_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('9auj6p2c4f') + '\n';

				switch ( _condition.type )
				{
					case 'if_workflow_state_id':
						_str += StrNonTitleCase( ms_tools.get_const('23h1m82jwu') ) + ' ';
						if ( _condition.workflow_state_id == '' )
							_str += '-' + ms_tools.get_const('8nq3kv7h7m') + '- ';
						else
							_str += '&quot;' + Doc.TopElem.states.GetChildByKey( _condition.workflow_state_id ).name + '&quot; ';

						break;

					case 'if_custom_workflow_state_id':
						_str += ms_tools.get_const('c136i4h31p') + ' - ';
						switch ( _condition.workflow_state_id )
						{
							case 'last_custom_state':
								_str += StrNonTitleCase( ms_tools.get_const('oh73zg77c2') ) + ' ';
								break;

							case 'next_custom_state':
								_str += StrNonTitleCase( ms_tools.get_const('e493ylsgy7') ) + ' ';
								break;

							default:
								_err_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('nv5yhze7tw') + '\n';
								break;
						}
						break;

					case 'if_eval_custom_conditions':
						_str += StrNonTitleCase( ms_tools.get_const('rrsxx3x1mw') ) + ' ';
						break;

					case 'if_workflow_field_value':
						_str += StrNonTitleCase( ms_tools.get_const('z0icjx5c2y') ) + ' ';

						if ( _condition.workflow_field_id != '' )
						{
							_field = Doc.TopElem.workflow_fields.GetChildByKey( _condition.workflow_field_id );
							_str = _str + '&quot;' + _field.title + '&quot; ';

							if ( _field.type == 'bool' || _field.type == 'combo' )
								_str = _str + StrNonTitleCase( ms_tools.get_const('vieb_eq') );
							else
							{
								if ( _condition.usl != '' )
									_str = _str + common.all_option_types.GetChildByKey( _condition.usl ).title + ' ';
								else
									_err_str = _err_str + ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('f6kudrsohy') + '\n';
							}

							_str = _str + '&quot;' + _condition.workflow_field_value + '&quot; ';

							if ( _condition.workflow_field_value == '' )
								_warn_str = _warn_str + ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('nt2cf4t3uw') + '\n';
						}
						else
							_err_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('zhxjanhnnd') + '\n';

						break;

					case 'if_cur_user':
						_str += StrNonTitleCase( ms_tools.get_const('tepvynu6zw') ) + ' -&gt; ';
						if ( _condition.cur_user_type != '' )
						{
							switch ( _condition.cur_user_type )
							{
								case 'is_self_cur_user':
									_str += StrNonTitleCase( ms_tools.get_const('samtekushiypolz') ) + ' ';
									break;

								case 'is_boss':
									_str += StrNonTitleCase( ms_tools.get_const('46uy4fushf') ) + ' ';
									break;

								case 'is_real_boss':
									_str += StrNonTitleCase( ms_tools.get_const('z1l2kdx3wa') ) + ' ';
									break;

								case 'is_next_boss':
									_str += StrNonTitleCase( ms_tools.get_const('qbfalyyx9s') ) + ' ';
									break;

								case 'is_main_boss':
									_str += StrNonTitleCase( ms_tools.get_const('9bgfgwpwpb') ) + ' ';
									break;
								case 'is_project_manager':
									_str += StrNonTitleCase( ms_tools.get_const('rukovoditelpro') ) + ' ';
									break;

								case 'is_cost_center_boss':
									_str += StrNonTitleCase( ms_tools.get_const('5lp99uvlk8') ) + ' ';
									break;

								case 'cur_person':
									if ( _condition.person_id.HasValue )
										_str += _condition.person_id.ForeignElem.fullname + ' ';
									else
										_err_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('iorjbemm4m') + '\n';
									break;

								case 'cur_access_role':
									
									if ( _condition.cur_access_role.HasValue )
										_str += StrNonTitleCase( ms_tools.get_const('flktg1b42x') ) + _condition.cur_access_role.ForeignElem.name + '&quot; ';
									else
									{
										_str = _str + StrNonTitleCase( ms_tools.get_const('exrpcedbbe') );
										_err_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('x9r7k4h22s') + '\n';
									}
									break;

								case 'cur_parent_object_id':
								{
									_str += StrNonTitleCase( ms_tools.get_const('46uy4fushf') );
									if ( _condition.cur_parent_object_id.HasValue )
									{
										docObject = tools.open_doc( _condition.cur_parent_object_id );
										_str += '&quot;' + ( docObject == undefined ? '[DELETED]' : docObject.TopElem.name ) + '&quot; ';
									}
									else
									{
										_err_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('yihs9pjdmh') + '\n';
									}
									break;
								}

								case 'cur_position_id':
								{
									_str += StrNonTitleCase( ms_tools.get_const('j2djxoif7m') ) + ' ';
									if ( _condition.cur_position_id.HasValue )
									{
										docObject = tools.open_doc( _condition.cur_position_id );
										_str += '&quot;' + ( docObject == undefined ? '[DELETED]' : docObject.TopElem.name ) + '&quot; ';
									}
									else
									{
										_err_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('uf_no_position_mess') + '\n';
									}
									break;
								}

								case 'cur_group_id':
								{
									_str += StrNonTitleCase( ms_tools.get_const('4zbtg4rvcp') ) + ' ';
									if ( _condition.cur_group_id.HasValue )
									{
										docObject = tools.open_doc( _condition.cur_group_id );
										_str += '&quot;' + ( docObject == undefined ? '[DELETED]' : docObject.TopElem.name ) + '&quot; ';
									}
									else
									{
										_err_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('xlkfurrfrh') + '\n';
									}
									break;
								}

								case 'is_person_func_manager':
									_str += StrNonTitleCase( ms_tools.get_const('9b5ocuwstn') ) + ' ';
									break;

								case 'is_person_org_func_manager':
									_str += StrNonTitleCase( ms_tools.get_const('nvtau5cvr8') ) + ' ';
									break;

								case 'is_func_manager':
									_str += StrNonTitleCase( ms_tools.get_const('xv10a8wdj6') ) + ' ';
									break;
							}
						}
						else
						{
							_warn_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('y2gjklr5fj') + '\n';
						}

						break;

					case 'if_eval_str':
						_str += ms_tools.get_const('ezkdjdygtr') + ' ';
						if ( _condition.eval_str == '' )
							_warn_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('34nkb78n1i') + '\n';
						break;

					case 'if_statement_date':
						_str += StrNonTitleCase( 'Дата учебной активности' );
						if ( _condition.usl.HasValue )
							_str += ' ' + common.all_option_types.GetChildByKey( _condition.usl ).title;
						else
							_err_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('f6kudrsohy') + '\n';
						_str += ' &quot;' + _condition.workflow_field_value + '&quot; ';
						if ( ! _condition.workflow_field_value.HasValue )
							_warn_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('nt2cf4t3uw') + '\n';
						break;
				}

				if ( _condition.finish_bracket != '' )
				{
					_str += ') ';
					_finish_bracket_count++;
				}

				if ( _child_index != _condition.Parent.ChildNum )
				{
					if ( _condition.and_or == '' )
						_err_str += ' - ' + ms_tools.get_const('53qwe5qsk6') + _child_index + '. ' + ms_tools.get_const('12b9ms9gqt') + '\n';
					else
						_str += ( _condition.and_or == '||' ?  ms_tools.get_const('f7xvdaks2i') : ms_tools.get_const('o6sipcc6b9') ) + ' ';
				}
			}

			if ( _finish_bracket_count != _begin_bracket_count )
				_err_str += ' - ' + ms_tools.get_const('ykzv9zysro') + ( _finish_bracket_count &lt; _begin_bracket_count ? StrNonTitleCase( ms_tools.get_const('9msvrstjo3') ) : StrNonTitleCase( ms_tools.get_const('5vjbbh2s5w') ) ) + ms_tools.get_const('2eamvv6ywy') + '\n';
		}

		desc_str = ( _str == '' ? '' : ms_tools.get_const('3zlci74cr3') + ' ' + _str + '.' );
		warning_str = _warn_str;
		error_str = _err_str;
		has_error = ( _err_str != '' );
	"/>
</conditions_base>




<person_filling_base SAMPLE="1">
