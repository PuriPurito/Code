<expense_distribution_base SAMPLE="1"><!-- copy to @component core_events, core_finance -->
	<expense_items>
		<expense_item MULTIPLE="1" PRIMARY-KEY="expense_item_id">
			<expense_item_id TYPE="integer" FOREIGN-ARRAY="expense_items"/>
			<sum TYPE="real" DEFAULT="0.0"/>
			<total_sum TYPE="real" DEFAULT="0.0" PRECISION="2" TEMP="1"/>
			<unnamed_person_sum TYPE="real" DEFAULT="0.0" PRECISION="2"/>
		</expense_item>
	</expense_items>
	<expense_item_sum PROPERTY="1" EXPR="
			_expense_sum = 0.0;
			for ( _expense_item in Child(0).Parent.expense_items )
				if ( _expense_item.sum.HasValue )
					_expense_sum += _expense_item.sum;
			return _expense_sum;
	"/>
</expense_distribution_base>



