				<test_weight TYPE="real" NOT-NULL="1" DEFAULT="0"/>
				<statuses>
					<status MULTIPLE="1" PRIMARY-KEY="status_id">
						<status_id TYPE="string" FOREIGN-ARRAY="common.assessment_appraise_participants"/>
						<mark TYPE="real" NOT-NULL="1" DEFAULT="0"/>
						<count TYPE="integer" NOT-NULL="1" DEFAULT="0"/>
						<weight TYPE="real" NOT-NULL="1" DEFAULT="0"/>
					</status>
				</statuses>
			</competence>
		</competences>

		<global_results>
			<previous_mark TYPE="real" NOT-NULL="1" DEFAULT="0"/>
			<previous_weight TYPE="real" NOT-NULL="1" DEFAULT="0"/>
			<current_weight TYPE="real" NOT-NULL="1" DEFAULT="100"/>
			<result_mark TYPE="real"/>
		</global_results>
	</block>
</blocks>

</view_assessment_appraise_competence_report_base>

<development_plan_data_base SAMPLE="1">
	<competences TITLE="const=ass_competences">
