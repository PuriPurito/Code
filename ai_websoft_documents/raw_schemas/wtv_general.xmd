					<scheme_id TYPE="string" FOREIGN-ARRAY="lists.view_conditions_schemes"/>
				</catalog_chain>
			</catalog_chains>
			<flag_value_filter TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
			<flag_is_parameter TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
			<flag_hierarchy TYPE="integer" NOT-NULL="1" DEFAULT="0"/>
			<flag_active TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
			<open_bracket TYPE="string"/>
			<close_bracket TYPE="string"/>
		</criterion>
	</criterions>
</criterion_base>

<custom_report_base SAMPLE="1">
	<object_name_type TYPE="string" NOT-NULL="1" DEFAULT="exchange_object_types"/>
	<object_name TYPE="string" FOREIGN-ARRAY="common.Child(object_name_type)"/>
	<INHERIT TYPE="criterion_base"/>

	<flag_open_param_tun_section TYPE="bool" NOT-NULL="1" DEFAULT="false"/>

	<flag_custom_x TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
	<custom_x TYPE="string"/>

	<INHERIT TYPE="column_base"/>

	<INHERIT TYPE="chart_report_graph_base"/>
	<show_table TYPE="bool" DEFAULT="true" NOT-NULL="1"/>
	<show_chart TYPE="bool" DEFAULT="false" NOT-NULL="1"/>

	<view_temp TEMP="1">
		<color_main TYPE="string" NOT-NULL="1" DEFAULT="223,223,223" TEMP="1"/>
		<color_secondary TYPE="string" NOT-NULL="1" DEFAULT="255,255,255" TEMP="1"/>
		<color_total TYPE="string" NOT-NULL="1" DEFAULT="200,200,200" TEMP="1"/>
		<expanded_temporary TYPE="bool" TEMP="1"/>
		<cur_lng TYPE="string" TEMP="1"/>
	</view_temp>

	<report_result TEMP="1" TYPE="variant"/>

	<get_report_data PROPERTY="1" PARAM="iReportID_PARAM" PARAM="iUserID_PARAM" EXPR="
		try
		{
			if (report_result.HasValue)
				report_result.Object.inforow;
			else
				report_result = OpenDoc('x-local://trash/temp/custom_reports/' + StrHexInt(Int(iReportID_PARAM)) + StrHexInt(Int(iUserID_PARAM)) + '.xml', 'form=x-local://wtv/wtv_form_custom_report_data.xmd').TopElem;
			vReportResult = report_result.Object;

			//if (vReportResult.person_id != iUserID_PARAM) throw 'access denied';

		}
		catch(_X_)
		{
			vReportResult = null;
		}
		return vReportResult;
	"/>
	<get_crit_hash PROPERTY="1" EXPR="
			return criterions.ChildNum &gt; 0 ? Md5Hex(ArrayMerge(ArrayExtract(criterions.Clone(), 'This.value.Clear(),This.column_title.Clear(),This'), 'This.GetXml(\'tabs=0\')', '')) : 0;
	"/>
	<extractVolatileData PROPERTY="1" EXPR="

		customReport = Child(0).Parent;

		var fldCrit, oOutput = ({'c': null, 'iv': null, 'exid': null, 'sort': null, 'dir': false, 'chart': null, '_chsh': get_crit_hash()});

		for (fldCrit in customReport.criterions)
		{
			if (oOutput.c == null)
				oOutput.c = new Array();

			if (fldCrit.flag_is_parameter.Value)// && fldCrit.flag_active.Value)
				oOutput.c.push({v:fldCrit.value.Value, a:fldCrit.flag_active.Value, o: fldCrit.option_type.Value })
			else
				oOutput.c.push(false);
		}

		if (customReport.integrated_criterion_value.HasValue)
			oOutput.iv = customReport.integrated_criterion_value.Value;

		if (customReport.chart_id.HasValue)
			oOutput.chart = customReport.chart_id.Value;

		if (customReport.sort.col_index.HasValue)
		{
			oOutput.sort = customReport.sort.col_index.Value;
			oOutput.dir = (customReport.sort.asc == true);
		}
		return oOutput;
	"/>
	<condenseVolatileData PROPERTY="1" PARAM="oVolatile" EXPR="
		var i, vc, customReport = Child(0).Parent;

		if (oVolatile.c != null)
			for (i = ArrayCount(oVolatile.c) - 1; i &gt;= 0; i--)
			{
				vc = oVolatile.c[i];
				if (vc !== false)
				{
					customReport.criterions.Child(i).value = vc.v;
					if ( vc.HasProperty( 'a' ) )
					{
						customReport.criterions.Child(i).flag_active = vc.a;
					}
					if ( vc.HasProperty( 'o' ) )
					{
						customReport.criterions.Child(i).option_type = vc.o;
					}
				}
				//else customReport.criterions.Child(i).value.Clear();
			}
		if (oVolatile.GetOptProperty('iv') != undefined)
			customReport.integrated_criterion_value = oVolatile.iv;

		if (oVolatile.exid != null)
			customReport.initiator_person_id = oVolatile.exid;

		if (customReport.integrated_criterion_value.HasValue)
			oVolatile.iv = customReport.integrated_criterion_value.Value;

		if (oVolatile.sort != null)
		{
			customReport.sort.col_index.Value = oVolatile.sort;
			customReport.sort.asc = oVolatile.dir == true;
		}

		if (oVolatile.chart != null)
			customReport.chart_id = oVolatile.chart;
	"/>
	<!--
	<report_result>
		<header>
			<INHERIT TYPE="column_base"/>
		</header>
		<rows>
			<row MULTIPLE="1">
				<id TYPE="integer"/>
				<INHERIT TYPE="column_base"/>
				<bg_color TYPE="string"/>
				<mark_delete TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
				<flag_expanded TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
				<flag_main TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
			</row>
		</rows>
	</report_result>
	-->
	<report_result_date TYPE="date"/>
	<report_result_author TYPE="string"/>

	<performance_launch_time TYPE="date"/>
	<performance_search_time TYPE="date"/>
	<performance_process_time TYPE="date"/>

	<sort>
		<col_index TYPE="integer"/>
		<asc TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
	</sort>

	<categorize TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
	<categorize_view TYPE="string" NOT-NULL="1" DEFAULT="plain"/>
	<categorize_hide_details TYPE="bool" NOT-NULL="1" DEFAULT="false"/>

	<aggregations>
		<aggregation MULTIPLE="1">
			<aggregate_function TYPE="string"/>
			<aggregate_column TYPE="integer"/>
			<flag_graph TYPE="bool" DEFAULT="true"/>
			<aggregate_secondary>
				<option_type TYPE="string" NOT-NULL="1" DEFAULT="eq" FOREIGN-ARRAY="common.all_option_types"/>
				<column_value TYPE="string"/>
			</aggregate_secondary>
		</aggregation>
	</aggregations>

	<show_total TYPE="bool" NOT-NULL="1" DEFAULT="false"/>

	<integrated_criterion_field TYPE="string"/>
	<integrated_criterion_field_is_custom TYPE="bool"/>
	<integrated_criterion_value TYPE="string"/>

</custom_report_base>

