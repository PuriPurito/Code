<custom_elems_base SAMPLE="1">
	<custom_elems TITLE="const=wlcwah2eod">
		<custom_elem MULTIPLE="1" PRIMARY-KEY="name" FT-NAME-EXPR="name" FT-VALUE-EXPR="tools.get_ft_value( value )">
			<name TYPE="string" TITLE="const=c_name"/>
			<value TYPE="string" TITLE="const=c_value"/>
		</custom_elem>
	</custom_elems>
	<check_fields_default_value PROPERTY="1" PARAM="curUser" EXPR="
		try
		{
			curUser.Name;
		}
		catch( err )
		{
			curUser = null;
		}
		TopElem = Child(0).Parent;
		var fldCustomElems = tools.get_custom_template( TopElem.Name, null, TopElem );
		var sDefaultValue;
		var GEnv = { curObject: TopElem, curUser: curUser };
		if ( fldCustomElems != null )
		{
			for( _field in fldCustomElems.fields )
			{
				if( !TopElem.custom_elems.ObtainChildByKey( _field.name ).value.HasValue )
				{
					if( _field.default_value_eval.HasValue )
					{
						sDefaultValue = '';
						try
						{
							sDefaultValue = SafeEval( _field.default_value_eval, [ { GEnv: GEnv } ] );
						}
						catch( ex )
						{
						}
						if( sDefaultValue != '' )
						{
							TopElem.custom_elems.ObtainChildByKey( _field.name ).value = sDefaultValue;
						}
					}
				}
			}
		}
	"/>

	<custom_report_fictions TEMP="1">
		<custom_report_fiction TEMP="1" MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="integer"/>
			<name TYPE="string"/>
			<INHERIT TYPE="custom_report_base"/>
		</custom_report_fiction>
	</custom_report_fictions>
</custom_elems_base>

<estimation_levels_base SAMPLE="1">
	<estimation_levels>
