	<flag_open_graph_tun_section TYPE="bool" TEMP="1" NOT-NULL="1" DEFAULT="false"/>
</chart_report_graph_base>

<criterion_base SAMPLE="1">
	<INHERIT TYPE="field_names_base"/>
	<criterions>
		<criterion MULTIPLE="1">
			<value TYPE="string"/>
			<column_title TYPE="string"/>
			<type TYPE="string"/>
			<option_type TYPE="string" NOT-NULL="1" DEFAULT="eq" FOREIGN-ARRAY="common.all_option_types"/>
			<and_or TYPE="string" NOT-NULL="1" DEFAULT="and"/>
			<is_custom_field TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
