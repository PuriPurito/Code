					<catalog TYPE="string" FOREIGN-ARRAY="common.exchange_object_types"/>
					<education_objects>
						<education_object MULTIPLE="1" PRIMARY-KEY="education_object_id">
							<education_object_id TYPE="integer" FOREIGN-ARRAY="XQuery(education_object_catalog + 's')"/>
						</education_object>
