					<target_date TYPE="date"/>
					<value TYPE="string"/>
					<status TYPE="string" FOREIGN-ARRAY="common.assessment_appraise_statuses"/>
					<comment TYPE="string"/>
				</aim>
			</aims>

			<INHERIT TYPE="workflow_fields_assessment_base"/>

