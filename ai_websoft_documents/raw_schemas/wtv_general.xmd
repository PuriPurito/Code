			<for_analytics_aggregation TYPE="bool" DEFAULT="false" NOT-NULL="1" TITLE="##'\'Центр аналитики\': Поля группировки'##"/>
			<for_analytics_aggregation_type TYPE="string" FOREIGN-ARRAY="common.aggregation_types" TITLE="##'\'Центр аналитики\': Тип группировки'##"/>
			<for_analytics_scale_maximum TYPE="string" FOREIGN-ARRAY="Doc.TopElem.result_fields" TITLE="##'\'Центр аналитики\': Поле с максимумом шкалы'##"/>
			<width TYPE="string" TITLE="const=veb_mat_w"/>
			<bk_color TYPE="string" TITLE="##'Формула цвета фона ячейки'##"/>
			<text_color TYPE="string" TITLE="##'Формула цвета текста ячейки'##"/>
			<prohibit_sort TYPE="bool" DEFAULT="false" NOT-NULL="1" TITLE="##'Без сортировки'##"/>
			<foreign_field TYPE="string" TITLE="##'Поле для связи'##"/>
			<foreign_catalog_field TYPE="string" TITLE="##'Поле каталога'##"/>
		</result_field>
	</result_fields>
</result_fields_base>


<person_object_links_base SAMPLE="1">
	<pol_loaded TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
	<pol_changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
	<person_object_profiles>
		<person_object_profile MULTIPLE="1" PRIMARY-KEY="person_object_profile_id">
			<person_object_profile_id TYPE="integer" FOREIGN-ARRAY="person_object_profiles"/>
		</person_object_profile>
	</person_object_profiles>
	<person_object_links TEMP="1">
		<person_object_link MULTIPLE="1" PRIMARY-KEY="object_catalog" TEMP="1">
			<object_catalog TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TEMP="1"/>
			<all_can_create TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
			<amount TYPE="integer" TEMP="1"/>
			<all_can_edit TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
			<all_can_delete TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>

			<objects TEMP="1">
				<object MULTIPLE="1" PRIMARY-KEY="object_id" TEMP="1">
					<object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog(Parent.Parent.object_catalog+'s')" TEMP="1"/>
					<object_name TYPE="string" TEMP="1"/>
					<can_edit TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
					<can_delete TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
					<access_level TYPE="integer" TITLE="const=c_access_level" TEMP="1"/>
				</object>
			</objects>
		</person_object_link>
	</person_object_links>
</person_object_links_base>



<exec_code_base SAMPLE="1">
	<exec_code>
		<code_type TYPE="string"/>
		<code_url TYPE="string"/>
		<code_text TYPE="string" TITLE="const=hcei2rcaye"/>
		<is_init TYPE="bool" NULL-FALSE="1" TEMP="1"/>
		<code_temp TYPE="string" TEMP="1"/>
		<entry_point TYPE="string"/>
		<code_hash TYPE="string"/>
		<configuration TYPE="string" DEFAULT="Release"/>
		<is_compiling TYPE="bool" NULL-FALSE="1" TEMP="1"/>

		<bin_files TITLE="const=vdb_files">
			<bin_file MULTIPLE="1" PRIMARY-KEY="name">
				<name TYPE="string" TITLE="const=c_name"/>
				<parent_file_name TYPE="string" FOREIGN-ARRAY="BaseMultipleElem" TITLE="const=roditelskiyele"/>
				<file_path TYPE="string" TITLE="const=putdofayla"/>
				<value TYPE="string" TITLE="const=vfb_text"/>
				<is_modify TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1" TITLE="const=bfdwywxi5o"/>
				<position TYPE="integer" NOT-NULL="1" DEFAULT="0" TITLE="const=c_pos_num"/>
				<timestamp TYPE="date" TITLE="const=vdb_aim_date"/>
			</bin_file>
		</bin_files>
		<bfiles_selector TYPE="string" TEMP="1"/>
	</exec_code>
</exec_code_base>



<view_base SAMPLE="1">
	<is_hier TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
	<disp_dlg_new_button TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
	<sort_field TYPE="string" NOT-NULL="1" DEFAULT="t"/>

	<INHERIT TYPE="view_disp_button_base"/>

	<INHERIT TYPE="view_columns_base"/>

	<link_catalogs>
		<link_catalog MULTIPLE="1" PRIMARY-KEY="catalog_name">
			<catalog_name TYPE="string" FOREIGN-ARRAY="common.exchange_object_types"/>
			<link_field TYPE="string"/>
		</link_catalog>
	</link_catalogs>
</view_base>

<qa_test_param_base SAMPLE="1">
	<cur_person_id TYPE="integer" FOREIGN-ARRAY="collaborator" TITLE="const=c_coll"/>
	<use_cur_object TYPE="bool" NOT-NULL="1" DEFAULT="true"/>
	<cur_object_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types" TITLE="const=c_object_type"/>
	<cur_object_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( object_type + 's' )" INDEXED="1" TITLE="const=c_object"/>
	<use_cur_web_design TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
	<cur_web_design_id TYPE="integer" FOREIGN-ARRAY="web_designs" TITLE="const=jkmkd02mw9"/>
	<use_cur_site TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
	<cur_site_id TYPE="integer" FOREIGN-ARRAY="sites" TITLE="const=sayt"/>
	<use_cur_lng TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
	<cur_lng TYPE="string" FOREIGN-ARRAY="lngs" TITLE="const=g25zdm6oaq"/>
	<INHERIT TYPE="web_variables_base"/>
</qa_test_param_base>

<qa_test_fixture_base SAMPLE="1">
	<fixture_type_id TYPE="string" FOREIGN-ARRAY="common.qa_fixture_types" TITLE="##'Тип подготовки тестового окружения'##"/>
<!-- code -->
	<fixture_load_code TYPE="string" TITLE="##'выгрузки'##"/>
	<fixture_unload_code TYPE="string" TITLE="##'Код выгрузки окружения'##"/>
<!-- lib -->
	<fixture_library_id TYPE="integer" FOREIGN-ARRAY="code_librarys" TITLE="##'Библиотека с кодом подготовки тестового окружения'##"/>
	<fixture_load_function_name TYPE="string" TITLE="##'Имя функции инициализации окружения'##"/>
	<fixture_unload_function_name TYPE="string" TITLE="##'Имя функции выгрузки окружения'##"/>
<!-- zip -->
	<fixture_packet_uri TYPE="string" TITLE="##'Пакет тестовых данных'##"/>
	<clear_fixture_packet TYPE="bool" NOT-NULL="1" DEFAULT="false"/>
	<fixtures>
		<fixture MULTIPLE="1" PRIMARY-KEY="fixture_id">
			<fixture_id TYPE="integer" FOREIGN-ARRAY="DefaultDb.GetOptCatalog( fixture_type + 's' )"/>
			<fixture_type TYPE="string" FOREIGN-ARRAY="common.exchange_object_types"/>
			<fixture_name TYPE="string" />
		</fixture>
	</fixtures>
</qa_test_fixture_base>

<qa_test_assert_base SAMPLE="1">
	<asserts>
		<assert MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" EXPR-INIT="tools.random_string( 6 )"/>
			<name TYPE="string" TITLE="const=naimenovanie"/>
			<assert_type TYPE="string" FOREIGN-ARRAY="common.qa_test_assert_types" TITLE="##'Тип проверки'##"/>
			<check_inversion TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="##'Инверсия проверки'##"/>
			<check_property TYPE="string" TITLE="##'Проверяемый параметр'##"/>
			<template_is_collection TYPE="bool" NOT-NULL="1" DEFAULT="false" TITLE="##'Перечень эталонов'##"/>
			<template_type TYPE="string" FOREIGN-ARRAY="common.qa_test_assert_template_types" TITLE="##'Тип эталона'##"/>
			<template TYPE="string" TITLE="##'Эталон'##"/>
		</assert>
	</asserts>
</qa_test_assert_base>

<change_hash_fields_base SAMPLE="1">
	<current_hash TYPE="string" INDEXED="1" />
	<processed_embedding_hash TYPE="string" INDEXED="1" />
</change_hash_fields_base>

</SPXML-FORM>