<path_places_base SAMPLE="1">
	<old_id TYPE="integer" FOREIGN-ARRAY="places"/>
	<path_places>
		<path_place MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="integer" FOREIGN-ARRAY="places"/>
			<name TYPE="string"/>
			<parent_id TYPE="integer" FOREIGN-ARRAY="places"/>
		</path_place>
	</path_places>

	<filling_path_places PROPERTY="1" EXPR="
			try
			{
				if ( place_id.HasValue )
				{
					if	(old_id!=place_id)
					{
						path_places.Clear();
						depthCounter = 0;
						old_id=place_id;
						_child = path_places.AddChild();
						_child.id = place_id;
						_child.name = place_id.ForeignElem.name;
						_child.parent_id = place_id.ForeignElem.parent_id;

						if ( _child.parent_id.HasValue )
						{
							_parent_id =_child.parent_id;
							do
							{
								curParent = ArrayOptFirstElem( XQuery( 'for $elem in places where $elem/id = ' + _parent_id + ' return $elem' ) );
								if ( curParent == undefined )
									break;

								path_places.AddChild().AssignElem( curParent );

								_parent_id = curParent.parent_id;
								depthCounter++;
							} while( _parent_id.HasValue &amp;&amp; depthCounter &lt; 50 )
						}
					}
				}
				else
				{
					path_places.Clear();
				}
			}
			catch ( err )
			{
				alert( err );
			}

			return path_places;
	"/>
</path_places_base>


