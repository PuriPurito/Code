		</talent_pool_func_manager>
	</talent_pool_func_managers>
	<obtain_talent_pool_func_manager_by_id PROPERTY="1" PARAM="_person_id" PARAM="_is_native" EXPR="
			_child = talent_pool_func_managers.ObtainChildByKey( _person_id );
			tools.common_filling( 'collaborator', _child, _person_id );
			try
			{
				_child.is_native = _is_native == true;
				if ( _child.is_native )
					_child.boss_type_id = tools.get_default_object_id( 'boss_type', 'main' );
			}
			catch ( e )
			{
			}
	"/>
</talent_pool_func_managers_base>


