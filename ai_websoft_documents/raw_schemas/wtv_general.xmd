<file_action_base SAMPLE="1">
	<AssignFile PROPERTY="1" PARAM="_file_url" PARAM="_source" PARAM="oParams" EXPR="
			doc = OpenNewDoc( 'x-local://wtv/wtv_resource.xmd' );
			doc.BindToDb( DefaultDb );

			try
			{
				oParams;
				for ( sFieldNameElem in [ 'person_id', 'allow_download', 'allow_unauthorized_download', 'allow_search', 'role_id' ] )
				{
					try
					{
						switch( sFieldNameElem )
						{
							case 'role_id':
								doc.TopElem.role_id.ObtainByValue( GetObjectProperty( oParams, sFieldNameElem ) );
								if( GetObjectProperty( oParams, 'object_type' ) != '' )
								{
									catSetting = local_settings.resource_settings.ObtainChildByKey( GetObjectProperty( oParams, 'object_type' ) );
									catSetting.role_id = GetObjectProperty( oParams, sFieldNameElem );
									local_settings.Doc.Save();
								}
								break;
							default:
								doc.TopElem.Child( sFieldNameElem ).Value = GetObjectProperty( oParams, sFieldNameElem );
						}
					}
					catch( eee )
					{
					}
				}
			}
			catch( err )
			{
			}
			try
			{
				if ( doc.TopElem.person_id.HasValue )
					tools.common_filling( 'collaborator', doc.TopElem, doc.TopElem.person_id );
			}
			catch( err )
			{
			}

			try
			{
				_source;
			}
			catch( err )
			{
				_source = null;
			}
			doc.TopElem.put_data( _file_url, _source );

			Value = doc.DocID;
			UpdateScreens( '*', '*resource*' );
	"/>
	<DeleteFile PROPERTY="1" PARAM="_source" EXPR="
			_elem = OptForeignElem;
			if ( _elem != undefined )
			{
				if ( _elem.use_count &lt;= 0 )
				{
					if ( global_settings.settings.delete_unused_resource )
						ms_tools.delete_resource( Value );
				}
				else
				{
					try
					{
						_source;
					}
					catch( err )
					{
						_source = null;
					}
					docResource = OpenDoc( UrlFromDocID( Value ) );
					if ( docResource.TopElem.del_counter( _source ) )
						docResource.Save();
				}
				UpdateScreens( '*', '*resource*' );
			}
	"/>
	<SaveFile PROPERTY="1" PARAM="_file_url" EXPR="
			doc = OpenDoc( UrlFromDocID( Value ) );
			doc.TopElem.get_data( _file_url );
	"/>
	<AddFile PROPERTY="1" PARAM="_file_id" PARAM="_source" EXPR="
			doc = OpenDoc( UrlFromDocID( _file_id ) );
			try
			{
				_source;
			}
			catch( err )
			{
				_source = null;
			}
			doc.TopElem.add_counter( _source );
			UpdateScreens( '*', '*resource*' );

			Value = _file_id;
	"/>
</file_action_base>

<file_base SAMPLE="1">
	<file_id TYPE="integer" FOREIGN-ARRAY="resources" TITLE="ID">
		<INHERIT TYPE="file_action_base"/>
	</file_id>
</file_base>

<file_list_base SAMPLE="1">
	<files TITLE="const=vdb_files">
		<file MULTIPLE="1" PRIMARY-KEY="file_id" TITLE="const=c_file">
			<INHERIT TYPE="file_base"/>
		</file>
	</files>

	<AddFile PROPERTY="1" PARAM="_file_id" PARAM="docResourceParam" EXPR="
			if ( files.ChildByKeyExists( _file_id ) )
				return false;

			try
			{
				if ( docResourceParam == null || docResourceParam == '' )
				  throw 'no_doc';
			}
			catch ( err )
			{
				docResourceParam = OpenDoc( UrlFromDocID( _file_id ) );
			}
			docResourceParam.TopElem.add_counter( Child(0).Parent );
			if ( ! LdsIsServer )
				UpdateScreens( '*', '*resource*' );

			_child = files.AddChild();
			_child.file_id = _file_id;
			return true;
	"/>
</file_list_base>




