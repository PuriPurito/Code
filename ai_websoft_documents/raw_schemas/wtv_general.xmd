		</custom_data>
	</custom_datas>

	<get_custom_data PROPERTY="1" PARAM="sNameParam" EXPR="
			fldChild = custom_datas.GetOptChildByKey( sNameParam );
			return ( fldChild == undefined ? null : fldChild.value.Value );
	"/>
	<set_custom_data PROPERTY="1" PARAM="sNameParam" PARAM="sValueParam" EXPR="
			docObject = tools.get_opened_doc( Child(0).Parent );
			docObject.TopElem.custom_datas.ObtainChildByKey( sNameParam ).value = sValueParam;
			docObject.Save();
			return true;
	"/>
</custom_datas_base>



