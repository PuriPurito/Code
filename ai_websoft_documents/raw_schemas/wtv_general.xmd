<core_lesson_info_base SAMPLE="1">
	<learning_part_id TYPE="integer" FOREIGN-ARRAY="learning_parts" TITLE="Раздел курса"/>
	<filing_learning_part PROPERTY="1" PARAM="bSetChangedParam" EXPR="
			ListElem = Child(0).Parent;
			if ( ! ListElem.ChildExists( 'learning_part_id' ) || ListElem.core_lesson_filled )
				return;

			try
			{
				bSetChangedParam = bSetChangedParam == true;
			}
			catch ( err )
			{
				bSetChangedParam = false;
			}

			if ( ListElem.learning_part_id.HasValue )
			{
				try
				{
					teLearningPart = OpenDoc( UrlFromDocID( ListElem.learning_part_id ) ).TopElem;
					for ( fldNameElem in [ 'core_lesson', 'lesson_report', 'data_lesson', 'objects' ] )
						ListElem.Child( fldNameElem ).AssignElem( teLearningPart.Child( fldNameElem ) );

					if ( bSetChangedParam )
						fldPartElem.core_lesson_changed = true;
				}
				catch ( err )
				{
				}
			}
			ListElem.core_lesson_filled = true;
	"/>
	<save_learning_part PROPERTY="1" PARAM="bSaveParam" EXPR="
			try
			{
				bSaveParam = bSaveParam == true;
			}
			catch ( err )
			{
				bSaveParam = false;
			}
			ListElem = Child(0).Parent;

			if ( ListElem.learning_part_id.HasValue )
			{
				if ( bSaveParam )
				{
					try
					{
						docLearningPart = OpenDoc( UrlFromDocID( ListElem.learning_part_id ) );
						docLearningPart.TopElem.AssignElem( ListElem );
						docLearningPart.Save();
					}
					catch ( err )
					{
						return false;
					}
				}
			}
			else
			{
				docLearningPart = OpenNewDoc( 'x-local://wtv/wtv_learning_part.xmd' );
				docLearningPart.TopElem.AssignElem( ListElem );
				try
				{
					docLearningPart.TopElem.learning_id = ListElem.Doc.DocID;
				}
				catch ( err2 )
				{
				}
				docLearningPart.BindToDb( DefaultDb );
				docLearningPart.Save();

				ListElem.learning_part_id = docLearningPart.DocID;
			}
			if ( bSaveParam )
			{
				for ( fldNameElem in [ 'core_lesson', 'lesson_report', 'data_lesson', 'objects' ] )
					ListElem.Child( fldNameElem ).Clear();
				ListElem.core_lesson_changed = false;
			}
			else
			{
				ListElem.core_lesson_changed = true;
			}
			return true;
	"/>
	<core_lesson_changed TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
	<core_lesson_filled TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
</core_lesson_info_base>

