<essential_base IGNORE-SPELLING="1" SAMPLE="1">
	<is_foreign TYPE="bool" DEFAULT="false"/>
	<swift_code TYPE="string" TITLE="Swift Code"/>
	<iban_no  TYPE="string" TITLE="IBAN No"/>

	<inn TYPE="string" TITLE="const=t43il2xo81"/>
	<kpp TYPE="string" TITLE="const=gxuorvcyhu"/>

