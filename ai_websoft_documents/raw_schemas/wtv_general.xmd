<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>


<cost_currency_base SAMPLE="1">
	<cost TYPE="real" DEFAULT="0.0" TITLE="const=c_cost"/>
	<cost_nds TYPE="real" DEFAULT="0.0" TITLE="const=sapg75zczd"/>
	<currency TYPE="string" EXPR-INIT="global_settings.settings.default_currency" FOREIGN-ARRAY="lists.currency_types" TITLE="const=c_currency_type"/>
</cost_currency_base>

<cost_currency_type_base SAMPLE="1">
	<INHERIT TYPE="cost_currency_base"/>
	<cost_type TYPE="string" DEFAULT="person" FOREIGN-ARRAY="common.cost_types" TITLE="const=c_cost"/>
</cost_currency_type_base>




<person_name_base IGNORE-SPELLING="1" SAMPLE="1">
	<lastname TYPE="string" TITLE="const=uf_last_name"/>
	<firstname TYPE="string" TITLE="const=uf_name"/>
	<middlename TYPE="string" TITLE="const=uf_s_name"/>

	<fullname PROPERTY="1" EXPR="Trim( UnifySpaces( lastname + ' ' + firstname + ' ' + middlename ) )"/>
	<shortname PROPERTY="1" EXPR="PersonShortName( lastname, firstname, middlename )"/>
</person_name_base>



