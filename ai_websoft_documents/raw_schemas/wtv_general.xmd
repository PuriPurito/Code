<path_subs_base SAMPLE="1">
	<path_subs>
		<path_sub MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="integer" FOREIGN-ARRAY="subs"/>
			<type TYPE="string"/>
			<name TYPE="string"/>
			<parent_id TYPE="integer" FOREIGN-ARRAY="subs"/>
		</path_sub>
	</path_subs>

	<filling_path_subs PROPERTY="1" EXPR="
			path_subs.Clear();
			try
			{
				if ( position_id.HasValue )
				{
					depthCounter = 0;
					_child = path_subs.AddChild();
					_child.id = position_id;
					_child.type = 'position';
					_child.name = position_name;
					_child.parent_id = position_parent_id;

					if ( position_parent_id.HasValue )
					{
						_parent_id = position_parent_id;
						do
						{
							curParent = ArrayOptFirstElem( XQuery( 'for $elem in subs where $elem/id = ' + _parent_id + ' return $elem' ) );
							if ( curParent == undefined )
								break;

							path_subs.AddChild().AssignElem( curParent );

							_parent_id = curParent.parent_id;
							depthCounter++;
						} while( _parent_id.HasValue &amp;&amp; depthCounter &lt; 50 )
					}
				}
				else if ( org_id.HasValue )
				{
					_child = path_subs.AddChild();
					_child.id = org_id;
					_child.type = 'org';
					_child.name = org_name;
				}
			}
			catch ( err )
			{
				alert( err );
			}

			return path_subs;
	"/>
</path_subs_base>





