	</event_settings>
</event_settings_base>


<outstaff_periods_base SAMPLE="1">
	<periods TITLE="const=intervalyrabot">
		<period MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" EXPR-INIT="tools.random_string( 4 )" TITLE="ID"/>
			<name TYPE="string" TITLE="const=c_name"/>
			<position_common_id TYPE="integer" FOREIGN-ARRAY="position_commons" TITLE="const=c_position_common"/>
			<position_common_name TYPE="string" TITLE="const=1s32lfwi2s"/>
			<outstaff_contract_id TYPE="integer" FOREIGN-ARRAY="outstaff_contracts" TITLE="const=kontraktnavrem"/>
			<outstaff_contract_name TYPE="string" TITLE="const=kontraktnavrem"/>
			<budget_period_id TYPE="integer" FOREIGN-ARRAY="budget_periods" TITLE="const=c_budget_period"/>
			<budget_period_name TYPE="string" TITLE="const=c_budget_period"/>
			<start_date TYPE="date" TITLE="const=c_start_date"/>
			<finish_date TYPE="date" TITLE="const=c_finish_date"/>
			<ext_time TYPE="string" TITLE="##'Время возможного изменения (чч:мм)'##"/>
			<start_time TYPE="string" TITLE="##'Время начала (чч:мм)'##"/>
			<finish_time TYPE="string" TITLE="'Время завершения (чч:мм)'"/>
			<hour_num TYPE="integer" TITLE="const=c_hour_duration"/>
			<full_time TYPE="bool" NULL-FALSE="1" TITLE="const=polnyyden"/>
			<days_length TYPE="string" NOT-NULL="1" TITLE="Продолжительность дня" DEFAULT="8;9;10;11"/>
			<max_cnt TYPE="integer" TITLE="Максимальное количество сотрудников на день"/>
		</period>
	</periods>
	<materials TITLE="##'Расходные материалы'##">
		<material MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="string" EXPR-INIT="tools.random_string( 4 )" TITLE="ID"/>
			<outstaff_type_material_id TYPE="integer" FOREIGN-ARRAY="outstaff_type_materials" TITLE="const=tipmateriala"/>
			<budget_period_id TYPE="integer" FOREIGN-ARRAY="budget_periods" TITLE="const=c_budget_period"/>
			<plan_value TYPE="integer" TITLE="const=vkb_plan_value"/>
			<fact_value TYPE="integer" TITLE="const=vkb_actual_value"/>
		</material>
	</materials>
</outstaff_periods_base>

