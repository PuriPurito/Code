<desc_base SAMPLE="1">
	 <desc_update_hyper_object PROPERTY="1" EXPR="
			for ( _desc in descs )
				_desc.desc_update_hyper_object();
	"/>
	<desc_save PROPERTY="1" PARAM="bDescOffParam" EXPR="
			try
			{
				bDescOffParam = bDescOffParam == true;
			}
			catch ( err )
			{
				bDescOffParam = false;
			}
			sSelector = '';
			catUiData = ArrayOptFirstElem( XQuery( 'for $elem in ui_datas where $elem/object_id = ' + ( Doc.TopElem.ChildExists( 'id' ) &amp;&amp; Doc.TopElem.id.HasValue ? Doc.TopElem.id.Value: Doc.DocID ) + ' return $elem/Fields(\'data\')' ) );
			if ( catUiData != undefined &amp;&amp; catUiData.data.HasValue )
			{
				oData = ParseJson( catUiData.data );
				sSelector = oData.GetOptProperty( 'text_selector', '' );
			}
			if( sSelector == 'edit' )
			{
				var descField = null;
				if( Doc.TopElem.ChildExists( 'desc' ) )
				{
					descField = Doc.TopElem.desc;
				}
				else if( Doc.TopElem.ChildExists( 'text_area' ) )
				{
					descField = Doc.TopElem.text_area;
				}
				descField.Value = CallServerMethod('tools_web', 'clear_bbcode_from_html', ([ descField.Value ]));
			}
			else
			{
				for ( fldDescElem in descs )
				{
					fldDescElem.desc_save();
					if ( bDescOffParam )
						fldDescElem.desc_updated = false;
				}
			}
	"/>
	<get_desc PROPERTY="1" PARAM="_source" EXPR="
			try
			{
				_id = _source.BaseMultipleElem.PrimaryKey.Value;
//tools.alert_server('_id = '+_id)
				_child = descs.ObtainChildByKey( _id );
				_child.desc_field_name = _source.BaseMultipleElem.Parent.Name + '.ObtainChildByKey(\'' + _id + '\').' + _source.Name;
//tools.alert_server('_child.desc_field_name = '+_child.desc_field_name)
			}
			catch ( e )
			{
				try
				{
					_id = _source.Name;
					_child = descs.ObtainChildByKey( _id );
					_child.desc_field_name = _id;
				}
				catch ( ee )
				{
					_id = String( Random( 100000, 999999 ) );
					_child = descs.ObtainChildByKey( _id );
				}
			}
			return _child;
	"/>
	<descs TEMP="1">
		<desc MULTIPLE="1" PRIMARY-KEY="id" TEMP="1">
			<id TYPE="string" TEMP="1"/>
			<variant TYPE="variant" TEMP="1"/>
			<desc_temp TYPE="string" TEMP="1"/>
			<desc_temp_dir TYPE="string" TEMP="1"/>
			<desc_updated TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
			<desc_show TYPE="bool" NOT-NULL="1" DEFAULT="false" TEMP="1"/>
			<desc_field_name TYPE="string" NOT-NULL="1" DEFAULT="desc" TEMP="1"/>

			<desc_cleanup PROPERTY="1" EXPR="
					desc_temp = tools.desc_cleanup( desc_temp, desc_temp_dir );
			"/>
			<desc_startup PROPERTY="1" PARAM="_source" EXPR="
					if ( ! desc_updated )
					{
						function create_temp_file( bDelFlagParam )
						{
							if ( bDelFlagParam &amp;&amp; desc_temp_dir.HasValue )
								try
								{
									DeleteDirectory( desc_temp_dir );
								}
								catch ( err )
								{
								}
							if ( ! desc_temp_dir.HasValue )
							{
								desc_temp_dir = ObtainSessionTempFile();
								CreateDirectory( desc_temp_dir );
							}
						}

						if ( StrContains( _source, '&lt;compound-attc ' ) )
						{
							create_temp_file( true );
							tempFile = UrlAppendPath( desc_temp_dir, '1.htm' );
							ExtractCompoundHtml( _source, tempFile );
							htmlStr = LoadUrlData( tempFile );
						}
						else
						{
							htmlStr = _source;
						}

						newHtmlStr = '';
						reader = new TagReader( htmlStr );
						reader.ReadNext();
						while ( ! reader.EOF )
						{
							if ( reader.TagName == 'img' )
							{
								attr = Trim( reader.GetAttr( 'src' ) );
								if ( attr != '' )
								{
									if ( StrBegins( attr, 'download_file.html' ) )
									{
										try
										{
											attr_query = UrlQuery( attr );
											resourceDoc = OpenDoc( UrlFromDocID( Int( attr_query.file_id ) ) ).TopElem;
											create_temp_file();
											img_url = UrlAppendPath( desc_temp_dir, attr_query.file_id + UrlPathSuffix( resourceDoc.file_name ) ) + '?' + UrlParam( attr );
											resourceDoc.get_data( img_url );

											reader.SetAttr( 'src', img_url );
											reader.SetAttr( 'longdesc', attr );
										}
										catch ( e )
										{
										}
									}
									else if ( StrBegins( attr, 'data:image/' ) )
									{
										iIndex = attr.indexOf( ';base64,' );
										if ( iIndex &gt; 0 )
										{
											sType = StrRangePos( attr, 11, iIndex );
											sData = StrRightRangePos( attr, iIndex + 8 );
											create_temp_file( false );
											sImgUrl = UrlAppendPath( desc_temp_dir, ( tools.random_string( 6 ) + '.' + sType ) );
											try
											{
												PutUrlData( sImgUrl, Base64Decode( sData ) );
												reader.SetAttr( 'src', sImgUrl );
											}
											catch ( e )
											{
												//alert( e );
											}
										}
									}
									else if ( StrBegins( attr, '/' ) )
									{
										reader.SetAttr( 'src', UrlAppendPath( tools.lds_address, attr ) );
										reader.SetAttr( 'longdesc', attr );
									}
									else if ( ! StrContains( attr, '/' ) )
									{
										attr = StrReplace( attr, '[!MODULE_IMAGES]', '' );
										reader.SetAttr( 'src', desc_temp_dir + '/' + attr );
									}
								}
							}

							newHtmlStr += reader.GetTagStr();
							reader.ReadNext();
						}

						desc_temp = newHtmlStr;
					}
					desc_updated = true;
			"/>
			<desc_update_hyper_object PROPERTY="1" EXPR="
					if ( desc_show )
						return;

					try
					{
						variant.Object.eval('CKEDITOR.instances.descTextArea.setData(' + CodeLiteral( desc_temp ) + ')' );
						sTemp_desc = variant.Object.eval('CKEDITOR.instances.descTextArea.getData()');

						if ( sTemp_desc != desc_temp )
							throw 'next_one';

						desc_show = true;
						Doc.SetChanged( true );
					}
					catch ( e )
					{
					}
			"/>
			<desc_save PROPERTY="1" EXPR="
			//alert('save desc 111')
					if ( ! desc_updated )
						return;
//alert('save desc 111')
					descField = eval( 'Doc.TopElem.' + desc_field_name );
					if ( desc_show )
					{
						desc_temp = variant.Object.eval('CKEDITOR.instances.descTextArea.getData()');
					}
alert('save desc 222 = '+desc_temp)
					try
					{
//alert('desc_temp = '+desc_temp);
						newHtmlStr = '';
						reader = new TagReader( desc_temp );
						reader.ReadNext();
						while ( ! reader.EOF )
						{
							if ( reader.TagName == 'img' )
							{
								attr = Trim( reader.GetAttr( 'src' ) );
								if ( attr != '' )
								{
									longdesc = reader.GetAttr( 'longdesc' );
									if ( longdesc != '' )
									{
										longdesc_param = UrlParam( longdesc );
										if ( ( longdesc_param != '' &amp;&amp; StrEnds( attr, longdesc_param ) ) || StrEnds( attr, longdesc ) )
											reader.SetAttr( 'src', longdesc );
										reader.SetAttr( 'longdesc', '' );
									}
									else if ( IsAbsoluteFilePath( attr ) )
									{
										reader.SetAttr( 'src', UrlDecode( FilePathToUrl( attr ) ) );
									}
								}
							}

							newHtmlStr += reader.GetTagStr();
							reader.ReadNext();
						}
//alert('newHtmlStr = '+newHtmlStr)
						descField.Value = AdjustHtml( newHtmlStr, 'remove-scripts=0;remove-small-images=1;bind-ext-data=1' );
					}
					catch ( e )
					{
						alert( e );
					}
//alert('descField.Value = '+descField.Value)
			"/>
			<desc_destroy PROPERTY="1" EXPR="
//tools.alert_server('IN destroy')
					if ( desc_show )
					{
//tools.alert_server('destroy')
						desc_temp = variant.Object.eval('CKEDITOR.instances.descTextArea.getData()');
						desc_show = false;
						//Child(0).Parent.Delete();
					}
			"/>
		</desc>
	</descs>
</desc_base>



