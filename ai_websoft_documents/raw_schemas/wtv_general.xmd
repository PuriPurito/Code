<person_foreign_base SAMPLE="1">
	<person_fullname PROPERTY="1" EXPR="
			Ps = Child(0).Parent;
			fldPerson = Ps.ChildExists( 'collaborator_id' ) ? Ps.collaborator_id : Ps.person_id;
			return fldPerson.ForeignElem.fullname;
	"/>
	<person_position_name PROPERTY="1" EXPR="
			Ps = Child(0).Parent;
			fldPerson = Ps.ChildExists( 'collaborator_id' ) ? Ps.collaborator_id : Ps.person_id;
			return fldPerson.ForeignElem.position_name;
	"/>
	<person_org_name PROPERTY="1" EXPR="
			Ps = Child(0).Parent;
			fldPerson = Ps.ChildExists( 'collaborator_id' ) ? Ps.collaborator_id : Ps.person_id;
			return fldPerson.ForeignElem.org_name;
	"/>
	<person_subdivision_name PROPERTY="1" EXPR="
			Ps = Child(0).Parent;
			fldPerson = Ps.ChildExists( 'collaborator_id' ) ? Ps.collaborator_id : Ps.person_id;
			return fldPerson.ForeignElem.position_parent_name;
	"/>
	<person_instance_id PROPERTY="1" EXPR="
			Ps = Child(0).Parent;
			fldPerson = Ps.ChildExists( 'collaborator_id' ) ? Ps.collaborator_id : Ps.person_id;
			return fldPerson.ForeignElem.app_instance_id;
	"/>
	<person_code PROPERTY="1" EXPR="
			Ps = Child(0).Parent;
			fldPerson = Ps.ChildExists( 'collaborator_id' ) ? Ps.collaborator_id : Ps.person_id;
			return fldPerson.ForeignElem.code;
	"/>
</person_foreign_base>





