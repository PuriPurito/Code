<annals_objects_base SAMPLE="1">
	<objects>
		<object MULTIPLE="1" PRIMARY-KEY="id">
			<id TYPE="attr"/>
			<attempt_id TYPE="string"/>
			<file TYPE="string"/>
			<objtype TYPE="string"/>

			<!-- begin player 2.0 data -->
			<data>
				<assessment PRIMARY-KEY="ident">
					<ident TYPE="attr"/>
					<viewed TYPE="attr"/><!-- update -->
					<answered TYPE="attr"/><!-- update -->
					<completed TYPE="attr"/><!-- update -->
					<timestamp TYPE="string"><!-- update -->
						<value TYPE="attr"/>
					</timestamp>
					<latency TYPE="string"><!-- update -->
						<value TYPE="attr"/>
					</latency>
					<duration TYPE="string">
						<value TYPE="attr"/>
					</duration>
				</assessment>
				<sections>
					<!-- ADDED -->
					<section MULTIPLE="1" PRIMARY-KEY="ident">
						<ident TYPE="attr"/>
						<viewed TYPE="attr"/><!-- update -->
						<answered TYPE="attr"/><!-- update -->
						<completed TYPE="attr"/><!-- update -->
						<timestamp TYPE="string"><!-- update -->
							<value TYPE="attr"/>
						</timestamp>
						<latency TYPE="string"><!-- update -->
							<value TYPE="attr"/>
						</latency>
						<duration TYPE="string">
							<value TYPE="attr"/>
						</duration>
						<itemlist>
							<sectionitem MULTIPLE="1" PRIMARY-KEY="ident">
								<ident TYPE="attr"/>
							</sectionitem>
						</itemlist>
					</section>
				</sections>

				<items>
					<!-- ADDED -->
					<item MULTIPLE="1" PRIMARY-KEY="ident"><!-- update -->
						<ident TYPE="attr"/>
						<viewed TYPE="attr"/>
						<answered TYPE="attr"/>
						<completed TYPE="attr"/>
						<status TYPE="attr"/>
						<type TYPE="attr"/>
						<itemnumber TYPE="attr"/>
						<scoring TYPE="attr"/>
						<shuffle TYPE="attr"/>
						<maxnumber TYPE="attr"/>
						<minnumber TYPE="attr"/>
						<timestamp TYPE="string">
							<value TYPE="attr"/>
						</timestamp>
						<latency TYPE="string">
							<value TYPE="attr"/>
						</latency>
						<duration TYPE="string">
							<value TYPE="attr"/>
						</duration>
						<attempts>
							<max TYPE="attr"/>
							<attempt MULTIPLE="1" TYPE="string" PRIMARY-KEY="timevalue">
								<timestamp TYPE="attr"/>
								<timevalue TYPE="attr"/>
								<latency TYPE="attr"/>
								<latencyvalue TYPE="attr"/>
								<status TYPE="attr"/>
							</attempt>
						</attempts>
						<objectives>
							<obj MULTIPLE="1" PRIMARY-KEY="id">
								<id TYPE="attr"/>
								<type TYPE="attr"/>
								<value TYPE="attr"/>
							</obj>
						</objectives>

						<comment TYPE="string"/>
					</item>
				</items>

				<objectives><!-- update -->
					<objective MULTIPLE="1" PRIMARY-KEY="ident">
						<ident TYPE="attr"/>
						<type TYPE="attr"/>
						<value TYPE="attr"/>
					</objective>
				</objectives>

				<active><!-- update -->
					<screen TYPE="attr"/>
					<task>
						<ident TYPE="attr"/>
					</task>
				</active>

				<sequence>
					<type TYPE="attr"/>
					<select TYPE="attr"/>
					<screen MULTIPLE="1" PRIMARY-KEY="num">
						<num TYPE="attr"/>
						<type TYPE="attr"/>
						<task MULTIPLE="1" PRIMARY-KEY="ident">
							<ident TYPE="attr"/>
							<num TYPE="attr"/>
							<layout TYPE="attr"/>
							<secnum TYPE="attr"/>
						</task>
					</screen>
				</sequence>

			</data>
			<!-- end player 2.0 data -->

		</object>
	</objects>
</annals_objects_base>

