	<always_check_custom_experts TYPE="bool" DEFAULT="false" NOT-NULL="1"/>
	<participants>
		<participant MULTIPLE="1" PRIMARY-KEY="participant_id">
			<participant_id TYPE="string" FOREIGN-ARRAY="common.assessment_appraise_participants"/>
			<customize>
				<is_custom_experts TYPE="bool" DEFAULT="false" NOT-NULL="1"/>
			</customize>
		</participant>
	</participants>

	<impersonate_persons>
		<impersonate_person MULTIPLE="1">
			<impersonator_id TYPE="integer" FOREIGN-ARRAY="collaborators"/>
			<impersonator_fullname TYPE="string"/>
			<face_person_id TYPE="integer" FOREIGN-ARRAY="collaborators"/>
			<face_person_fullname TYPE="string"/>
			<from_date TYPE="date" TIME="0"/>
			<to_date TYPE="date" TIME="0"/>
		</impersonate_person>
	</impersonate_persons>

	<data_web_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates"/>
	<css_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates"/>
	<xml_template_id TYPE="integer" FOREIGN-ARRAY="custom_web_templates"/>
</assessment_appraise>

</SPXML-FORM>