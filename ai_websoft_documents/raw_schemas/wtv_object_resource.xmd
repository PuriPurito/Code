<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM>

<USE FORM="//wtv/ms_general.xmd"/>

<object_resource>
	<INHERIT TYPE="object_code_name_base"/>
	
	<type TYPE="string" FOREIGN-ARRAY="lists.object_resource_types" TITLE="const=x91r5l546f"/>
	<state_id TYPE="string" FOREIGN-ARRAY="common.object_resource_states" DEFAULT="available" TITLE="const=c_state"/>
	
	<count TYPE="integer" TITLE="const=c_num"/>
	
	<place_id TYPE="integer" FOREIGN-ARRAY="places" TITLE="const=c_place"/>
	<collaborator_id TYPE="integer" FOREIGN-ARRAY="collaborators" TITLE="const=c_coll"/>
	
	<INHERIT TYPE="admin_access_base"/>
	
	<small_desc TYPE="string" TITLE="const=dmrmhi36f3"/>
	<desc TYPE="string" TITLE="const=c_desc"/>
	<comment TYPE="string" TITLE="const=vkpb_comment"/>
	<doc_info TYPE="doc_info_base" TITLE="const=dseglc23jx"/>
	
	<INHERIT TYPE="custom_elems_base"/>
	
	<view TEMP="1">
		<INHERIT TYPE="desc_base"/>
	</view>
</object_resource>


<DocDesc PROPERTY="1" EXPR="
		ms_tools.get_const('lmitz32f0b') + ': ' + object_resource.name
"/>

</SPXML-FORM>