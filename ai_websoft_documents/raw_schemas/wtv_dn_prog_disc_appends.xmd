<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" OBJECT-NAME="dn_prog_disc_append">

<USE FORM="//wtv/wtv_general.xmd"/>

<dn_prog_disc_appends>
	<dn_prog_disc_append MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" INDEXED="1" TITLE="const=c_code"/>
	    <name TYPE="string" INDEXED="1" TITLE="const=c_name"/>
	    <program_discipline_id TYPE="integer" FOREIGN-ARRAY="dn_program_discipls"/>
	    <academ_year_id TYPE="integer" FOREIGN-ARRAY="dn_academ_years"/>
	    <special_id TYPE="integer" FOREIGN-ARRAY="dn_specials"/>
	    <specialization_id TYPE="integer" FOREIGN-ARRAY="dn_specializations" TITLE="const=specializaciya"/>
	    <educat_form_id TYPE="string" FOREIGN-ARRAY="lists.dn_educat_forms"/>
	    <qualification_id TYPE="integer" FOREIGN-ARRAY="qualifications" TITLE="const=c_qualification"/>
		
		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" INDEXED="1" TITLE="const=8qorpy64yd"/>

		<INHERIT TYPE="admin_access_base"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
		
	</dn_prog_disc_append>	
</dn_prog_disc_appends>

</SPXML-FORM>		