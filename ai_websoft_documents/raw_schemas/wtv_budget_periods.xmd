<?xml version="1.0" encoding="utf-8"?>
<SPXML-FORM CATALOG="1" HIER="1" OBJECT-NAME="budget_period">

<USE FORM="//wtv/wtv_general.xmd"/>

<budget_periods>
	<budget_period MULTIPLE="1" PRIMARY-KEY="id">
		<id TYPE="integer" INDEXED="1" TITLE="ID"/>
		<code TYPE="string" TITLE="const=c_code"/>
		<name TYPE="string" INDEXED="1" TITLE="const=c_name"/>

		<parent_id TYPE="integer" FOREIGN-ARRAY="budget_periods" INDEXED="1" TITLE="const=4ijstawxov"/>

		<start_date TYPE="date" TIME="0" INDEXED="1" TITLE="const=c_start_date"/>
		<finish_date TYPE="date" TIME="0" INDEXED="1" TITLE="const=3bywib72ya"/>

		<period_type TYPE="string" NOT-NULL="1" DEFAULT="none" FOREIGN-ARRAY="common.perioditys" TITLE="const=c_period"/>

		<INHERIT TYPE="admin_access_base"/>
		
		<role_id TYPE="integer" MULTIPLE="1" FOREIGN-ARRAY="roles" INDEXED="1" TITLE="const=4egocnh7uc"/>

		<modification_date TYPE="date" INDEXED="1" TITLE="const=n6k2nxsxx4"/>
		<app_instance_id TYPE="string" TITLE="const=8qorpy64yd"/>

		<OnBuild PROPERTY="1" EXPR="
				id.Parent.AssignElem( SrcDoc.TopElem );
				modification_date = SrcDoc.TopElem.doc_info.modification.date;
				app_instance_id = SrcDoc.TopElem.doc_info.creation.app_instance_id;
		"/>
	</budget_period>
</budget_periods>

</SPXML-FORM>